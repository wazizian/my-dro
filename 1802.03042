<p id="S3.SS0.SSSx1.p3.12" class="ltx_p">for <math id="S3.SS0.SSSx1.p3.5.m1.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S3.SS0.SSSx1.p3.5.m1.1a"><mi id="S3.SS0.SSSx1.p3.5.m1.1.1" xref="S3.SS0.SSSx1.p3.5.m1.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S3.SS0.SSSx1.p3.5.m1.1b"><ci id="S3.SS0.SSSx1.p3.5.m1.1.1.cmml" xref="S3.SS0.SSSx1.p3.5.m1.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS0.SSSx1.p3.5.m1.1c">Z</annotation></semantics></math> normal and a volatility <math id="S3.SS0.SSSx1.p3.6.m2.1" class="ltx_Math" alttext="\sigma&gt;0" display="inline"><semantics id="S3.SS0.SSSx1.p3.6.m2.1a"><mrow id="S3.SS0.SSSx1.p3.6.m2.1.1" xref="S3.SS0.SSSx1.p3.6.m2.1.1.cmml"><mi id="S3.SS0.SSSx1.p3.6.m2.1.1.2" xref="S3.SS0.SSSx1.p3.6.m2.1.1.2.cmml">σ</mi><mo id="S3.SS0.SSSx1.p3.6.m2.1.1.1" xref="S3.SS0.SSSx1.p3.6.m2.1.1.1.cmml">&gt;</mo><mn id="S3.SS0.SSSx1.p3.6.m2.1.1.3" xref="S3.SS0.SSSx1.p3.6.m2.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.SS0.SSSx1.p3.6.m2.1b"><apply id="S3.SS0.SSSx1.p3.6.m2.1.1.cmml" xref="S3.SS0.SSSx1.p3.6.m2.1.1"><gt id="S3.SS0.SSSx1.p3.6.m2.1.1.1.cmml" xref="S3.SS0.SSSx1.p3.6.m2.1.1.1"></gt><ci id="S3.SS0.SSSx1.p3.6.m2.1.1.2.cmml" xref="S3.SS0.SSSx1.p3.6.m2.1.1.2">𝜎</ci><cn type="integer" id="S3.SS0.SSSx1.p3.6.m2.1.1.3.cmml" xref="S3.SS0.SSSx1.p3.6.m2.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS0.SSSx1.p3.6.m2.1c">\sigma&gt;0</annotation></semantics></math>. Assume the proportional cost of trading <math id="S3.SS0.SSSx1.p3.7.m3.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S3.SS0.SSSx1.p3.7.m3.1a"><mi id="S3.SS0.SSSx1.p3.7.m3.1.1" xref="S3.SS0.SSSx1.p3.7.m3.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S3.SS0.SSSx1.p3.7.m3.1b"><ci id="S3.SS0.SSSx1.p3.7.m3.1.1.cmml" xref="S3.SS0.SSSx1.p3.7.m3.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS0.SSSx1.p3.7.m3