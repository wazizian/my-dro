<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p">It is easily seen that without trading restrictions and transaction costs, this price coincides with the price of a replicating portfolio (if it exists):</p>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.1.1.1" class="ltx_text ltx_font_bold">Lemma 3.3</span></span><span id="S3.Thmtheorem3.2.2" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.7" class="ltx_p"><span id="S3.Thmtheorem3.p1.7.7" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmtheorem3.p1.1.1.m1.1" class="ltx_Math" alttext="C_{T}\equiv 0" display="inline"><semantics id="S3.Thmtheorem3.p1.1.1.m1.1a"><mrow id="S3.Thmtheorem3.p1.1.1.m1.1.1" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.cmml"><msub id="S3.Thmtheorem3.p1.1.1.m1.1.1.2" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2.cmml"><mi id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.2" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2.2.cmml">C</mi><mi id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.3" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2.3.cmml">T</mi></msub><mo id="S3.Thmtheorem3.p1.1.1.m1.1.1.1" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.1.cmml">≡</mo><mn id="S3.Thmtheorem3.p1.1.1.m1.1.1.3" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem3.p1.1.1.m1.1b"><apply id="S3.Thmtheorem3.p1.1.1.m1.1.1.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1"><equivalent id="S3.Thmtheorem3.p1.1.1.m1.1.1.1.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.1"></equivalent><apply id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2"><csymbol cd="ambiguous" id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.1.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2">subscript</csymbol><ci id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.2.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2.2">𝐶</ci><ci id="S3.Thmtheorem3.p1.1.1.m1.1.1.2.3.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.2.3">𝑇</ci></apply><cn type="integer" id="S3.Thmtheorem3.p1.1.1.m1.1.1.3.cmml" xref="S3.Thmtheorem3.p1.1.1.m1.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem3.p1.1.1.m1.1c">C_{T}\equiv 0</annotation></semantics></math> and <math id="S3.Thmtheorem3.p1.2.2.m2.1" class="ltx_Math" alttext="\mathcal{H}=\mathcal{H}^{u}" display="inline"><semantics id="S3.Thmtheorem3.p1.2.2.m2.1a"><mrow id="S3.Thmtheorem3.p1.2.2.m2.1.1" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S3.Thmtheorem3.p1.2.2.m2.1.1.2" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.2.cmml">ℋ</mi><mo id="S3.Thmtheorem3.p1.2.2.m2.1.1.1" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.1.cmml">=</mo><msup id="S3.Thmtheorem3.p1.2.2.m2.1.1.3" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.2" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3.2.cmml">ℋ</mi><mi id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.3" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3.3.cmml">u</mi></msup></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem3.p1.2.2.m2.1b"><apply id="S3.Thmtheorem3.p1.2.2.m2.1.1.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1"><eq id="S3.Thmtheorem3.p1.2.2.m2.1.1.1.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.1"></eq><ci id="S3.Thmtheorem3.p1.2.2.m2.1.1.2.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.2">ℋ</ci><apply id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3"><csymbol cd="ambiguous" id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.1.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3">superscript</csymbol><ci id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.2.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3.2">ℋ</ci><ci id="S3.Thmtheorem3.p1.2.2.m2.1.1.3.3.cmml" xref="S3.Thmtheorem3.p1.2.2.m2.1.1.3.3">𝑢</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem3.p1.2.2.m2.1c">\mathcal{H}=\mathcal{H}^{u}</annotation></semantics></math>. If <math id="S3.Thmtheorem3.p1.3.3.m3.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S3.Thmtheorem3.p1.3.3.m3.1a"><mi id="S3.Thmtheorem3.p1.3.3.m3.1.1" xref="S3.Thmtheorem3.p1.3.3.m3.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem3.p1.3.3.m3.1b"><ci id="S3.Thmtheorem3.p1.3.3.m3.1.1.cmml" xref="S3.Thmtheorem3.p1.3.3.m3.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem3.p1.3.3.m3.1c">Z</annotation></semantics></math> is
attainable, i.e. there exists <math id="S3.Thmtheorem3.p1.4.4.m4.1" class="ltx_Math" alttext="\delta^{*}\in\mathcal{H}" display="inline"><semantics id="S3.Thmtheorem3.p1.4.4.m4.1a"><mrow id="S3.Thmtheorem3.p1.4.4.m4.1.1" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.cmml"><msup id="S3.Thmtheorem3.p1.4.4.m4.1.1.2" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2.cmml"><mi id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.2" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2.2.cmml">δ</mi><mo id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.3" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2.3.cmml">∗</mo></msup><mo id="S3.Thmtheorem3.p1.4.4.m4.1.1.1" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S3.Thmtheorem3.p1.4.4.m4.1.1.3" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.3.cmml">ℋ</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem3.p1.4.4.m4.1b"><apply id="S3.Thmtheorem3.p1.4.4.m4.1.1.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1"><in id="S3.Thmtheorem3.p1.4.4.m4.1.1.1.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.1"></in><apply id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2"><csymbol cd="ambiguous" id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.1.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2">superscript</csymbol><ci id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.2.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2.2">𝛿</ci><times id="S3.Thmtheorem3.p1.4.4.m4.1.1.2.3.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.2.3"></times></apply><ci id="S3.Thmtheorem3.p1.4.4.m4.1.1.3.cmml" xref="S3.Thmtheorem3.p1.4.4.m4.1.1.3">ℋ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem3.p1.4.4.m4.1c">\delta^{*}\in\mathcal{H}</annotation></semantics></math> and <math id="S3.Thmtheorem3.p1.5.5.m5.1" class="ltx_Math" alttext="p_{0}\in\mathbb{R}" display="inline"><semantics id="S3.Thmtheorem3.p1.5.5.m5.1a"><mrow id="S3.Thmtheorem3.p1.5.5.m5.1.1" xref="S3.Thmtheorem3.p1.5.5.m5.1.1.cmml"><msub id="S3.Thmtheorem3.p1.5.5.m5.1.1.2" xref="S3.Thmtheorem3.p1.5.5.m5.1.1.2.cmml"><mi id="S3.Thmtheorem3.p1.