</tr></tbody>
</table>
<p id="S5.SS3.p3.5" class="ltx_p">where <math id="S5.SS3.p3.2.m1.1" class="ltx_Math" alttext="p_{\varepsilon}=p_{\varepsilon}(Z)" display="inline"><semantics id="S5.SS3.p3.2.m1.1a"><mrow id="S5.SS3.p3.2.m1.1.2" xref="S5.SS3.p3.2.m1.1.2.cmml"><msub id="S5.SS3.p3.2.m1.1.2.2" xref="S5.SS3.p3.2.m1.1.2.2.cmml"><mi id="S5.SS3.p3.2.m1.1.2.2.2" xref="S5.SS3.p3.2.m1.1.2.2.2.cmml">p</mi><mi id="S5.SS3.p3.2.m1.1.2.2.3" xref="S5.SS3.p3.2.m1.1.2.2.3.cmml">ε</mi></msub><mo id="S5.SS3.p3.2.m1.1.2.1" xref="S5.SS3.p3.2.m1.1.2.1.cmml">=</mo><mrow id="S5.SS3.p3.2.m1.1.2.3" xref="S5.SS3.p3.2.m1.1.2.3.cmml"><msub id="S5.SS3.p3.2.m1.1.2.3.2" xref="S5.SS3.p3.2.m1.1.2.3.2.cmml"><mi id="S5.SS3.p3.2.m1.1.2.3.2.2" xref="S5.SS3.p3.2.m1.1.2.3.2.2.cmml">p</mi><mi id="S5.SS3.p3.2.m1.1.2.3.2.3" xref="S5.SS3.p3.2.m1.1.2.3.2.3.cmml">ε</mi></msub><mo lspace="0em" rspace="0em" id="S5.SS3.p3.2.m1.1.2.3.1" xref="S5.SS3.p3.2.m1.1.2.3.1.cmml">​</mo><mrow id="S5.SS3.p3.2.m1.1.2.3.3.2" xref="S5.SS3.p3.2.m1.1.2.3.cmml"><mo stretchy="false" id="S5.SS3.p3.2.m1.1.2.3.3.2.1" xref="S5.SS3.p3.2.m1.1.2.3.cmml">(</mo><mi id="S5.SS3.p3.2.m1.1.1" xref="S5.SS3.p3.2.m1.1.1.cmml">Z</mi><mo stretchy="false" id="S5.SS3.p3.2.m1.1.2.3.3.2.2" xref="S5.SS3.p3.2.m1.1.2.3.cmml">)</mo></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.p3.2.m1.1b"><apply id="S5.SS3.p3.2.m1.1.2.cmml" xref="S5.SS3.p3.2.m1.1.2"><eq id="S5.SS3.p3.2.m1.1.2.1.cmml" xref="S5.SS3.p3.2.m1.1.2.1"></eq><apply id="S5.SS3.p3.2.m1.1.2.2.cmml" xref="S5.SS3.p3.2.m1.1.2.2"><csymbol cd="ambiguous" id="S5.SS3.p3.2.m1.1.2.2.1.cmml" xref="S5.SS3.p3.2.m1.1.2.2">subscript</csymbol><ci id="S5.SS3.p3.2.m1.1.2.2.2.cmml" xref="S5.SS3.p3.2.m1.1.2.2.2">𝑝</ci><ci id="S5.SS3.p3.2.m1.1.2.2.3.cmml" xref="S5.SS3.p3.2.m1.1.2.2.3">𝜀</ci></apply><apply id="S5.SS3.p3.2.m1.1.2.3.cmml" xref="S5.SS3.p3.2.m1.1.2.3"><times id="S5.SS3.p3.2.m1.1.2.3.1.cmml" xref="S5.SS3.p3.2.m1.1.2.3.1"></times><apply id="S5.SS3.p3.2.m1.1.2.3.2.cmml" xref="S5.SS3.p3.2.m1.1.2.3.2"><csymbol cd="ambiguous" id="S5.SS3.p3.2.m1.1.2.3.2.1.cmml" xref="S5.SS3.p3.2.m1.1.2.3.2">subscript</csymbol><ci id="S5.SS3.p3.2.m1.1.2.3.2.2.cmml" xref="S5.SS3.p3.2.m1.1.2.3.2.2">𝑝</ci><ci id="S5.SS3.p3.2.m1.1.2.3.2.3.cmml" xref="S5.SS3.p3.2.m1.1.2.3.2.3">𝜀</ci></apply><ci id="S5.SS3.p3.2.m1.1.1.cmml" xref="S5.SS3.p3.2.m1.1.1">𝑍</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p3.2.m1.1c">p_{\varepsilon}=p_{\varepsilon}(Z)</annotation></semantics></math> is the utility indifference price of <math id="S5.SS3.p3.3.m2.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S5.SS3.p3.3.m2.1a"><mi id="S5.SS3.p3.3.m2.1.1" xref="S5.SS3.p3.3.m2.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.p3.3.m2.1b"><ci id="S5.SS3.p3.3.m2.1.1.cmml" xref="S5.SS3.p3.3.m2.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p3.3.m2.1c">Z</annotation></semantics></math> associated to transaction costs of size <math id="S5.SS3.p3.4.m3.1" class="ltx_Math" alttext="\varepsilon" display="inline"><semantics id="S5.SS3.p3.4.m3.1a"><mi id="S5.SS3.p3.4.m3.1.1" xref="S5.SS3.p3.4.m3.1.1.cmml">ε</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.p3.4.m3.1b"><ci id="S5.SS3.p3.4.m3.1.1.cmml" xref="S5.SS3.p3.4.m3.1.1">𝜀</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p3.4.m3.1c">\varepsilon</annotation></semantics></math>. In fact (<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) is true in more general one-dimensional models, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx21" title="" class="ltx_ref">KMK15</a>]</cite>, and the rate <math id="S5.SS3.p3.5.m4.1" class="ltx_Math" alttext="2/3" display="inline"><semantics id="S5.SS3.p3.5.m4.1a"><mrow id="S5.SS3.p3.5.m4.1.1" xref="S5.SS3.p3.5.m4.1.1.cmml"><mn id="S5.SS3.p3.5.m4.1.1.2" xref="S5.SS3.p3.5.m4.1.1.2.cmml">2</mn><mo id="S5.SS3.p3.5.m4.1.1.1" xref="S5.SS3.p3.5.m4.1.1.1.cmml">/</mo><mn id="S5.SS3.p3.5.m4.1.1.3" xref="S5.SS3.p3.5.m4.1.1.3.cmml">3</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.p3.5.m4.1b"><apply id="S5.SS3.p3.5.m4.1.1.cmml" xref="S5.SS3.p3.5.m4.1.1"><divide id="S5.SS3.p3.5.m4.1.1.1.cmml" xref="S5.SS3.p3.5.m4.1.1.1"></divide><cn type="integer" id="S5.SS3.p3.5.m4.1.1.2.cmml" xref="S5.SS3.p3.5.m4.1.1.2">2</cn><cn type="integer" id="S5.SS3.p3.5.m4.1.1.3.cmml" xref="S5.SS3.p3.5.m4.1.1.3">3</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p3.5.m4.1c">2/3</annotation></semantics></math> also emerges in a variety of related problems with proportional transaction costs, see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Rog04</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">JMKS17</a>]</cite> and the references therein.</p>
</div>
<div id="S5.SS3.p4" class="ltx_para">
<p id="S5.SS3.p4.2" class="ltx_p">Here we numerically verify (<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) using the deep
hedging algorithm, first for a Black-Scholes model (for which
(<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) is known to hold) and then for a Heston
model (with <math id="S5.SS3.p4.1.m1.1" class="ltx_Math" alttext="d=2" display="inline"><semantics id="S5.SS3.p4.1.m1.1a"><mrow id="S5.SS3.p4.1.m1.1.1" xref="S5.SS3.p4.1.m1.1.1.cmml"><mi id="S5.SS3.p4.1.m1.1.1.2" xref="S5.SS3.p4.1.m1.1.1.2.cmml">d</mi><mo id="S5.SS3.p4.1.m1.1.1.1" xref="S5.SS3.p4.1.m1.1.1.1.cmml">=</mo><mn id="S5.SS3.p4.1.m1.1.1.3" xref="S5.SS3.p4.1.m1.1.1.3.cmml">2</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.p4.1.m1.1b"><apply id="S5.SS3.p4.1.m1.1.1.cmml" xref="S5.SS3.p4.1.m1.1.1"><eq id="S5.SS3.p4.1.m1.1.1.1.cmml" xref="S5.SS3.p4.1.m1.1.1.1"></eq><ci id="S5.SS3.p4.1.m1.1.1.2.cmml" xref="S5.SS3.p4.1.m1.1.1.2">𝑑</ci><cn type="integer" id="S5.SS3.p4.1.m1.1.1.3.cmml" xref="S5.SS3.p4.1.m1.1.1.3">2</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p4.1.m1.1c">d=2</annotation></semantics></math> hedging instruments). For this latter case (or any
other model with <math id="S5.SS3.p4.2.m2.1" class="ltx_Math" alttext="d&gt;1" display="inline"><semantics id="S5.SS3.p4.2.m2.1a"><mrow id="S5.SS3.p4.2.m2.1.1" xref="S5.SS3.p4.2.m2.1.1.cmml"><mi id="S5.SS3.p4.2.m2.1.1.2" xref="S5.SS3.p4.2.m2.1.1.2.cmml">d</mi><mo id="S5.SS3.p4.2.m2.1.1.1" xref="S5.SS3.p4.2.m2.1.1.1.cmml">&gt;</mo><mn id="S5.SS3.p4.2.m2.1.1.3" xref="S5.SS3.p4.2.m2.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.p4.2.m2.1b"><apply id="S5.SS3.p4.2.m2.1.1.cmml" xref="S5.SS3.p4.2.m2.1.1"><gt id="S5.SS3.p4.2.m2.1.1.1.cmml" xref="S5.SS3.p4.2.m2.1.1.1"></gt><ci id="S5.SS3.p4.2.m2.1.1.2.cmml" xref="S5.SS3.p4.2.m2.1.1.2">𝑑</ci><cn type="integer" id="S5.SS3.p4.2.m2.1.1.3.cmml" xref="S5.SS3.p4.2.m2.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.p4.2.m2.1c">d&gt;1</annotation></semantics></math>) there have been neither numerical nor
theoretical results on (<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) previously in the
literature.</p>
</div>
<section id="S5.SS3.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Black-Scholes model</h4>

<div id="S5.SS3.SSSx1.p1" class="ltx_para">
<p id="S5.SS3.SSSx1.p1.17" class="ltx_p">Consider first <math id="S5.SS3.SSSx1.p1.1.m1.1" class="ltx_Math" alttext="d=1" display="inline"><semantics id="S5.SS3.SSSx1.p1.1.m1.1a"><mrow id="S5.SS3.SSSx1.p1.1.m1.1.1" xref="S5.SS3.SSSx1.p1.1.m1.1.1.cmml"><mi id="S5.SS3.SSSx1.p1.1.m1.1.1.2" xref="S5.SS3.SSSx1.p1.1.m1.1.1.2.cmml">d</mi><mo id="S5.SS3.SSSx1.p1.1.m1.1.1.1" xref="S5.SS3.SSSx1.p1.1.m1.1.1.1.cmml">=</mo><mn id="S5.SS3.SSSx1.p1.1.m1.1.1.3" xref="S5.SS3.SSSx1.p1.1.m1.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.1.m1.1b"><apply id="S5.SS3.SSSx1.p1.1.m1.1.1.cmml" xref="S5.SS3.SSSx1.p1.1.m1.1.1"><eq id="S5.SS3.SSSx1.p1.1.m1.1.1.1.cmml" xref="S5.SS3.SSSx1.p1.1.m1.1.1.1"></eq><ci id="S5.SS3.SSSx1.p1.1.m1.1.1.2.cmml" xref="S5.SS3.SSSx1.p1.1.m1.1.1.2">𝑑</ci><cn type="integer" id="S5.SS3.SSSx1.p1.1.m1.1.1.3.cmml" xref="S5.SS3.SSSx1.p1.1.m1.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.1.m1.1c">d=1</annotation></semantics></math> and <math id="S5.SS3.SSSx1.p1.2.m2.2" class="ltx_Math" alttext="S_{t}=s_{0}\exp(-t\sigma^{2}/2+\sigma W_{t})" display="inline"><semantics id="S5.SS3.SSSx1.p1.2.m2.2a"><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.cmml"><msub id="S5.SS3.SSSx1.p1.2.m2.2.2.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.3.cmml"><mi id="S5.SS3.SSSx1.p1.2.m2.2.2.3.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.3.2.cmml">S</mi><mi id="S5.SS3.SSSx1.p1.2.m2.2.2.3.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.3.3.cmml">t</mi></msub><mo id="S5.SS3.SSSx1.p1.2.m2.2.2.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.2.cmml">=</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.cmml"><msub id="S5.SS3.SSSx1.p1.2.m2.2.2.1.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.3.cmml"><mi id="S5.SS3.SSSx1.p1.2.m2.2.2.1.3.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.3.2.cmml">s</mi><mn id="S5.SS3.SSSx1.p1.2.m2.2.2.1.3.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.3.3.cmml">0</mn></msub><mo lspace="0.167em" rspace="0em" id="S5.SS3.SSSx1.p1.2.m2.2.2.1.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.2.cmml">​</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.2.cmml"><mi id="S5.SS3.SSSx1.p1.2.m2.1.1" xref="S5.SS3.SSSx1.p1.2.m2.1.1.cmml">exp</mi><mo id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1a" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.2.cmml">⁡</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.2.cmml"><mo stretchy="false" id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.2.cmml">(</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.cmml"><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.cmml"><mo id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2a" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.cmml">−</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.cmml"><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.cmml"><mi id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.2.cmml">t</mi><mo lspace="0em" rspace="0em" id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.1.cmml">​</mo><msup id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3.cmml"><mi id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3.2" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3.2.cmml">σ</mi><mn id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.2.3.3.cmml">2</mn></msup></mrow><mo id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.1.cmml">/</mo><mn id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.3" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.2.2.3.cmml">2</mn></mrow></mrow><mo id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.1" xref="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1.1.1.cmml">+</mo><mrow id="S5.SS3.SSSx1.p1.2.m2.2.2.1.1.1.1