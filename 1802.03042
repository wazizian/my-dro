sufficiently smooth, one may apply Itô’s formula to <math id="S5.SS2.SSSx1.p3.12.m12.1" class="ltx_Math" alttext="H" display="inline"><semantics id="S5.SS2.SSSx1.p3.12.m12.1a"><mi id="S5.SS2.SSSx1.p3.12.m12.1.1" xref="S5.SS2.SSSx1.p3.12.m12.1.1.cmml">H</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p3.12.m12.1b"><ci id="S5.SS2.SSSx1.p3.12.m12.1.1.cmml" xref="S5.SS2.SSSx1.p3.12.m12.1.1">𝐻</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p3.12.m12.1c">H</annotation></semantics></math> and use
