for a fixed <math id="S4.SS2.6.p5.7.m2.1" class="ltx_Math" alttext="\omega" display="inline"><semantics id="S4.SS2.6.p5.7.m2.1a"><mi id="S4.SS2.6.p5.7.m2.1.1" xref="S4.SS2.6.p5.7.m2.1.1.cmml">ω</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.6.p5.7.m2.1b"><ci id="S4.SS2.6.p5.7.m2.1.1.cmml" xref="S4.SS2.6.p5.7.m2.1.1">𝜔</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.6.p5.7.m2.1c">\omega</annotation></semantics></math> implies moreover that also <math id="S4.SS2.6.p5.8.m3.4" class="ltx_Math" alttext="\lim_{n\to\infty}H_{k}(\omega)\circ\delta_{k}^{n}(\omega)=H_{k}(\omega)\circ\delta_{k}(\omega)" display="inline"><semantics id="S4.SS2.6.p5.8.m3.4a"><mrow id="S4.SS2.6.p5.8.m3.4.5" xref="S4.SS2.6.p5.8.m3.4.5.cmml"><mrow id="S4.SS2.6.p5.8.m3.4.5.2" xref="S4.SS2.6.p5.8.m3.4.5.2.cmml"><msub id="S4.SS2.6.p5.8.m3.4.5.2.1" xref="S4.SS2.6.p5.8.m3.4.5.2.1.cmml"><mo id="S4.SS2.6.p5.8.m3.4.5.2.1.2" xref="S4.SS2.6.p5.8.m3.4.5.2.1.2.cmml">lim</mo><mrow id="S4.SS2.6.p5.8.m3.4.5.2.1.3" xref="S4.SS2.6.p5.8.m3.4.5.2.1.3.cmml"><mi id="S4.SS2.6.p5.8.m3.4.5.2.1.3.2" xref="S4.SS2.6.p5.8.m3.4.5.2.1.3.2.cmml">n</mi><mo stretchy="false" id="S4.SS2.6.p5.8.m3.4.5.2.1.3.1" xref="S4.SS2.6.p5.8.m3.4.5.2.1.3.1.cmml">→</mo><mi mathvariant="normal" id="S4.SS2.6.p5.8.m3.4.5.2.1.3.3" xref="S4.SS2.6.p5.8.m3.4.5.2.1.3.3.cmml">∞</mi></mrow></msub><mrow id="S4.SS2.6.p5.8.m3.4.5.2.2" xref="S4.SS2.6.p5.8.m3.4.5.2.2.cmml"><mrow id="S4.SS2.6.p5.8.m3.4.5.2.2.2" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.cmml"><mrow id="S4.SS2.6.p5.8.m3.4.5.2.2.2.2" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.cmml"><msub id="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2.cmml"><mi id="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2.2" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2.2.cmml">H</mi><mi id="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2.3" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.2.3.cmml">k</mi></msub><mo lspace="0em" rspace="0em" id="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.1" xref="S4.SS2.6.p5.8.m3.4.5.2.2.2.2.1.cmml">​</mo><mrow id="S4.S