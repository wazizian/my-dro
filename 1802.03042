5.m1.3.3.1.1.1.1.1.1.1.2.1.1.1.1.3.2">𝐻</ci><ci id="S4.Ex5.m1.3.3.1.1.1.1.1.1.1.2.1.1.1.1.3.3.cmml" xref="S4.Ex5.m1.3.3.1.1.1.1.1.1.1.2.1.1.1.1.3.3">𝛿</ci></apply></apply></apply><cn type="integer" id="S4.Ex5.m1.3.3.1.1.1.1.1.1.1.2.1.3.cmml" xref="S4.Ex5.m1.3.3.1.1.1.1.1.1.1.2.1.3">1</cn></apply></apply></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Ex5.m1.3c">\pi(X)\equiv\inf_{\delta\in\mathcal{H}^{u}}\rho\!\left(X+(H\circ\delta\cdot S)_{T}-C_{T}(\delta)-\gamma\|\delta-H\circ\delta\|_{1}\right)\ .</annotation></semantics></math></td>
