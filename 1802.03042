SS0.SSSx2.p3.4.m4.1.1"></and><apply id="S2.SS0.SSSx2.p3.4.m4.1.1b.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1"><csymbol cd="latexml" id="S2.SS0.SSSx2.p3.4.m4.1.1.4.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.4">assign</csymbol><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.3.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.3">ℋ</ci><apply id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1"><compose id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.1.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.1"></compose><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.2.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.2">𝐻</ci><apply id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.1.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3">superscript</csymbol><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.2.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.2">ℋ</ci><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.3.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.1.1.1.3.3">𝑢</ci></apply></apply></apply><apply id="S2.SS0.SSSx2.p3.4.m4.1.1c.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1"><subset id="S2.SS0.SSSx2.p3.4.m4.1.1.5.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.5"></subset><share href="#S2.SS0.SSSx2.p3.4.m4.1.1.1.cmml" id="S2.SS0.SSSx2.p3.4.m4.1.1d.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1"></share><apply id="S2.SS0.SSSx2.p3.4.m4.1.1.6.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.6"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p3.4.m4.1.1.6.1.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.6">superscript</csymbol><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.6.2.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.6.2">ℋ</ci><ci id="S2.SS0.SSSx2.p3.4.m4.1.1.6.3.cmml" xref="S2.SS0.SSSx2.p3.4.m4.1.1.6.3">𝑢</ci></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p3.4.m4.1c">\mathcal{H}:=(H\circ\mathcal{H}^{u})\subset\mathcal{H}^{u}</annotation></semantics></math> the corresponding non-empty set
of restricted trading strategies.</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.1.1.1" class="ltx_text ltx_font_bold">Example 2.1</span></span><span id="S2.Thmtheorem1.2.2" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.6" class="ltx_p">Assume that <math id="S2.Thmtheorem1.p1.1.m1.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S2.Thmtheorem1.p1.1.m1.1a"><mi id="S2.Thmtheorem1.p1.1.m1.1.1" xref="S2.Thmtheorem1.p1.1.m1.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem1.p1.1.m1.1b"><ci id="S2.Thmtheorem1.p1.1.m1.1.1.cmml" xref="S2.Thmtheorem1.p1.1.m1.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem1.p1.1.m1.1c">S</annotation></semantics></math> are a range of options and that <math id="S2.Thmtheorem1.p1.2.m2.1" class="ltx_Math" alttext="\mathcal{V}^{i}_{k}(S^{i}_{k})" display="inline"><semantics id="S2.Thmtheorem1.p1.2.m2.1a"><mrow id="S2.Thmtheorem1.p1.2.m2.1.1" xref="S2.Thmtheorem1.p1.2.m2.1.1.cmml"><msubsup id="S2.Thmtheorem1.p1.2.m2.1.1.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.2" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.2.2.cmml">𝒱</mi><mi id="S2.Thmtheorem1.p1.2.m2.1.1.3.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.3.cmml">k</mi><mi id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.2.3.cmml">i</mi></msubsup><mo lspace="0em" rspace="0em" id="S2.Thmtheorem1.p1.2.m2.1.1.2" xref="S2.Thmtheorem1.p1.2.m2.1.1.2.cmml">​</mo><mrow id="S2.Thmtheorem1.p1.2.m2.1.1.1.1" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.cmml"><mo stretchy="false" id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.2" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.cmml">(</mo><msubsup id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.cmml"><mi id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.2" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.2.cmml">S</mi><mi id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.3.cmml">k</mi><mi id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.3.cmml">i</mi></msubsup><mo stretchy="false" id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.3" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem1.p1.2.m2.1b"><apply id="S2.Thmtheorem1.p1.2.m2.1.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1"><times id="S2.Thmtheorem1.p1.2.m2.1.1.2.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.2"></times><apply id="S2.Thmtheorem1.p1.2.m2.1.1.3.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.2.m2.1.1.3.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3">subscript</csymbol><apply id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3">superscript</csymbol><ci id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.2.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.2.2">𝒱</ci><ci id="S2.Thmtheorem1.p1.2.m2.1.1.3.2.3.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.2.3">𝑖</ci></apply><ci id="S2.Thmtheorem1.p1.2.m2.1.1.3.3.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.3.3">𝑘</ci></apply><apply id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1">subscript</csymbol><apply id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.1.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1">superscript</csymbol><ci id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.2.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.2">𝑆</ci><ci id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.3.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.2.3">𝑖</ci></apply><ci id="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.3.cmml" xref="S2.Thmtheorem1.p1.2.m2.1.1.1.1.1.3">𝑘</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem1.p1.2.m2.1c">\mathcal{V}^{i}_{k}(S^{i}_{k})</annotation></semantics></math> computes the Black &amp; Scholes Vega of each option
using the various market parameters available at time <math id="S2.Thmtheorem1.p1.3.m3.1" class="ltx_Math" alttext="t_{k}" display="inline"><semantics id="S2.Thmtheorem1.p1.3.m3.1a"><msub id="S2.Thmtheorem1.p1.3.m3.1.1" xref="S2.Thmtheorem1.p1.3.m3.1.1.cmml"><mi id="S2.Thmtheorem1.p1.3.m3.1.1.2" xref="S2.Thmtheorem1.p1.3.m3.1.1.2.cmml">t</mi><mi id="S2.Thmtheorem1.p1.3.m3.1.1.3" xref="S2.Thmtheorem1.p1.3.m3.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem1.p1.3.m3.1b"><apply id="S2.Thmtheorem1.p1.3.m3.1.1.cmml" xref="S2.Thmtheorem1.p1.3.m3.1.1"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.3.m3.1.1.1.cmml" xref="S2.Thmtheorem1.p1.3.m3.1.1">subscript</csymbol><ci id="S2.Thmtheorem1.p1.3.m3.1.1.2.cmml" xref="S2.Thmtheorem1.p1.3.m3.1.1.2">𝑡</ci><ci id="S2.Thmtheorem1.p1.3.m3.1.1.3.cmml" xref="S2.Thmtheorem1.p1.3.m3.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem1.p1.3.m3.1c">t_{k}</annotation></semantics></math>.
The overall Vega traded with <math id="S2.Thmtheorem1.p1.4.m4.1" class="ltx_Math" alttext="\delta_{k}" display="inline"><semantics id="S2.Thmtheorem1.p1.4.m4.1a"><msub id="S2.Thmtheorem1.p1.4.m4.1.1" xref="S2.Thmtheorem1.p1.4.m4.1.1.cmml"><mi id="S2.Thmtheorem1.p1.4.m4.1.1.2" xref="S2.Thmtheorem1.p1.4.m4.1.1.2.cmml">δ</mi><mi id="S2.Thmtheorem1.p1.4.m4.1.1.3" xref="S2.Thmtheorem1.p1.4.m4.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem1.p1.4.m4.1b"><apply id="S2.Thmtheorem1.p1.4.m4.1.1.cmml" xref="S2.Thmtheorem1.p1.4.m4.1.1"><csymbol cd="ambiguous" id="S2.Thmtheorem1.p1.4.m4.1.1.1.cmml" xref="S2.Thmtheorem1.p1.4.m4.1.1">subscript</csymbol><ci id="S2.Thmtheorem1.p1.4.m4.1.1.2.cmml" xref="S2.Thmtheorem1.p1.4.m4.1.1.2">𝛿</ci><ci id="S2.Thmtheorem1.p1.4.m4.1.1.3.cmml" xref="S2.Thmtheorem1.p1.4.m4.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem1.p1.4.m4.1c">\delta_{k}</annotation></semantics></math> is then <math id="S2.Thmtheorem1.p1.5.m5.2" class="ltx_Math" alttext="\mathcal{V}_{k}(\delta_{k}-\delta_{k-1}):=|\sum_{i=1}^{d}\mathcal{V}^{i}_{k}(S^{i}_{k})(\delta^{i}_{k}-\delta^{i}_{k-1})|" display="inline"><semantics id="S2.Thmtheorem1.p1.5.m5.2a"><mrow id="S2.Thmtheorem1.p1.5.m5.2.2" xref="S2.Thmtheorem1.p1.5.m5.2.2.cmml"><mrow id="S2.Thmtheorem1.p1.5.m5.1.1.1" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.cmml"><msub id="S2.Thmtheorem1.p1.5.m5.1.1.1.3" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.Thmtheorem1.p1.5.m5.1.1.1.3.2" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.3.2.cmml">𝒱</mi><mi id="S2.Thmtheorem1.p1.5.m5.1.1.1.3.3" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.3.3.cmml">k</mi></msub><mo lspace="0em" rspace="0em" id="S2.Thmtheorem1.p1.5.m5.1.1.1.2" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.2.cmml">​</mo><mrow id="S2.Thmtheorem1.p1.5.m5.1.1.1.1.1" xref="S2.Thmtheorem1.p1.5.m5.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S2.Thmtheorem1.p1.5.m5.1.1.1.1.1.2" xref="S2.Thmtheorem