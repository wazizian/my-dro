="S2.Ex2.m1.1.1.1.1.2.1.2">⋅</ci><apply id="S2.Ex2.m1.1.1.1.1.2.1.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.3"><csymbol cd="ambiguous" id="S2.Ex2.m1.1.1.1.1.2.1.3.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.3">subscript</csymbol><ci id="S2.Ex2.m1.1.1.1.1.2.1.3.2.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.3.2">𝛿</ci><ci id="S2.Ex2.m1.1.1.1.1.2.1.3.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.3.3">𝑘</ci></apply><apply id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1"><minus id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.1"></minus><apply id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2"><csymbol cd="ambiguous" id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2">subscript</csymbol><ci id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.2.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.2">𝑆</ci><apply id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3"><plus id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.1"></plus><ci id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.2.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.2">𝑘</ci><cn type="integer" id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.2.3.3">1</cn></apply></apply><apply id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3"><csymbol cd="ambiguous" id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.1.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3">subscript</csymbol><ci id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.2.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.2">𝑆</ci><ci id="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.3.cmml" xref="S2.Ex2.m1.1.1.1.1.2.1.1.1.1.3.3">𝑘</ci></apply></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Ex2.m1.1c">(\delta\cdot S)_{T}:=\sum_{k=0}^{n-1}\delta_{k}\cdot(S_{k+1}-S_{k}).</annotation></semantics></math></td>
