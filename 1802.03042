<math id="S5.SS2.SSSx2.p1.4.m4.3" class="ltx_Math" alttext="k=0,\ldots,n" display="inline"><semantics id="S5.SS2.SSSx2.p1.4.m4.3a"><mrow id="S5.SS2.SSSx2.p1.4.m4.3.4" xref="S5.SS2.SSSx2.p1.4.m4.3.4.cmml"><mi id="S5.SS2.SSSx2.p1.4.m4.3.4.2" xref="S5.SS2.SSSx2.p1.4.m4.3.4.2.cmml">k</mi><mo id="S5.SS2.SSSx2.p1.4.m4.3.4.1" xref="S5.SS2.SSSx2.p1.4.m4.3.4.1.cmml">=</mo><mrow id="S5.SS2.SSSx2.p1.4.m4.3.4.3.2" xref="S5.SS2.SSSx2.p1.4.m4.3.4.3.1.cmml"><mn id="S5.SS2.SSSx2.p1.4.m4.1.1" xref="S5.SS2.SSSx2.p1.4.m4.1.1.cmml">0</mn><mo id="S5.SS2.SSSx2.p1.4.m4.3.4.3.2.1" xref="S5.SS2.SSSx2.p1.4.m4.3.4.3.1.cmml">,</mo><mi mathvariant="normal" id="S5.SS2.SSSx2.p1.4.m4.2.2" xref="S5.SS2.SSSx2.p1.4.m4.2.2.cmml">…</mi><mo id="S5.SS2.SSSx2.p1.4.m4.3.4.3.2.2" xref="S5.SS2.SSSx2.p1.4.m4.3.4.3.1.cmml">,</mo><mi id="S5.SS2.SSSx2.p1.4.m4.3.3" xref="S5.SS2.SSSx2.p1.4.m4.3.3.cmml">n</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p1.4.m4.3b"><apply id="S5.SS2.SSSx2.p1.4.m4.3.4.cmml" xref="S5.SS2.SSSx2.p1.4.m4.3.4"><eq id="S5.SS2.SSSx2.p1.4.m4.3.4.1.cmml" xref="S5.SS2.SSSx2.p1.4.m4.3.4.1"></eq><ci id="S5.SS2.SSSx2.p1.4.m4.3.4.2.cmml" xref="S5.SS2.SSSx2.p1.4.m4.3.4.2">𝑘</ci><list id="S5.SS2.SSSx2.p1.4.m4.3.4.3.1.cmml" xref="S5.SS2.SSSx2.p1.4.m4.3.4.3.2"><cn type="integer" id="S5.SS2.SSSx2.p1.4.m4.1.1.cmml" xref="S5.SS2.SSSx2.p1.4.m4.1.1">0</cn><ci id="S5.SS2.SSSx2.p1.4.m4.2.2.cmml" xref="S5.SS2.SSSx2.p1.4.m4.2.2">…</ci><ci id="S5.SS2.SSSx2.p1.4.m4.3.3.cmml" xref="S5.SS2.SSSx2.p1.4.m4.3.3">𝑛</ci></list></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p1.4.m4.3c">k=0,\ldots,n</annotation></semantics></math>, <math id="S5.SS2.SSSx2.p1.5.m5.2" class="ltx_Math" alttext="S_{k}=(S_{k}^{1},S_{k}^{2})" display="inline"><semantics id="S5.SS2.SSSx2.p1.5.m5.2a"><mrow id="S5.SS2.SSSx2.p1.5.m5.2.2" xref="S5.SS2.SSSx2.p1.5.m5.2.2.cmml"><msub id="S5.SS2.SSSx2.p1.5.m5.2.2.4" xref="S5.SS2.SSSx2.p1.5.m5.2.2.4.cmml"><mi id="S5.SS2.SSSx2.p1.5.m5.2.2.4.2