.2">superscript</csymbol><ci id="S5.SS2.SSSx2.p2.3.m3.2.2.2.2.2.cmml" xref="S5.SS2.SSSx2.p2.3.m3.2.2.2.2.2">𝛿</ci><cn type="integer" id="S5.SS2.SSSx2.p2.3.m3.2.2.2.2.3.cmml" xref="S5.SS2.SSSx2.p2.3.m3.2.2.2.2.3">2</cn></apply></list></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p2.3.m3.2c">\delta^{1},\delta^{2}</annotation></semantics></math> defined by
(<a href="#S5.E6" title="In A brief reminder on the Heston model ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a>) and charge the risk-neutral price
<math id="S5.SS2.SSSx2.p2.4.m4.1" class="ltx_Math" alttext="q" display="inline"><semantics id="S5.SS2.SSSx2.p2.4.m4.1a"><mi id="S5.SS2.SSSx2.p2.4.m4.1.1" xref="S5.SS2.SSSx2.p2.4.m4.1.1.cmml">q</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p2.4.m4.1b"><ci id="S5.SS2.SSSx2.p2.4.m4.1.1.cmml" xref="S5.SS2.SSSx2.p2.4.m4.1.1">𝑞</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p2.4.m4.1c">q</annotation></semantics></math>. This will be referred to as the model-delta hedging strategy (or
simply model hedge) and serves as a benchmark.</p>
</div>
<div id="S5.SS2.SSSx2.p3" class="ltx_para">
<p id="S5.SS2.SSSx2.p3.4" class="ltx_p">Finally, in order to compare the neural network strategies to this
benchmark, the network input is chosen as
<math id="S5.SS2.SSSx2.p3.1.m1.3" class="ltx_Math" alttext="I_{k}=(\log(S_{k}^{1}),V_{k})" display="inline"><semantics id="S5.SS2.SSSx2.p3.1.m1.3a"><mrow id="S5.SS2.SSSx2.p3.1.m1.3.3" xref="S5.SS2.SSSx2.p3.1.m1.3.3.cmml"><msub id="S5.SS2.SSSx2.p3.1.m1.3.3.4" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4.cmml"><mi id="S5.SS2.SSSx2.p3.1.m1.3.3.4.2" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4.2.cmml">I</mi><mi id="S5.SS2.SSSx2.p3.1.m1.3.3.4.3" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4.3.cmml">k</mi></msub><mo id="S5.SS2.SSSx2.p3.1.m1.3.3.3" xref="S5.SS2.SSSx2.p3.1.m1.3.3.3.cmml">=</mo><mrow id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.3.cmml"><mo stretchy="false" id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.3" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.3.cmml">(</mo><mrow id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml"><mi id="S5.SS2.SSSx2.p3.1.m1.1.1" xref="S5.SS2.SSSx2.p3.1.m1.1.1.cmml">log</mi><mo id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1a" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml">⁡</mo><mrow id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml"><mo stretchy="false" id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.2" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml">(</mo><msubsup id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.cmml"><mi id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.2" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.2.cmml">S</mi><mi id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.3" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.3.cmml">k</mi><mn id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.3" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.3.cmml">1</mn></msubsup><mo stretchy="false" id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.3" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml">)</mo></mrow></mrow><mo id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.4" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.3.cmml">,</mo><msub id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.cmml"><mi id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.2" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.2.cmml">V</mi><mi id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.3" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.3.cmml">k</mi></msub><mo stretchy="false" id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.5" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.3.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p3.1.m1.3b"><apply id="S5.SS2.SSSx2.p3.1.m1.3.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3"><eq id="S5.SS2.SSSx2.p3.1.m1.3.3.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.3"></eq><apply id="S5.SS2.SSSx2.p3.1.m1.3.3.4.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.1.m1.3.3.4.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4">subscript</csymbol><ci id="S5.SS2.SSSx2.p3.1.m1.3.3.4.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4.2">𝐼</ci><ci id="S5.SS2.SSSx2.p3.1.m1.3.3.4.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.4.3">𝑘</ci></apply><interval closure="open" id="S5.SS2.SSSx2.p3.1.m1.3.3.2.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2"><apply id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1"><log id="S5.SS2.SSSx2.p3.1.m1.1.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.1.1"></log><apply id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1">superscript</csymbol><apply id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1">subscript</csymbol><ci id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.2">𝑆</ci><ci id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.2.3">𝑘</ci></apply><cn type="integer" id="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.2.2.1.1.1.1.1.1.3">1</cn></apply></apply><apply id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.1.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2">subscript</csymbol><ci id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.2.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.2">𝑉</ci><ci id="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.3.cmml" xref="S5.SS2.SSSx2.p3.1.m1.3.3.2.2.2.3">𝑘</ci></apply></interval></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p3.1.m1.3c">I_{k}=(\log(S_{k}^{1}),V_{k})</annotation></semantics></math>. One could also replace
<math id="S5.SS2.SSSx2.p3.2.m2.1" class="ltx_Math" alttext="V_{k}" display="inline"><semantics id="S5.SS2.SSSx2.p3.2.m2.1a"><msub id="S5.SS2.SSSx2.p3.2.m2.1.1" xref="S5.SS2.SSSx2.p3.2.m2.1.1.cmml"><mi id="S5.SS2.SSSx2.p3.2.m2.1.1.2" xref="S5.SS2.SSSx2.p3.2.m2.1.1.2.cmml">V</mi><mi id="S5.SS2.SSSx2.p3.2.m2.1.1.3" xref="S5.SS2.SSSx2.p3.2.m2.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p3.2.m2.1b"><apply id="S5.SS2.SSSx2.p3.2.m2.1.1.cmml" xref="S5.SS2.SSSx2.p3.2.m2.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.2.m2.1.1.1.cmml" xref="S5.SS2.SSSx2.p3.2.m2.1.1">subscript</csymbol><ci id="S5.SS2.SSSx2.p3.2.m2.1.1.2.cmml" xref="S5.SS2.SSSx2.p3.2.m2.1.1.2">𝑉</ci><ci id="S5.SS2.SSSx2.p3.2.m2.1.1.3.cmml" xref="S5.SS2.SSSx2.p3.2.m2.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p3.2.m2.1c">V_{k}</annotation></semantics></math> by <math id="S5.SS2.SSSx2.p3.3.m3.1" class="ltx_Math" alttext="S^{2}_{k}" display="inline"><semantics id="S5.SS2.SSSx2.p3.3.m3.1a"><msubsup id="S5.SS2.SSSx2.p3.3.m3.1.1" xref="S5.SS2.SSSx2.p3.3.m3.1.1.cmml"><mi id="S5.SS2.SSSx2.p3.3.m3.1.1.2.2" xref="S5.SS2.SSSx2.p3.3.m3.1.1.2.2.cmml">S</mi><mi id="S5.SS2.SSSx2.p3.3.m3.1.1.3" xref="S5.SS2.SSSx2.p3.3.m3.1.1.3.cmml">k</mi><mn id="S5.SS2.SSSx2.p3.3.m3.1.1.2.3" xref="S5.SS2.SSSx2.p3.3.m3.1.1.2.3.cmml">2</mn></msubsup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p3.3.m3.1b"><apply id="S5.SS2.SSSx2.p3.3.m3.1.1.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.3.m3.1.1.1.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1">subscript</csymbol><apply id="S5.SS2.SSSx2.p3.3.m3.1.1.2.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.3.m3.1.1.2.1.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1">superscript</csymbol><ci id="S5.SS2.SSSx2.p3.3.m3.1.1.2.2.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1.2.2">𝑆</ci><cn type="integer" id="S5.SS2.SSSx2.p3.3.m3.1.1.2.3.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1.2.3">2</cn></apply><ci id="S5.SS2.SSSx2.p3.3.m3.1.1.3.cmml" xref="S5.SS2.SSSx2.p3.3.m3.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p3.3.m3.1c">S^{2}_{k}</annotation></semantics></math> instead. The network structure at
time-step <math id="S5.SS2.SSSx2.p3.4.m4.1" class="ltx_Math" alttext="t_{k}" display="inline"><semantics id="S5.SS2.SSSx2.p3.4.m4.1a"><msub id="S5.SS2.SSSx2.p3.4.m4.1.1" xref="S5.SS2.SSSx2.p3.4.m4.1.1.cmml"><mi id="S5.SS2.SSSx2.p3.4.m4.1.1.2" xref="S5.SS2.SSSx2.p3.4.m4.1.1.2.cmml">t</mi><mi id="S5.SS2.SSSx2.p3.4.m4.1.1.3" xref="S5.SS2.SSSx2.p3.4.m4.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx2.p3.4.m4.1b"><apply id="S5.SS2.SSSx2.p3.4.m4.1.1.cmml" xref="S5.SS2.SSSx2.p3.4.m4.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx2.p3.4.m4.1.1.1.cmml" xref="S5.SS2.SSSx2.p3.4.m4.1.1">subscript</csymbol><ci id="S5.SS2.SSSx2.p3.4.m4.1.1.2.cmml" xref="S5.SS2.SSSx2.p3.4.m4.1.1.2">𝑡</ci><ci id="S5.SS2.SSSx2.p3.4.m4.1.1.3.cmml" xref="S5.SS2.SSSx2.p3.4.m4.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx2.p3.4.m4.1c">t_{k}</annotation></semantics></math> is illustrated in Figure <a href="#S5.F1" title="Figure 1 ‣ Setting: Discretized Heston model ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="S5.F1" class="ltx_figure"><img src="/html/1802.03042/assets/x1.png" id="S5.F1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="266" height="203" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1. </span>Recurrent network structure</figcaption>
</figure>
</section>
<section id="S5.SS2.SSSx3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Results</h4>

<div id="S5.SS2.SSSx3.p1" class="ltx_para">
<p id="S5.SS2.SSSx3.p1.3" class="ltx_p">We now compare the model hedge <math id="S5.SS2.SSSx3.p1.1.m1.1" class="ltx_Math" alttext="\delta^{H}" display="inline"><semantics id="S5.SS2.SSSx3.p1.1.m1.1a"><msup id="S5.SS2.SSSx3.p1.1.m1.1.1" xref="S5.SS2.SSSx3.p1.1.m1.1.1.cmml"><mi id="S5.SS2.SSSx3.p1.1.m1.1.1.2" xref="S5.SS2.SSSx3.p1.1.m1.1.1.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p1.1.m1.1.1.3" xref="S5.SS2.SSSx3.p1.1.m1.1.1.3.cmml">H</mi></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p1.1.m1.1b"><apply id="S5.SS2.SSSx3.p1.1.m1.1.1.cmml" xref="S5.SS2.SSSx3.p1.1.m1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p1.1.m1.1.1.1.cmml" xref="S5.SS2.SSSx3.p1.1.m1.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p1.1.m1.1.1.2.cmml" xref="S5.SS2.SSSx3.p1.1.m1.1.1.2">𝛿</ci><ci id="S5.SS2.SSSx3.p1.1.m1.1.1.3.cmml" xref="S5.SS2.SSSx3.p1.1.m1.1.1.3">𝐻</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p1.1.m1.1c">\delta^{H}</annotation></semantics></math> to the deep hedging
strategies <math id="S5.SS2.SSSx3.p1.2.m2.1" class="ltx_Math" alttext="\delta^{\theta}" display="inline"><semantics id="S5.SS2.SSSx3.p1.2.m2.1a"><msup id="S5.SS2.SSSx3.p1.2.m2.1.1" xref="S5.SS2.SSSx3.p1.2.m2.1.1.cmml"><mi id="S5.SS2.SSSx3.p1.2.m2.1.1.2" xref="S5.SS2.SSSx3.p1.2.m2.1.1.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p1.2.m2.1.1.3" xref="S5.SS2.SSSx3.p1.2.m2.1.1.3.cmml">θ</mi></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p1.2.m2.1b"><apply id="S5.SS2.SSSx3.p1.2.m2.1.1.cmml" xref="S5.SS2.SSSx3.p1.2.m2.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p1.2.m2.1.1.1.cmml" xref="S5.SS2.SSSx3.p1.2.m2.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p1.2.m2.1.1.2.cmml" xref="S5.SS2.SSSx3.p1.2.m2.1.1.2">𝛿</ci><ci id="S5.SS2.SSSx3.p1.2.m2.1.1.3.cmml" xref="S5.SS2.SSSx3.p1.2.m2.1.1.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p1.2.m2.1c">\delta^{\theta}</annotation></semantics></math> corresponding to different
risk-preferences, captured by different levels of <math id="S5.SS2.SSSx3.p1.3.m3.1" class="ltx_Math" alttext="\alpha" display="inline"><semantics id="S5.SS2.SSSx3.p1.3.m3.1a"><mi id="S5.SS2.SSSx3.p1.3.m3.1.1" xref="S5.SS2.SSSx3.p1.3.m3.1.1.cmml">α</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p1.3.m3.1b"><ci id="S5.SS2.SSSx3.p1.3.m3.1.1.cmml" xref="S5.SS2.SSSx3.p1.3.m3.1.1">𝛼</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p1.3.m3.1c">\alpha</annotation></semantics></math> in the
average value at risk (<a href="#S5.E1" title="In 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>).</p>
</div>
<div id="S5.SS2.SSSx3.p2" class="ltx_para">
<p id="S5.SS2.SSSx3.p2.21" class="ltx_p">As a first example, consider a European call option,
i.e. <math id="S5.SS2.SSSx3.p2.1.m1.1" class="ltx_Math" alttext="Z=(S^{1}_{T}-K)^{+}" display="inline"><semantics id="S5.SS2.SSSx3.p2.1.m1.1a"><mrow id="S5.SS2.SSSx3.p2.1.m1.1.1" xref="S5.SS2.SSSx3.p2.1.m1.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.1.m1.1.1.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.3.cmml">Z</mi><mo id="S5.SS2.SSSx3.p2.1.m1.1.1.2" xref="S5.SS2.SSSx3.p2.1.m1.1.1.2.cmml">=</mo><msup id="S5.SS2.SSSx3.p2.1.m1.1.1.1" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.cmml"><mrow id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.2" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.cmml">(</mo><mrow id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.cmml"><msubsup id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.2" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.2.cmml">S</mi><mi id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.3.cmml">T</mi><mn id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.3.cmml">1</mn></msubsup><mo id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.1.cmml">−</mo><mi id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.3.cmml">K</mi></mrow><mo stretchy="false" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.cmml">)</mo></mrow><mo id="S5.SS2.SSSx3.p2.1.m1.1.1.1.3" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.3.cmml">+</mo></msup></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.1.m1.1b"><apply id="S5.SS2.SSSx3.p2.1.m1.1.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1"><eq id="S5.SS2.SSSx3.p2.1.m1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.2"></eq><ci id="S5.SS2.SSSx3.p2.1.m1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.3">𝑍</ci><apply id="S5.SS2.SSSx3.p2.1.m1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1">superscript</csymbol><apply id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1"><minus id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.1"></minus><apply id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2">subscript</csymbol><apply id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.1.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.2.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.2">𝑆</ci><cn type="integer" id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.3.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.2.3">1</cn></apply><ci id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.2.3">𝑇</ci></apply><ci id="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.1.1.1.3">𝐾</ci></apply><plus id="S5.SS2.SSSx3.p2.1.m1.1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.1.m1.1.1.1.3"></plus></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.1.m1.1c">Z=(S^{1}_{T}-K)^{+}</annotation></semantics></math> with <math id="S5.SS2.SSSx3.p2.2.m2.1" class="ltx_Math" alttext="K=s_{0}" display="inline"><semantics id="S5.SS2.SSSx3.p2.2.m2.1a"><mrow id="S5.SS2.SSSx3.p2.2.m2.1.1" xref="S5.SS2.SSSx3.p2.2.m2.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.2.m2.1.1.2" xref="S5.SS2.SSSx3.p2.2.m2.1.1.2.cmml">K</mi><mo id="S5.SS2.SSSx3.p2.2.m2.1.1.1" xref="S5.SS2.SSSx3.p2.2.m2.1.1.1.cmml">=</mo><msub id="S5.SS2.SSSx3.p2.2.m2.1.1.3" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3.cmml"><mi id="S5.SS2.SSSx3.p2.2.m2.1.1.3.2" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3.2.cmml">s</mi><mn id="S5.SS2.SSSx3.p2.2.m2.1.1.3.3" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3.3.cmml">0</mn></msub></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.2.m2.1b"><apply id="S5.SS2.SSSx3.p2.2.m2.1.1.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1"><eq id="S5.SS2.SSSx3.p2.2.m2.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.1"></eq><ci id="S5.SS2.SSSx3.p2.2.m2.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.2">𝐾</ci><apply id="S5.SS2.SSSx3.p2.2.m2.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.2.m2.1.1.3.1.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3">subscript</csymbol><ci id="S5.SS2.SSSx3.p2.2.m2.1.1.3.2.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3.2">𝑠</ci><cn type="integer" id="S5.SS2.SSSx3.p2.2.m2.1.1.3.3.cmml" xref="S5.SS2.SSSx3.p2.2.m2.1.1.3.3">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.2.m2.1c">K=s_{0}</annotation></semantics></math>. Following the methodology
outlined in Section <a href="#S5.SS1" title="5.1. Setting and Implementation ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, we calculate a
(close-to) optimal parameter <math id="S5.SS2.SSSx3.p2.3.m3.1" class="ltx_Math" alttext="\theta" display="inline"><semantics id="S5.SS2.SSSx3.p2.3.m3.1a"><mi id="S5.SS2.SSSx3.p2.3.m3.1.1" xref="S5.SS2.SSSx3.p2.3.m3.1.1.cmml">θ</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.3.m3.1b"><ci id="S5.SS2.SSSx3.p2.3.m3.1.1.cmml" xref="S5.SS2.SSSx3.p2.3.m3.1.1">𝜃</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.3.m3.1c">\theta</annotation></semantics></math> for (<a href="#S4.Ex4" title="4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) with <math id="S5.SS2.SSSx3.p2.4.m4.1" class="ltx_Math" alttext="X=-Z" display="inline"><semantics id="S5.SS2.SSSx3.p2.4.m4.1a"><mrow id="S5.SS2.SSSx3.p2.4.m4.1.1" xref="S5.SS2.SSSx3.p2.4.m4.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.4.m4.1.1.2" xref="S5.SS2.SSSx3.p2.4.m4.1.1.2.cmml">X</mi><mo id="S5.SS2.SSSx3.p2.4.m4.1.1.1" xref="S5.SS2.SSSx3.p2.4.m4.1.1.1.cmml">=</mo><mrow id="S5.SS2.SSSx3.p2.4.m4.1.1.3" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3.cmml"><mo id="S5.SS2.SSSx3.p2.4.m4.1.1.3a" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3.cmml">−</mo><mi id="S5.SS2.SSSx3.p2.4.m4.1.1.3.2" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3.2.cmml">Z</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.4.m4.1b"><apply id="S5.SS2.SSSx3.p2.4.m4.1.1.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1"><eq id="S5.SS2.SSSx3.p2.4.m4.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1.1"></eq><ci id="S5.SS2.SSSx3.p2.4.m4.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1.2">𝑋</ci><apply id="S5.SS2.SSSx3.p2.4.m4.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3"><minus id="S5.SS2.SSSx3.p2.4.m4.1.1.3.1.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3"></minus><ci id="S5.SS2.SSSx3.p2.4.m4.1.1.3.2.cmml" xref="S5.SS2.SSSx3.p2.4.m4.1.1.3.2">𝑍</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.4.m4.1c">X=-Z</annotation></semantics></math> and
denote by <math id="S5.SS2.SSSx3.p2.5.m5.1" class="ltx_Math" alttext="\delta^{\theta}" display="inline"><semantics id="S5.SS2.SSSx3.p2.5.m5.1a"><msup id="S5.SS2.SSSx3.p2.5.m5.1.1" xref="S5.SS2.SSSx3.p2.5.m5.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.5.m5.1.1.2" xref="S5.SS2.SSSx3.p2.5.m5.1.1.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.5.m5.1.1.3" xref="S5.SS2.SSSx3.p2.5.m5.1.1.3.cmml">θ</mi></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.5.m5.1b"><apply id="S5.SS2.SSSx3.p2.5.m5.1.1.cmml" xref="S5.SS2.SSSx3.p2.5.m5.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.5.m5.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.5.m5.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.5.m5.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.5.m5.1.1.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.5.m5.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.5.m5.1.1.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.5.m5.1c">\delta^{\theta}</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p2.6.m6.1" class="ltx_Math" alttext="p^{\theta}_{0}" display="inline"><semantics id="S5.SS2.SSSx3.p2.6.m6.1a"><msubsup id="S5.SS2.SSSx3.p2.6.m6.1.1" xref="S5.SS2.SSSx3.p2.6.m6.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.6.m6.1.1.2.2" xref="S5.SS2.SSSx3.p2.6.m6.1.1.2.2.cmml">p</mi><mn id="S5.SS2.SSSx3.p2.6.m6.1.1.3" xref="S5.SS2.SSSx3.p2.6.m6.1.1.3.cmml">0</mn><mi id="S5.SS2.SSSx3.p2.6.m6.1.1.2.3" xref="S5.SS2.SSSx3.p2.6.m6.1.1.2.3.cmml">θ</mi></msubsup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.6.m6.1b"><apply id="S5.SS2.SSSx3.p2.6.m6.1.1.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.6.m6.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1">subscript</csymbol><apply id="S5.SS2.SSSx3.p2.6.m6.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.6.m6.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.6.m6.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1.2.2">𝑝</ci><ci id="S5.SS2.SSSx3.p2.6.m6.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1.2.3">𝜃</ci></apply><cn type="integer" id="S5.SS2.SSSx3.p2.6.m6.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.6.m6.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.6.m6.1c">p^{\theta}_{0}</annotation></semantics></math> the (close-to) optimal
hedging strategy and value of (<a href="#S4.Ex4" title="4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>),
respectively. By definition of the indifference price
(<a href="#S3.E2" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>), the approximation property
Proposition <a href="#S4.Thmtheorem9" title="Proposition 4.9. ‣ 4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>, Proposition <a href="#S3.Thmtheorem10" title="Proposition 3.10. ‣ 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> and
<math id="S5.SS2.SSSx3.p2.7.m7.1" class="ltx_Math" alttext="\rho(0)=0" display="inline"><semantics id="S5.SS2.SSSx3.p2.7.m7.1a"><mrow id="S5.SS2.SSSx3.p2.7.m7.1.2" xref="S5.SS2.SSSx3.p2.7.m7.1.2.cmml"><mrow id="S5.SS2.SSSx3.p2.7.m7.1.2.2" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.cmml"><mi id="S5.SS2.SSSx3.p2.7.m7.1.2.2.2" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S5.SS2.SSSx3.p2.7.m7.1.2.2.1" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.1.cmml">​</mo><mrow id="S5.SS2.SSSx3.p2.7.m7.1.2.2.3.2" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.cmml"><mo stretchy="false" id="S5.SS2.SSSx3.p2.7.m7.1.2.2.3.2.1" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.cmml">(</mo><mn id="S5.SS2.SSSx3.p2.7.m7.1.1" xref="S5.SS2.SSSx3.p2.7.m7.1.1.cmml">0</mn><mo stretchy="false" id="S5.SS2.SSSx3.p2.7.m7.1.2.2.3.2.2" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.cmml">)</mo></mrow></mrow><mo id="S5.SS2.SSSx3.p2.7.m7.1.2.1" xref="S5.SS2.SSSx3.p2.7.m7.1.2.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p2.7.m7.1.2.3" xref="S5.SS2.SSSx3.p2.7.m7.1.2.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.7.m7.1b"><apply id="S5.SS2.SSSx3.p2.7.m7.1.2.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2"><eq id="S5.SS2.SSSx3.p2.7.m7.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2.1"></eq><apply id="S5.SS2.SSSx3.p2.7.m7.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2"><times id="S5.SS2.SSSx3.p2.7.m7.1.2.2.1.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.1"></times><ci id="S5.SS2.SSSx3.p2.7.m7.1.2.2.2.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2.2.2">𝜌</ci><cn type="integer" id="S5.SS2.SSSx3.p2.7.m7.1.1.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.1">0</cn></apply><cn type="integer" id="S5.SS2.SSSx3.p2.7.m7.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.7.m7.1.2.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.7.m7.1c">\rho(0)=0</annotation></semantics></math>, <math id="S5.SS2.SSSx3.p2.8.m8.1" class="ltx_Math" alttext="p^{\theta}_{0}" display="inline"><semantics id="S5.SS2.SSSx3.p2.8.m8.1a"><msubsup id="S5.SS2.SSSx3.p2.8.m