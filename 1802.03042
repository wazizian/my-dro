.4.m4.1.1"><gt id="S4.SS1.p3.4.m4.1.1.1.cmml" xref="S4.SS1.p3.4.m4.1.1.1"></gt><apply id="S4.SS1.p3.4.m4.1.1.2.cmml" xref="S4.SS1.p3.4.m4.1.1.2"><csymbol cd="ambiguous" id="S4.SS1.p3.4.m4.1.1.2.1.cmml" xref="S4.SS1.p3.4.m4.1.1.2">subscript</csymbol><ci id="S4.SS1.p3.4.m4.1.1.2.2.cmml" xref="S4.SS1.p3.4.m4.1.1.2.2">𝑑</ci><cn type="integer" id="S4.SS1.p3.4.m4.1.1.2.3.cmml" xref="S4.SS1.p3.4.m4.1.1.2.3">1</cn></apply><cn type="integer" id="S4.SS1.p3.4.m4.1.1.3.cmml" xref="S4.SS1.p3.4.m4.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p3.4.m4.1c">d_{1}&gt;1</annotation></semantics></math>, see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">Hor91</a>]</cite>. A
variety of other results with different assumptions on <math id="S4.SS1.p3.5.m5.1" class="ltx_Math" alttext="\sigma" display="inline"><semantics id="S4.SS1.p3.5.m5.1a"><mi id="S4.SS1.p3.5.m5.1.1" xref="S4.SS1.p3.5.m5.1.1.cmml">σ</mi><annotation-xml encoding="MathML-Content" id="S4.SS1.p3.5.m5.1b"><ci id="S4.SS1.p3.5.m5.1.1.cmml" xref="S4.SS1.p3.5.m5.1.1">𝜎</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p3.5.m5.1c">\sigma</annotation></semantics></math> or
emphasis on approximation rates are available, see
e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx12" title="" class="ltx_ref">HBP17</a>]</cite> for further references.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.4" class="ltx_p">In what follows, we fix an activation function <math id="S4.SS1.p4.1.m1.1" class="ltx_Math" alttext="\sigma" display="inline"><semantics id="S4.SS1.p4.1.m1.1a"><mi id="S4.SS1.p4.1.m1.1.1" xref="S4.SS1.p4.1.m1.1.1.cmml">σ</mi><annotation-xml encoding="MathML-Content" id="S4.SS1.p4.1.m1.1b"><ci id="S4.SS1.p4.1.m1.1.1.cmml" xref="S4.SS1.p4.1.m1.1.1">𝜎</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p4.1.m1.1c">\sigma</annotation></semantics></math> and omit it in the notation, i.e. we write <math id="S4.SS1.p4.2.m2.6" class="ltx_Math" alttext="\mathcal{NN}_{\infty,d_{0},d_{1}}:=\mathcal{NN}^{\sigma}_{\infty,d_{0},d_{1}}" display="inline"><semantics id="S4.SS1.p4.2.m2.6a"><mrow id="S4.SS1.p4.2.m2.6.7" xref="S4.SS1.p4.2.m2.6.7.cmml"><mrow id="S4.SS1.p4.2.m2.6.7.2" xref="S4.SS1.p4.2.m2.6.7.2.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS1.p4.2.m2.6.7.2.2" xref="S4.SS1.p4.2.m2.6.7.2.2.cmml">𝒩</mi><mo lspace="0em" rspace="0em" id="S4.SS1.p4.2.m2.6.7.2.1" xref="S4.SS1.p4.2.m2.6.7.2.1.cmml">​</mo><msub id="S4.SS1.p4.2.m2.6.7.2.3" xref="S4.SS1.p4.2.m2.6.7.2.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS1.p4.2.m2.6.7.2.3.2" xref="S4.SS1.p4.2.m2.6.7.2.3.2.cmml">𝒩</mi><mrow id="S4.SS1.p4.2.m2.3.3.3.3" xref="S4.SS1.p4.2.m2.3.3.3.4.cmml"><mi mathvariant="normal" id="S4.SS1.p4.2.m2.1.1.1.1" xref="S4.SS1.p4.2.m2.1.1.1.1.cmml">∞</mi><mo id="S4.SS1.p4.2.m2.3.3.3.3.3" xref="S4.SS1.p4.2.m2.3.3.3.4.cmml">,</mo><msub id="S4.SS1.p4.2.m2.2.2.2.2.1" xref="S4.SS1.p4.2.m2.2.2.2.2.1.cmml"><mi id="S4.SS1.p4.2.m2.2.2.2.2.1.2" xref="S4.SS1.p4.2.m2.2.2.2.2.1.2.cmml">d</mi><mn id="S4.SS1.p4.2.m2.2.2.2.2.1.3" xref="S4.SS1.p4.2.m2.2.2.2.2.1.3.cmml">0</mn></msub><mo id="S4.SS1.p4.2.m2.3.3.3.3.4" xref="S4.SS1.p4.2.m2.3.3.3.4.cmml">,</mo><msub id="S4.SS1.p4.2.m2.3.3.3.3.2" xref="S4.SS1.p4.2.m2.3.3.3.3.2.cmml"><mi id="S4.SS1.p4.2.m2.3.3.3.3.2.2" xref="S4.SS1.p4.2.m2.3.3.3.3.2.2.cmml">d</mi><mn id="S4.SS1.p4.2.m2.3.3.3.3.2.3" xref="S4.