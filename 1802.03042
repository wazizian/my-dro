.14.m14.1.1.3.cmml">ℓ</mi></msup><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem3.p1.14.m14.1b"><apply id="S4.Thmtheorem3.p1.14.m14.1.1.cmml" xref="S4.Thmtheorem3.p1.14.m14.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem3.p1.14.m14.1.1.1.cmml" xref="S4.Thmtheorem3.p1.14.m14.1.1">superscript</csymbol><ci id="S4.Thmtheorem3.p1.14.m14.1.1.2.cmml" xref="S4.Thmtheorem3.p1.14.m14.1.1.2">𝐴</ci><ci id="S4.Thmtheorem3.p1.14.m14.1.1.3.cmml" xref="S4.Thmtheorem3.p1.14.m14.1.1.3">ℓ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem3.p1.14.m14.1c">A^{\ell}</annotation></semantics></math> and vectors <math id="S4.Thmtheorem3.p1.15.m15.1" class="ltx_Math" alttext="b^{\ell}" display="inline"><semantics id="S4.Thmtheorem3.p1.15.m15.1a"><msup id="S4.Thmtheorem3.p1.15.m15.1.1" xref="S4.Thmtheorem3.p1.15.m15.1.1.cmml"><mi id="S4.Thmtheorem3.p1.15.m15.1.1.2" xref="S4.Thmtheorem3.p1.15.m15.1.1.2.cmml">b</mi><mi mathvariant="normal" id="S4.Thmtheorem3.p1.15.m15.1.1.3" xref="S4.Thmtheorem3.p1.15.m15.1.1.3.cmml">ℓ</mi></msup><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem3.p1.15.m15.1b"><apply id="S4.Thmtheorem3.p1.15.m15.1.1.cmml" xref="S4.Thmtheorem3.p1.15.m15.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem3.p1.15.m15.1.1.1.cmml" xref="S4.Thmtheorem3.p1.15.m15.1.1">superscript</csymbol><ci id="S4.Thmtheorem3.p1.15.m15.1.1.2.cmml" xref="S4.Thmtheorem3.p1.15.m15.1.1.2">𝑏</ci><ci id="S4.Thmtheorem3.p1.15.m15.1.1.3.cmml" xref="S4.Thmtheorem3.p1.15.m15.1.1.3">ℓ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem3.p1.15.m15.1c">b^{\ell}</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">
<span class="ltx_tag ltx_tag_subsection">4.2. </span>Optimal hedging using deep neural networks</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Motivated by the universal approximation results stated above, we now
consider neural network hedging strategies. Let our activation function therefore be bounded and non-constant.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.2" class="ltx_p">In order to apply our theorem <a href="#S4.Thmtheorem2" title="Theorem 4.2 (Universal approximation, [Hor91]). ‣ 4.1. Universal approximation by neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, we represent the optimization over
constrained trading strategies <math id="S4.SS2.p2.1.m1.1" class="ltx_Math" alttext="\delta\in\mathcal{H}" display="inline"><semantics id="S4.SS2.p2.1.m1.1a"><mrow id="S4.SS2.p2.1.m1.1.1" xref="S4.SS2.p2.1.m1.1.1.cmml"><mi id="S4.SS2.p2.1.m1.1.1.2" xref="S4.SS2.p2.1.m1.1.1.2.cmml">δ</mi><mo id="S4.SS2.p2.1.m1.1.1.1" xref="S4.SS2.p2.1.m1.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S4.SS2.p2.1.m1.1.1.3" xref="S4.SS2.p2.1.m1.1.1.3.cmml">ℋ</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.p2.1.m1.1b"><apply id="S4.SS2.p2.1.m1.1.1.cmml" xref="S4.SS2.p2.1.m1.1.1"><in id="S4.SS2.p2.1.m1.1.1.1.cmml" xref="S4.SS2.p2.1.m1.1.1.1"></in><ci id="S4.SS2.p2.1.m1.1.1.2.cmml" xref="S4.SS2.p2.1.m1.1.1.2">𝛿</ci><ci id="S4.SS2.p2.1.m1.1.1.3.cmml" xref="S4.SS2.p2.1.m1.1.1.3">ℋ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.p2.1.m1.1c">\delta\in\mathcal{H}</annotation></semantics></math> as an optimization over <math id="S4.SS2.p2.2.m2.1" class="ltx_Math" alttext="\delta\in\mathcal{H}^{u}" display="inline"><semantics id="S4.SS2.p2.2.m2.1a"><mrow id="S4.SS2.p2.2.m2.1.1" xref="S4.SS2.p2.2.m2.1.1.cmml"><mi id="S4.SS2.p2.2.m2.1.1.2" xref="S4.SS2.p2.2.m2.1.1.2.cmml">δ</mi><mo id="S4.SS2.p2.2.m2.1.1.1" xref="S4.SS2.p2.2.m2.1.1.1.cmml">∈</mo><msup id="S4.SS2.p2.2.m2.1.1.3" xref="S4.SS2.p2.2.m2.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS2.p2.2.m2.1.1.3.2" xref="S4.SS2.p2.2.m2.1.1.3.2.cmml">ℋ</mi><mi id="S4.SS2.p2.2.m2.1.1.3.3" xref="S4.SS2.p2.2.m2.1.1.3.3.cmml">u</mi></msup></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.p2.2.m2.1b"><apply id="S4.SS2.p2.2.m2.1.1.cmml" xref="S4.SS2.p2.2.m2.1.1"><in id="S4.SS2.p2.2.m2.1.1.1.cmml" xref="S4.SS2.p2.2.m2.1.1.1"></in><ci id="S4.SS2.p2.2.m2.1.1.2.cmml" xref="S4.SS2.p2.2.m2.1.1.2">𝛿</ci><apply id="S4.SS2.p2.2.m2.1.1.3.cmml" xref="S4.SS2.p2.2.m2.1.1.3"><csymbol cd="ambiguous" id="S4.SS2.p2.2.m2.1.1.3.1.cmml" xref="S4.SS2.p2.2.m2.1.1.3">superscript</csymbol><ci id="S4.SS2.p2.2.m2.1.1.3.2.cmml" xref="S4.SS2.p2.2.m2.1.1.3.2">ℋ</ci><ci id="S4.SS2.p2.2.m2.1.1.3.3.cmml" xref="S4.SS2.p2.2.m2.1.1.3.3">𝑢</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.p2.2.m2.1c">\delta\in\mathcal{H}^{u}</annotation></semantics></math> with a
following modified objective.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.1.1.1" class="ltx_text ltx_font_bold">Lemma 4.4</span></span><span id="S4.Thmtheorem4.2.2" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">We may write the constrained problem <a href="#S3.E1" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> as the modified unconstrained problem as</span></p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.1’)</span></td>
