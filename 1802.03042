Here, <math id="S2.SS0.SSSx2.p1.8.m8.1" class="ltx_Math" alttext="\delta^{i}_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p1.8.m8.1a"><msubsup id="S2.SS0.SSSx2.p1.8.m8.1.1" xref="S2.SS0.SSSx2.p1.8.m8.1.1.cmml"><mi id="S2.SS0.SSSx2.p1.8.m8.1.1.2.2" xref="S2.SS0.SSSx2.p1.8.m8.1.1.2.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p1.8.m8.1.1.3" xref="S2.SS0.SSSx2.p1.8.m8.1.1.3.cmml">k</mi><mi id="S2.SS0.SSSx2.p1.8.m8.1.1.2.3" xref="S2.SS0.SSSx2.p1.8.m8.1.1.2.3.cmml">i</mi></msubsup><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.8.m8.1b"><apply id="S2.SS0.SSSx2.p1.8.m8.1.1.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.8.m8.1.1.1.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1">subscript</csymbol><apply id="S2.SS0.SSSx2.p1.8.m8.1.1.2.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.8.m8.1.1.2.1.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1">superscript</csymbol><ci id="S2.SS0.SSSx2.p1.8.m8.1.1.2.2.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1.2.2">𝛿</ci><ci id="S2.SS0.SSSx2.p1.8.m8.1.1.2.3.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1.2.3">𝑖</ci></apply><ci id="S2.SS0.SSSx2.p1.8.m8.1.1.3.cmml" xref="S2.SS0.SSSx2.p1.8.m8.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.8.m8.1c">\delta^{i}_{k}</annotation></semantics></math> denotes the agent’s holdings of the <math id="S2.SS0.SSSx2.p1.9.m9.1" class="ltx_Math" alttext="i" display="inline"><semantics id="S2.SS0.SSSx2.p1.9.m9.1a"><mi id="S2.SS0.SSSx2.p1.9.m9.1.1" xref="S2.SS0.SSSx2.p1.9.m9.1.1.cmml">i</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.9.m9.1b"><ci id="S2.SS0.SSSx2.p1.9.m9.1.1.cmml" xref="S2.SS0.SSSx2.p1.9.m9.1.1">𝑖</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.9.m9.1c">i</annotation></semantics></math>th asset at time <math id="S2.SS0.SSSx2.p1.10.m10.1" class="ltx_Math" alttext="t_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p1.10.m10.1a"><msub id="S2.SS0.SSSx2.p1.10.m10.1.1" xref="S2.SS0.SSSx2.p1.10.m10.1.1.cmml"><mi id="S2.SS0.SSSx2.p1.10.m10.1.1.2" xref="S2.SS0.SSSx2.p1.10.m10.1.1.2.cmml">t</mi><mi id="S2.SS0.SSSx2.p1.10.m10.1.1.3" xref="S2.SS0.SSSx2.p1.10.m10.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.10.m10.1b"><apply id="S2.SS0.SSSx2.p1.10.m10.1.1.cmml" xref="S2.SS0.SSSx2.p1.10.m10.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.10.m10.1.1.1.cmml" xref="S2.SS0.SSSx2.p1.10.m10.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p1.10.m10.1.1.2.cmml" xref="S2.SS0.SSSx2.p1.10.m10.1.1.2">𝑡</ci><ci id="S2.SS0.SSSx2.p1.10.m10.1.1.3.cmml" xref="S2.SS0.SSSx2.p1.10.m10.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.10.m10.1c">t_{k}</annotation></semantics></math>.
We may also define <math id="S2.SS0.SSSx2.p1.11.m11.1" class="ltx_Math" alttext="\delta_{-1}=\delta_{n}:=0" display="inline"><semantics id="S2.SS0.SSSx2.p1.11.m11.1a"><mrow id="S2.SS0.SSSx2.p1.11.m11.1.1" xref="S2.SS0.SSSx2.p1.11.m11.1.1.cmml"><msub id="S2.SS0.SSSx2.p1.11.m11.1.1.2" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.cmml"><mi id="S2.SS0.SSSx2.p1.11.m11.1.1.2.2" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.2.cmml">δ</mi><mrow id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.cmml"><mo id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3a" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.cmml">−</mo><mn id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.2" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.2.cmml">1</mn></mrow></msub><mo id="S2.SS0.SSSx2.p1.11.m11.1.1.3" xref="S2.SS0.SSSx2.p1.11.m11.1.1.3.cmml">=</mo><msub id="S2.SS0.SSSx2.p1.11.m11.1.1.4" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4.cmml"><mi id="S2.SS0.SSSx2.p1.11.m11.1.1.4.2" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p1.11.m11.1.1.4.3" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4.3.cmml">n</mi></msub><mo lspace="0.278em" rspace="0.278em" id="S2.SS0.SSSx2.p1.11.m11.1.1.5" xref="S2.SS0.SSSx2.p1.11.m11.1.1.5.cmml">:=</mo><mn id="S2.SS0.SSSx2.p1.11.m11.1.1.6" xref="S2.SS0.SSSx2.p1.11.m11.1.1.6.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.11.m11.1b"><apply id="S2.SS0.SSSx2.p1.11.m11.1.1.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1"><and id="S2.SS0.SSSx2.p1.11.m11.1.1a.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1"></and><apply id="S2.SS0.SSSx2.p1.11.m11.1.1b.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1"><eq id="S2.SS0.SSSx2.p1.11.m11.1.1.3.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.3"></eq><apply id="S2.SS0.SSSx2.p1.11.m11.1.1.2.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.11.m11.1.1.2.1.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2">subscript</csymbol><ci id="S2.SS0.SSSx2.p1.11.m11.1.1.2.2.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.2">𝛿</ci><apply id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3"><minus id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.1.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3"></minus><cn type="integer" id="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.2.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.2.3.2">1</cn></apply></apply><apply id="S2.SS0.SSSx2.p1.11.m11.1.1.4.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.11.m11.1.1.4.1.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4">subscript</csymbol><ci id="S2.SS0.SSSx2.p1.11.m11.1.1.4.2.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4.2">𝛿</ci><ci id="S2.SS0.SSSx2.p1.11.m11.1.1.4.3.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.4.3">𝑛</ci></apply></apply><apply id="S2.SS0.SSSx2.p1.11.m11.1.1c.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1"><csymbol cd="latexml" id="S2.SS0.SSSx2.p1.11.m11.1.1.5.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.5">assign</csymbol><share href="#S2.SS0.SSSx2.p1.11.m11.1.1.4.cmml" id="S2.SS0.SSSx2.p1.11.m11.1.1d.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1"></share><cn type="integer" id="S2.SS0.SSSx2.p1.11.m11.1.1.6.cmml" xref="S2.SS0.SSSx2.p1.11.m11.1.1.6">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.11.m11.1c">\delta_{-1}=\delta_{n}:=0</annotation></semantics></math> for notational convenience.</p>
</div>
<div id="S2.SS0.SSSx2.p2" class="ltx_para">
<p id="S2.SS0.SSSx2.p2.9" class="ltx_p">We denote by <math id="S2.SS0.SSSx2.p2.1.m1.1" class="ltx_Math" alttext="\mathcal{H}^{u}" display="inline"><semantics id="S2.SS0.SSSx2.p2.1.m1.1a"><msup id="S2.SS0.SSSx2.p2.1.m1.1.1" xref="S2.SS0.SSSx2.p2.1.m1.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS0.SSSx2.p2.1.m1.1.1.2" xref="S2.SS0.SSSx2.p2.1.m1.1.1.2.cmml">ℋ</mi><mi id="S2.SS0.SSSx2.p2.1.m1.1.1.3" xref="S2.SS0.SSSx2.p2.1.m1.1.1.3.cmml">u</mi></msup><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.1.m1.1b"><apply id="S2.SS0.SSSx2.p2.1.m1.1.1.cmml" xref="S2.SS0.SSSx2.p2.1.m1.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p2.1.m1.1.1.1.cmml" xref="S2.SS0.SSSx2.p2.1.m1.1.1">superscript</csymbol><ci id="S2.SS0.SSSx2.p2.1.m1.1.1.2.cmml" xref="S2.SS0.SSSx2.p2.1.m1.1.1.2">ℋ</ci><ci id="S2.SS0.SSSx2.p2.1.m1.1.1.3.cmml" xref="S2.SS0.SSSx2.p2.1.m1.1.1.3">𝑢</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.1.m1.1c">\mathcal{H}^{u}</annotation></semantics></math> the unconstrained set of such trading strategies. However, each <math id="S2.SS0.SSSx2.p2.2.m2.1" class="ltx_Math" alttext="\delta_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p2.2.m2.1a"><msub id="S2.SS0.SSSx2.p2.2.m2.1.1" xref="S2.SS0.SSSx2.p2.2.m2.1.1.cmml"><mi id="S2.SS0.SSSx2.p2.2.m2.1.1.2" xref="S2.SS0.SSSx2.p2.2.m2.1.1.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p2.2.m2.1.1.3" xref="S2.SS0.SSSx2.p2.2.m2.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.2.m2.1b"><apply id="S2.SS0.SSSx2.p2.2.m2.1.1.cmml" xref="S2.SS0.SSSx2.p2.2.m2.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p2.2.m2.1.1.1.cmml" xref="S2.SS0.SSSx2.p2.2.m2.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p2.2.m2.1.1.2.cmml" xref="S2.SS0.SSSx2.p2.2.m2.1.1.2">𝛿</ci><ci id="S2.SS0.SSSx2.p2.2.m2.1.1.3.cmml" xref="S2.SS0.SSSx2.p2.2.m2.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.2.m2.1c">\delta_{k}</annotation></semantics></math> is subject to additional trading constraints. Such restrictions arise due to liquidity, asset availability or trading restrictions.
They are also used to restrict trading in a particular option prior to its availability. In the example above of an option
which is listed in 3M, the respective trading constraints would be <math id="S2.SS0.SSSx2.p2.3.m3.1" class="ltx_Math" alttext="\{0\}" display="inline"><semantics id="S2.SS0.SSSx2.p2.3.m3.1a"><mrow id="S2.SS0.SSSx2.p2.3.m3.1.2.2" xref="S2.SS0.SSSx2.p2.3.m3.1.2.1.cmml"><mo stretchy="false" id="S2.SS0.SSSx2.p2.3.m3.1.2.2.1" xref="S2.SS0.SSSx2.p2.3.m3.1.2.1.cmml">{</mo><mn id="S2.SS0.SSSx2.p2.3.m3.1.1" xref="S2.SS0.SSSx2.p2.3.m3.1.1.cmml">0</mn><mo stretchy="false" id="S2.SS0.SSSx2.p2.3.m3.1.2.2.2" xref="S2.SS0.SSSx2.p2.3.m3.1.2.1.cmml">}</mo></mrow><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.3.m3.1b"><set id="S2.SS0.SSSx2.p2.3.m3.1.2.1.cmml" xref="S2.SS0.SSSx2.p2.3.m3.1.2.2"><cn type="integer" id="S2.SS0.SSSx2.p2.3.m3.1.1.cmml" xref="S2.SS0.SSSx2.p2.3.m3.1.1">0</cn></set></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.3.m3.1c">\{0\}</annotation></semantics></math> until the 3M point. To incorporate these effects,
we assume that <math id="S2.SS0.SSSx2.p2.4.m4.1" class="ltx_Math" alttext="\delta_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p2.4.m4.1a"><msub id="S2.SS0.SSSx2.p2.4.m4.1.1" xref="S2.SS0.SSSx2.p2.4.m4.1.1.cmml"><mi id="S2.SS0.SSSx2.p2.4.m4.1.1.2" xref="S2.SS0.SSSx2.p2.4.m4.1.1.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p2.4.m4.1.1.3" xref="S2.SS0.SSSx2.p2.4.m4.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.4.m4.1b"><apply id="S2.SS0.SSSx2.p2.4.m4.1.1.cmml" xref="S2.SS0.SSSx2.p2.4.m4.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p2.4.m4.1.1.1.cmml" xref="S2.SS0.SSSx2.p2.4.m4.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p2.4.m4.1.1.2.cmml" xref="S2.SS0.SSSx2.p2.4.m4.1.1.2">𝛿</ci><ci id="S2.SS0.SSSx2.p2.4.m4.1.1.3.cmml" xref="S2.SS0.SSSx2.p2.4.m4.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.4.m4.1c">\delta_{k}</annotation></semantics></math> is restricted to a set <math id="S2.SS0.SSSx2.p2.5.m5.1" class="ltx_Math" alttext="\mathcal{H}_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p2.5.m5.1a"><msub id="S2.SS0.SSSx2.p2.5.m5.1.1" xref="S2.SS0.SSSx2.p2.5.m5.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS0.SSSx2.p2.5.m5.1.1.2" xref="S2.SS0.SSSx2.p2.5.m5.1.1.2.cmml">ℋ</mi><mi id="S2.SS0.SSSx2.p2.5.m5.1.1.3" xref="S2.SS0.SSSx2.p2.5.m5.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.5.m5.1b"><apply id="S2.SS0.SSSx2.p2.5.m5.1.1.cmml" xref="S2.SS0.SSSx2.p2.5.m5.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p2.5.m5.1.1.1.cmml" xref="S2.SS0.SSSx2.p2.5.m5.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p2.5.m5.1.1.2.cmml" xref="S2.SS0.SSSx2.p2.5.m5.1.1.2">ℋ</ci><ci id="S2.SS0.SSSx2.p2.5.m5.1.1.3.cmml" xref="S2.SS0.SSSx2.p2.5.m5.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.5.m5.1c">\mathcal{H}_{k}</annotation></semantics></math> which is given as the image of a continuous, <math id="S2.SS0.SSSx2.p2.6.m6.1" class="ltx_Math" alttext="\mathcal{F}_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p2.6.m6.1a"><msub id="S2.SS0.SSSx2.p2.6.m6.1.1" xref="S2.SS0.SSSx2.p2.6.m6.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS0.SSSx2.p2.6.m6.1.1.2" xref="S2.SS0.SSSx2.p2.6.m6.1.1.2.cmml">ℱ</mi><mi id="S2.SS0.SSSx2.p2.6.m6.1.1.3" xref="S2.SS0.SSSx2.p2.6.m6.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p2.6.m6.1b"><apply id="S2.SS0.SSSx2.p2.6.m6.1.1.cmml" xref="S2.SS0.SSSx2.p2.6.m6.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p2.6.m6.1.1.1.cmml" xref="S2.SS0.SSSx2.p2.6.m6.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p2.6.m6.1.1.2.cmml" xref="S2.SS0.SSSx2.p2.6.m6.1.1.2">ℱ</ci><ci id="S2.SS0.SSSx2.p2.6.m6.1.1.3.cmml" xref="S2.SS0.SSSx2.p2.6.m6.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p2.6.m6.1c">\mathcal{F}_{k}</annotation></semantics></math>-measurable
