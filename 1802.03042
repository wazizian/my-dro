</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.1.1.1" class="ltx_text ltx_font_italic">Remark 2.2</span></span><span id="S2.Thmtheorem2.2.2" class="ltx_text ltx_font_italic">.</span>
</h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p">Our general setup also allows modeling true market impact: in this case, the asset distribution is
affected by our trading decisions.</p>
</div>
<div id="S2.Thmtheorem2.p2" class="ltx_para">
<p id="S2.Thmtheorem2.p2.6" class="ltx_p">As an example for permanent market impact, assume for simplicity that <math id="S2.Thmtheorem2.p2.1.m1.1" class="ltx_Math" alttext="I=S" display="inline"><semantics id="S2.Thmtheorem2.p2.1.m1.1a"><mrow id="S2.Thmtheorem2.p2.1.m1.1.1" xref="S2.Thmtheorem2.p2.1.m1.1.1.cmml"><mi id="S2.Thmtheorem2.p2.1.m1.1.1.2" xref="S2.Thmtheorem2.p2.1.m1.1.1.2.cmml">I</mi><mo id="S2.Thmtheorem2.p2.1.m1.1.1.1" xref="S2.Thmtheorem2.p2.1.m1.1.1.1.cmml">=</mo><mi id="S2.Thmtheorem2.p2.1.m1.1.1.3" xref="S2.Thmtheorem2.p2.1.m1.1.1.3.cmml">S</mi></mrow><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem2.p2.1.m1.1b"><apply id="S2.Thmtheorem2.p2.1.m1.1.1.cmml" xref="S2.Thmtheorem2.p2.1.m1.1.1"><eq id="S2.Thmtheorem2.p2.1.m1.1.1.1.cmml" xref="S2.Thmtheorem2.p2.1.m1.1.1.1"></eq><ci id="S2.Thmtheorem2.p2.1.m1.1.1.2.cmml" xref="S2.Thmtheorem2.p2.1.m1.1.1.2">𝐼</ci><ci id="S2.Thmtheorem2.p2.1.m1.1.1.3.cmml" xref="S2.Thmtheorem2.p2.1.m1.1.1.3">𝑆</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem2.p2.1.m1.1c">I=S</annotation></semantics></math> and
that we have a statistical model of our market in the form of a conditional
distribution <math id="S2.Thmtheorem2.p2.2.m2.1" class="ltx_Math" alttext="P(S_{k+1}|S_{k})" display="inline"><semantics id="S2.Thmtheorem2.p2.2.m2.1a"><mrow id="S2.Thmtheorem2.p2.2.m2.1.1" xref="S2.Thmtheorem2.p2.2.m2.1.1.cmml"><mi id="S2.Thmtheorem2.p2.2.m2.1.1.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.3.cmml">P</mi><mo lspace="0em" rspace="0em" id="S2.Thmtheorem2.p2.2.m2.1.1.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.2.cmml">​</mo><mrow id="S2.Thmtheorem2.p2.2.m2.1.1.1.1" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.cmml"><mo stretchy="false" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.cmml">(</mo><mrow id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.cmml"><msub id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.cmml"><mi id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.2.cmml">S</mi><mrow id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.cmml"><mi id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.2.cmml">k</mi><mo id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.1" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.1.cmml">+</mo><mn id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.3.cmml">1</mn></mrow></msub><mo fence="false" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.1" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.1.cmml">|</mo><msub id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.cmml"><mi id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.2" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.2.cmml">S</mi><mi id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.3.cmml">k</mi></msub></mrow><mo stretchy="false" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.3" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem2.p2.2.m2.1b"><apply id="S2.Thmtheorem2.p2.2.m2.1.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1"><times id="S2.Thmtheorem2.p2.2.m2.1.1.2.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.2"></times><ci id="S2.Thmtheorem2.p2.2.m2.1.1.3.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.3">𝑃</ci><apply id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1"><csymbol cd="latexml" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.1">conditional</csymbol><apply id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2">subscript</csymbol><ci id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.2.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.2">𝑆</ci><apply id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3"><plus id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.1"></plus><ci id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.2.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.2">𝑘</ci><cn type="integer" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.3.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.2.3.3">1</cn></apply></apply><apply id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3"><csymbol cd="ambiguous" id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.1.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3">subscript</csymbol><ci id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.2.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.2">𝑆</ci><ci id="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.3.cmml" xref="S2.Thmtheorem2.p2.2.m2.1.1.1.1.1.3.3">𝑘</ci></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem2.p2.2.m2.1c">P(S_{k+1}|S_{k})</annotation></semantics></math>. For a proportional impact parameter <math id="S2.Thmtheorem2.p2.3.m3.1" class="ltx_Math" alttext="\iota&gt;0" display="inline"><semantics id="S2.Thmtheorem2.p2.3.m3.1a"><mrow id="S2.Thmtheorem2.p2.3.m3.1.1" xref="S2.Thmtheorem2.p2.3.m3.1.1.cmml"><mi id="S2.Thmtheorem2.p2.3.m3.1.1.2" xref="S2.Thmtheorem2.p2.3.m3.1.1.2.cmml">ι</mi><mo id="S2.Thmtheorem2.p2.3.m3.1.1.1" xref="S2.Thmtheorem2.p2.3.m3.1.1.1.cmml">&gt;</mo><mn id="S2.Thmtheorem2.p2.3.m3.1.1.3" xref="S2.Thmtheorem2.p2.3.m3.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem2.p2.3.m3.1b"><apply id="S2.Thmtheorem2.p2.3.m3.1.1.cmml" xref="S2.Thmtheorem2.p2.3.m3.1.1"><gt id="S2.Thmtheorem2.p2.3.m3.1.1.1.cmml" xref="S2.Thmtheorem2.p2.3.m3.1.1.1"></gt><ci id="S2.Thmtheorem2.p2.3.m3.1.1.2.cmml" xref="S2.Thmtheorem2.p2.3.m3.1.1.2">𝜄</ci><cn type="integer" id="S2.Thmtheorem2.p2.3.m3.1.1.3.cmml" xref="S2.Thmtheorem2.p2.3.m3.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem2.p2.3.m3.1c">\iota&gt;0</annotation></semantics></math>
we may now define the dynamics of <math id="S2.Thmtheorem2.p2.4.m4.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S2.Thmtheorem2.p2.4.m4.1a"><mi id="S2.Thmtheorem2.p2.4.m4.1.1" xref="S2.Thmtheorem2.p2.4.m4.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S2.Thmtheorem2.p2.4.m4.1b"><ci id="S2.Thmtheorem2.p2.4.m4.1.1.cmml" xref="S2.Thmtheorem2.p2.4.m4.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.Thmtheorem2.p2.4.m4.1c">S</annotation></semantics></math> under exponentially
decaying, proportional market impact as <math id="S2.Thmtheorem2.p2.5.m5.1" class="ltx_Math" alttext="P\left(\ S_{k+1}\ \big{|}\ S_{k}\left(1+\iota(\delta_{k}-\delta_{k-1})\right)\ \right)" display="inline"><semantics id="S2.Thmtheorem2.p2.5.m5.1a"><mrow id="S2.Thmtheorem2.p2.5.m5.1.1" xref="S2.Thmtheorem2.p2.5.m5.1.1.cmml"><mi id="S2.Thmtheorem2.p2.5.m5.1.1.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.3.cmml">P</mi><mo lspace="0em" rspace="0em" id="S2.Thmtheorem2.p2.5.m5.1.1.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.2.cmml">​</mo><mrow id="S2.Thmtheorem2.p2.5.m5.1.1.1.1" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.cmml"><mo rspace="0.500em" id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.cmml">(</mo><mrow id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.cmml"><msub id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.cmml"><mi id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.2.cmml">S</mi><mrow id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.cmml"><mi id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.2.cmml">k</mi><mo id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.1" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.1.cmml">+</mo><mn id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.3.3.3.cmml">1</mn></mrow></msub><mo fence="false" mathsize="120%" rspace="0.778em" id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.2.cmml">|</mo><mrow id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.cmml"><msub id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3.cmml"><mi id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3.2" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3.2.cmml">S</mi><mi id="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3.3" xref="S2.Thmtheorem2.p2.5.m5.1.1.1.1.1.1.3.3.cmml">k</mi></msub><mo lspace="0em" rspa