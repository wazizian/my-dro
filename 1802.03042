<p id="S2.SS0.SSSx2.p3.4" class="ltx_p">Moreover, for an unconstrained strategy <math id="S2.SS0.SSSx2.p3.1.m1.1" class="ltx_Math" alttext="\delta^{u}\in\mathcal{H}^{u}" display="inline"><semantics id="S2.SS0.SSSx2.p3.1.m1.1a"><mrow id="S2.SS0.SSSx2.p3.1.m1.1.1" xref="S2.SS0.SSSx2.p3.1.m1.1.1.cmml"><msup id="S2.SS0.SSSx2.p3.1.m1.1.1.2" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2.cmml"><mi id="S2.SS0.SSSx2.p3.1.m1.1.1.2.2" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p3.1.m1.1.1.2.3" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2.3.cmml">u</mi></msup><mo id="S2.SS0.SSSx2.p3.1.m1.1.1.1" xref="S2.SS0.SSSx2.p3.1.m1.1.1.1.cmml">∈</mo><msup id="S2.SS0.SSSx2.p3.1.m1.1.1.3" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS0.SSSx2.p3.1.m1.1.1.3.2" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3.2.cmml">ℋ</mi><mi id="S2.SS0.SSSx2.p3.1.m1.1.1.3.3" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3.3.cmml">u</mi></msup></mrow><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p3.1.m1.1b"><apply id="S2.SS0.SSSx2.p3.1.m1.1.1.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1"><in id="S2.SS0.SSSx2.p3.1.m1.1.1.1.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.1"></in><apply id="S2.SS0.SSSx2.p3.1.m1.1.1.2.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p3.1.m1.1.1.2.1.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2">superscript</csymbol><ci id="S2.SS0.SSSx2.p3.1.m1.1.1.2.2.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2.2">𝛿</ci><ci id="S2.SS0.SSSx2.p3.1.m1.1.1.2.3.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.2.3">𝑢</ci></apply><apply id="S2.SS0.SSSx2.p3.1.m1.1.1.3.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p3.1.m1.1.1.3.1.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3">superscript</csymbol><ci id="S2.SS0.SSSx2.p3.1.m1.1.1.3.2.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3.2">ℋ</ci><ci id="S2.SS0.SSSx2.p3.1.m1.1.1.3.3.cmml" xref="S2.SS0.SSSx2.p3.1.m1.1.1.3.3">𝑢</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p3.1.m1.1c">\delta^{u}\in\mathcal{H}^{u}</annotation></semantics></math>, we (successively) define with <math id="S2.SS0.SSSx2.p3.2.m2.5" class="ltx_Math" alttext="(H\circ\delta^{u})_{k}:=H_{k}((H\circ\delta^{u})_{0},\ldots,(H\circ\delta^{u})_{k-1},\delta^{u}_{k})" display="inline"><semantics id="S2.SS0.SSSx2.p3.2.m2.5a"><mrow id="S2.SS0.SSSx2.p3.2.m2.5.5" xref="S2.SS0.SSSx2.p3.2.m2.5.5.cmml"><msub id="S2.SS0.SSSx2.p3.2.m2.2.2.1" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.cmml"><mrow id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.cmml"><mo stretchy="false" id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.2" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.cmml">(</mo><mrow id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.cmml"><mi id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.2" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.2.cmml">H</mi><mo lspace="0.222em" rspace="0.222em" id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.1" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.1.cmml">∘</mo><msup id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3.cmml"><mi id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3.2" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3.2.cmml">δ</mi><mi id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3.3" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.3.3.cmml">u</mi></msup></mrow><mo stretchy="false" id="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.3" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.1.1.1.cmml">)</mo></mrow><mi id="S2.SS0.SSSx2.p3.2.m2.2.2.1.3" xref="S2.SS0.SSSx2.p3.2.m2.2.2.1.3.cmml">k</mi></msub><mo lspace="0.278em" rspace="0.278em" id="S2.SS0.SSSx2.p3.2.m2.5.5.5" xref="S2.SS0.SSSx2.p3.2.m2.5.5.5.cmml">:=</mo><mrow id="S2.SS0.SSSx2.p3.2.m2.5.5.4" xref="S2.SS0.SSSx2.p3.2.m2.5.5.4.cmml"><msub id="S2.SS0.SSSx2.p3.2.m2.5.5.4.5" xref="S2.SS0.SSSx2.p3.2.m2.5.5.4.5.cmml"><mi id="S2.SS0.SSSx2.p3.2.m2.5.5.4.5.2" xref="S2.SS0.SSSx2.p3.2.m2.5.5.4.5.2.cmml">H</mi><mi id="S2.SS0.SSSx2.p3.2.m2.5.5.4.5.3" xref="S2.SS0.SSSx2.p3.2.m2.5.5.4.5.3.cmml">k</mi></msub><mo lspace="0em" rspace="0em" id="S2.SS0.SSSx2.p3.2