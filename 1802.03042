5.1.1"><and id="S5.SS1.p1.15.m15.1.1a.cmml" xref="S5.SS1.p1.15.m15.1.1"></and><apply id="S5.SS1.p1.15.m15.1.1b.cmml" xref="S5.SS1.p1.15.m15.1.1"><eq id="S5.SS1.p1.15.m15.1.1.3.cmml" xref="S5.SS1.p1.15.m15.1.1.3"></eq><apply id="S5.SS1.p1.15.m15.1.1.2.cmml" xref="S5.SS1.p1.15.m15.1.1.2"><csymbol cd="ambiguous" id="S5.SS1.p1.15.m15.1.1.2.1.cmml" xref="S5.SS1.p1.15.m15.1.1.2">subscript</csymbol><ci id="S5.SS1.p1.15.m15.1.1.2.2.cmml" xref="S5.SS1.p1.15.m15.1.1.2.2">𝑁</ci><cn type="integer" id="S5.SS1.p1.15.m15.1.1.2.3.cmml" xref="S5.SS1.p1.15.m15.1.1.2.3">1</cn></apply><apply id="S5.SS1.p1.15.m15.1.1.4.cmml" xref="S5.SS1.p1.15.m15.1.1.4"><csymbol cd="ambiguous" id="S5.SS1.p1.15.m15.1.1.4.1.cmml" xref="S5.SS1.p1.15.m15.1.1.4">subscript</csymbol><ci id="S5.SS1.p1.15.m15.1.1.4.2.cmml" xref="S5.SS1.p1.15.m15.1.1.4.2">𝑁</ci><cn type="integer" id="S5.SS1.p1.15.m15.1.1.4.3.cmml" xref="S5.SS1.p1.15.m15.1.1.4.3">2</cn></apply></apply><apply id="S5.SS1.p1.15.m15.1.1c.cmml" xref="S5.SS1.p1.15.m15.1.1"><eq id="S5.SS1.p1.15.m15.1.1.5.cmml" xref="S5.SS1.p1.15.m15.1.1.5"></eq><share href="#S5.SS1.p1.15.m15.1.1.4.cmml" id="S5.SS1.p1.15.m15.1.1d.cmml" xref="S5.SS1.p1.15.m15.1.1"></share><apply id="S5.SS1.p1.15.m15.1.1.6.cmml" xref="S5.SS1.p1.15.m15.1.1.6"><plus id="S5.SS1.p1.15.m15.1.1.6.1.cmml" xref="S5.SS1.p1.15.m15.1.1.6.1"></plus><ci id="S5.SS1.p1.15.m15.1.1.6.2.cmml" xref="S5.SS1.p1.15.m15.1.1.6.2">𝑑</ci><cn type="integer" id="S5.SS1.p1.15.m15.1.1.6.3.cmml" xref="S5.SS1.p1.15.m15.1.1.6.3">15</cn></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS1.p1.15.m15.1c">N_{1}=N_{2}=d+15</annotation></semantics></math>, <math id="S5.SS1.p1.16.m16.1" class="ltx_Math" alttext="N_{3}=d" display="inline"><semantics id="S5.SS1.p1.16.m16.1a"><mrow id="S5.SS1.p1.16.m16.1.1" xref="S5.SS1.p1.16.m16.1.1.cmml"><msub id="S5.SS1.p1.16.m16.1.1.2" xref="S5.SS1.p1.16.m16.1.1.2.cmml"><mi id="S5.SS1.p1.16.m16.1.1.2.2" xref="S5.SS1.p1.16.m16.1.1.2.2.cmml">N</mi><mn id="S5.SS1.p1.16.m16.1.1.2.3" xref="S5.SS1.p1.16.m16.1.1.2.3.cmml">3</mn></msub><mo id="S5.SS1.p1.16.m16.1.1.1" xref="S5.SS1.p1.16.m16.1.1.1.cmml">=</mo><mi id="S5.SS1.p1.16.m16.1.1.3" xref="S5.SS1.p1.16.m16.1.1.3.cmml">d</mi></mrow><annotation-xml encoding="MathML-Content" id="S5.SS1.p1.16.m16.1b"><apply id="S5.SS1.p1.16.m16.1.1.cmml" xref="S5.SS1.p1.16.m16.1.1"><eq id="S5.SS1.p1.16.m16.1.1.1.cmml" xref="S5.SS1.p1.16.m16.1.1.1"></eq><apply id="S5.SS1.p1.16.m16.1.1.2.cmml" xref="S5.SS1.p1.16.m16.1.1.2"><csymbol cd="ambiguous" id="S5.SS1.p1.16.m16.1.1.2.1.cmml" xref="S5.SS1.p1.16.m16.1.1.2">subscript</csymbol><ci id="S5.SS1.p1.16.m16.1.1.2.2.cmml" xref="S5.SS1.p1.16.m16.1.1.2.2">𝑁</ci><cn type="integer" id="S5.SS1.p1.16.m16.1.1.2.3.cmml" xref="S5.SS1.p1.16.m16.1.1.2.3">3</cn></apply><ci id="S5.SS1.p1.16.m16.1.1.3.cmml" xref="S5.SS1.p1.16.m16.1.1.3">𝑑</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS1.p1.16.m16.1c">N_{3}=d</annotation></semantics></math> and the
activation function is always chosen as <math id="S5.SS1.p1.17.m17.4" class="ltx_Math" alttext="\sigma(x)=\max(x,0)" display="inline"><semantics id="S5.SS1.p1.17.m17.4a"><mrow id="S5.SS1.p1.17.m17.4.5" xref="S5.SS1.p1.17.m17.4.5.cmml"><mrow id="S5.SS1.p1.17.m17.4.5.2" xref="S5.SS1.p1.17.m17.4.5.2.cmml"><mi id="S5.SS1.p1.17.m17.4.5.2.2" xref="S5.SS1.p1.17.m17.4.5.2.2.cmml">σ</mi><mo lspace="0em" rspace="0em" id="S5.SS1.p1.17.m17.4.5.2.1" xref="S5.SS1.p1.17.m17.4.5.2.1.cmml">​</mo><mrow id="S5.SS1.p1.17.m17.4.5.2.3.2" xref="S5.SS1.p1.17.m17.4.5.2.cmml"><mo stretchy="false" id="S5.SS1.p1.17.m17.4.5.2.3.2.1" xref="S5.SS1.p1.17.m17.4.5.2.cmml">(</mo><mi id="S5.SS1.p1.17.m17.1.1" xref="S5.SS1.p1.17.m17.1.1.cmml">x</mi><mo stretchy="false" id="S5.SS1.p1.17.m17.4.5.2.3.2.2" xref="S5.SS1.p1.17.m17.4.5.2.cmml">)</mo></mrow></mrow><mo id="S5.SS1.p1.17.m17.4.5.1" xref="S5.SS1.p1.17.m17.4.5.1.cmml">=</mo><mrow id="S5.SS1.p1.17.m17.4.5.3.2" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml"><mi id="S5.SS1.p1.17.m17.2.2" xref="S5.SS1.p1.17.m17.2.2.cmml">max</mi><mo id="S5.SS1.p1.17.m17.4.5.3.2a" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml">⁡</mo><mrow id="S5.SS1.p1.17.m17.4.5.3.2.1" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml"><mo stretchy="false" id="S5.SS1.p1.17.m17.4.5.3.2.1.1" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml">(</mo><mi id="S5.SS1.p1.17.m17.3.3" xref="S5.SS1.p1.17.m17.3.3.cmml">x</mi><mo id="S5.SS1.p1.17.m17.4.5.3.2.1.2" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml">,</mo><mn id="S5.SS1.p1.17.m17.4.4" xref="S5.SS1.p1.17.m17.4.4.cmml">0</mn><mo stretchy="false" id="S5.SS1.p1.17.m17.4.5.3.2.1.3" xref="S5.SS1.p1.17.m17.4.5.3.1.cmml">)</mo></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS1.p1.17.m17.4b"><apply id="S5.SS1.p1.17.m17.4.5.cmml" xref="S5.SS1.p1.17.m17.4.5"><eq id="S5.SS1.p1.17.m17.4.5.1.cmml" xref="S5.SS1.p1.17.m17.4.5.1"></eq><apply id="S5.SS1.p1.17.m17.4.5.2.cmml" xref="S5.SS1.p1.17.m17.4.5.2"><times id="S5.SS1.p1.17.m17.4.5.2.1.cmml" xref="S5.SS1.p1.17.m17.4.5.2.1"></times><ci id="S5.SS1.p1.17.m17.4.5.2.2.cmml" xref="S5.SS1.p1.17.m17.4.5.2.2">𝜎</ci><ci id="S5.SS1.p1.17.m17.1.1.cmml" xref="S5.SS1.p1.17.m17.1.1">𝑥</ci></apply><apply id="S5.SS1.p1.17.m17.4.5.3.1.cmml" xref="S5.SS1.p1.17.m17.4.5.3.2"><max id="S5.SS1.p1.17.m17.2.2.cmml" xref="S5.SS1.p1.17.m17.2.2"></max><ci id="S5.SS1.p1.17.m17.3.3.cmml" xref="S5.SS1.p1.17.m17.3.3">𝑥</ci><cn type="integer" id="S5.SS1.p1.17.m17.4.4.cmml" xref="S5.SS1.p1.17.m17.4.4">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS1.p1.17.m17.4c">\sigma(x)=\max(x,0)</annotation></semantics></math>. The
weight matrices and biases are the parameters to be optimized in
(<a href="#S4.Ex4" title="4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>). Note that these are different for each <math id="S5.SS1.p1.18.m18.1" class="ltx_Math" alttext="k" display="inline"><semantics id="S5.SS1.p1.18.m18.1a"><mi id="S5.SS1.p1.18.m18.1.1" xref="S5.SS1.p1.18.m18.1.1.cmml">k</mi><annotation-xml encoding="MathML-Content" id="S5.SS1.p1.18.m18.1b"><ci id="S5.SS1.p1.18.m18.1.1.cmml" xref="S5.SS1.p1.18.m18.1.1">𝑘</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS1.p1.18.m18.1c">k</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.11" class="ltx_p">Having made these choices, the algorithm outlined in
Section <a href="#S4" title="4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> can now be used for approximate
hedging <span id="S5.SS1.p2.11.1" class="ltx_text ltx_font_italic">in any market situation</span>: given sample
