1">ℓ</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem1.p1.21.m16.1c">\ell</annotation></semantics></math>. The number of non-zero weights
of a network is the sum of the number of non-zero entries of the
matrices <math id="S4.Thmtheorem1.p1.22.m17.1" class="ltx_Math" alttext="A^{\ell}" display="inline"><semantics id="S4.Thmtheorem1.p1.22.m17.1a"><msup id="S4.Thmtheorem1.p1.22.m17.1.1" xref="S4.Thmtheorem1.p1.22.m17.1.1.cmml"><mi id="S4.Thmtheorem1.p1.22.m17.1.1.2" xref="S4.Thmtheorem1.p1.22.m17.1.1.2.cmml">A</mi><mi mathvariant="normal" id="S4.Thmtheorem1.p1.22.m17.1.1.3" xref="S4.Thmtheorem1.p1.22.m17.1.1.3.cmml">ℓ</mi></msup><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem1.p1.22.m17.1b"><apply id="S4.Thmtheorem1.p1.22.m17.1.1.cmml" xref="S4.Thmtheorem1.p1.22.m17.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem1.p1.22.m17.1.1.1.cmml" xref="S4.Thmtheorem1.p1.22.m17.1.1">superscript</csymbol><ci id="S4.Thmtheorem1.p1.22.m17.1.1.2.cmml" xref="S4.Thmtheorem1.p1.22.m17.1.1.2">𝐴</ci><ci id="S4.Thmtheorem1.p1.22.m17.1.1.3.cmml" xref="S4.Thmtheorem1.p1.22.m17.1.1.3">ℓ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem1.p1.22.m17.1c">A^{\ell}</annotation></semantics></math>, <math id="S4.Thmtheorem1.p1.23.m18.3" class="ltx_Math" alttext="\ell=1,\ldots,L" display="inline"><semantics id="S4.Thmtheorem1.p1.23.m18.3a"><mrow id="S4.Thmtheorem1.p1.23.m18.3.4" xref="S4.Thmtheorem1.p1.23.m18.3.4.cmml"><mi mathvariant="normal" id="S4.Thmtheorem1.p1.23.m18.3.4.2" xref="S4.Thmtheorem1.p1.23.m18.3.4.2.cmml">ℓ</mi><mo id="S4.Thmtheorem1.p1.23.m18.3.4.1" xref="S4.Thmtheorem1.p1.23.m18.3.4.1.cmml">=</mo><mrow id="S4.Thmtheorem1.p1.23.m18.3.4.3.2" xref="S4.Thmtheorem1.p1.23.m18.3.4.3.1.cmml"><mn id="S4.Thmtheorem1.p1.23.m18.1.1" xref="S4.Thmtheorem1.p1.23.m18.1.1.cmml">1</mn><mo id="S4.Thmtheorem1.p1.23.m18.3.4.3.2.1" xref="S4.Thmtheorem1.p1.23.m18.3.4.3.1.cmml">,</mo><mi mathvariant="normal" id="S4.Thmtheorem1.p1.23.m18.2.2" xref="S4.Thmtheorem1.p1.23.m18.2.2.cmml">…</mi><mo id="S4.Thmtheorem1.p1.23.m18.3.4.3.2.2" xref="S4.Thmtheorem1.p1.23.m18.3.4.3.1.cmml">,</mo><mi id="S4.Thmtheorem1.p1.23.m18.3.3" xref="S4.Thmtheorem1.p1.23.m18.3.3.cmml">L</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem1.p1.23.m18.3b"><apply id="S4.Thmtheorem1.p1.23.m18.3.4.cmml" xref="S4.Thmtheorem1.p1.23.m18.3.4"><eq id="S4.Thmtheorem1.p1.23.m18.3.4.1.cmml" xref="S4.Thmtheorem1.p1.23.m18.3.4.1"></eq><ci id="S4.Thmtheorem1.p1.23.m18.3.4.2.cmml" xref="S4.Thmtheorem1.p1.23.m18.3.4.2">ℓ</ci><list id="S4.Thmtheorem1.p1.23.m18.3.4.3.1.cmml" xref="S4.Thmtheorem1.p1.23.m18.3.4.3.2"><cn type="integer" id="S4.Thmtheorem1.p1.23.m18.1.1.cmml" xref="S4.Thmtheorem1.p1.23.m18.1.1">1</cn><ci id="S4.Thmtheorem1.p1.23.m18.2.2.cmml" xref="S4.Thmtheorem1.p1.23.m18.2.2">…</ci><ci id="S4.Thmtheorem1.p1.23.m18.3.3.cmml" xref="S4.Thmtheorem1.p1.23.m18.3.3">𝐿</ci></list></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem1.p1.23.m18.3c">\ell=1,\ldots,L</annotation></semantics></math> and vectors <math id="S4.Thmtheorem1.p1.24.m19.1" class="ltx_Math" alttext="b^{\ell}" display="inline"><semantics id="S4.Thmtheorem1.p1.24.m19.1a"><msup id="S4.Thmtheorem1.p1.24.m19.1.1" xref="S4.Thmtheorem1.p1.24.m19.1.1.cmml"><mi id="S4.Thmtheorem1.p1.24.m19.1.1.2" xref="S4.Thmtheorem1.p1.24.m19.1.1.2.cmml">b</mi><mi mathvariant="normal" id="S4.Thmtheorem1.p1.24.m19.1.1.3" xref="S4.Thmtheorem1.p1.24.m19.1.1.3.cmml">ℓ</mi></msup><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem1.p1.24.m19.1b"><apply id="S4.Thmtheorem1.p1.24.m19.1.1.cmml" xref="S4.Thmtheorem1.p1.24.m19.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem1.p1.24.m19.1.1.1.cmml" xref="S4.Thmtheorem1.p1.24.m19.1.1">superscript</csymbol><ci id="S4.Thmtheorem1.p1.24.m19.1.1.2.cmml" xref="S4.Thmtheorem1.p1.24.m19.1.1.2">𝑏</ci><ci id="S4.Thmtheorem1.p1.24.m19.1.1.3.cmml" xref="S4.Thmtheorem1.p1.24.m19.1.1.3">ℓ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem1.p1.24.m19.1c">b^{\ell}</annotation></semantics></math>, <math id="S4.Thmtheorem1.p1.25.m20.3" class="ltx_Math" alttext="\ell=1,\ldots,L" display="inline"><semantics id="S4.Thmtheorem1.p1.25.m20.3a"><mrow id="S4.Thmtheorem1.p1.25.m20.3.4" xref="S4.Thmtheorem1.p1.25.m20.3.4.cmml"><mi mathvariant="normal" id="S4.Thmtheorem1.p1.25.m20.3.4.2" xref="S4.Thmtheorem1.p1.25.m20.3.4.2.cmml">ℓ</mi><mo id="S4.Thmtheorem1.p1.25.m20.3.4.1" xref="S4.Thmtheorem1.p1.25.m20.3.4.1.cmml">=</mo><mrow id="S4.Thmtheorem1.p1.25.m20.3.4.3.2" xref="S4.Thmtheorem1.p1.25.m20.3.4.3.1.cmml"><mn id="S4.Thmtheorem1.p1.25.m20.1.1" xref="S4.Thmtheorem1.p1.25.m20.1.1.cmml">1</mn><mo id="S4.Thmtheorem1.p1.25.m20.3.4.3.2.1" xref="S4.Thmtheorem1.p1.25.m20.3.4.3.1.cmml">,</mo><mi mathvariant="normal" id="S4.Thmtheorem1.p1.25.m20.2.2" xref="S4.Thmtheorem1.p1.25.m20.2.2.cmml">…</mi><mo id="S4.Thmtheorem1.p1.25.m20.3.4.3.2.2" xref="S4.Thmtheorem1.p1.25.m20.3.4.3.1.cmml">,</mo><mi id="S4.Thmtheorem1.p1.25.m20.3.3" xref="S4.Thmtheorem1.p1.25.m20.3.3.cmml">L</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem1.p1.25.m20.3b"><apply id="S4.Thmtheorem1.p1.25.m20.3.4.cmml" xref="S4.Thmtheorem1.p1.25.m20.3.4"><eq id="S4.Thmtheorem1.p1.25.m20.3.4.1.cmml" xref="S4.Thmtheorem1.p1.25.m20.3.4.1"></eq><ci id="S4.Thmtheorem1.p1.25.m20.3.4.2.cmml" xref="S4.Thmtheorem1.p1.25.m20.3.4.2">ℓ</ci><list id="S4.Thmtheorem1.p1.25.m20.3.4.3.1.cmml" xref="S4.Thmtheorem1.p1.25.m20.3.4.3.2"><cn type="integer" id="S4.Thmtheorem1.p1.25.m20.1.1.cmml" xref="S4.Thmtheorem1.p1.25.m20.1.1">1</cn><ci id="S4.Thmtheorem1.p1.25.m20.2.2.cmml" xref="S4.Thmtheorem1.p1.25.m20.2.2">…</ci><ci id="S4.Thmtheorem1.p1.25.m20.3.3.cmml" xref="S4.Thmtheorem1.p1.25.m20.3.3">𝐿</ci></list></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem1.p1.25.m20.3c">\ell=1,\ldots,L</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.3" class="ltx_p">Denote by <math id="S4.SS1.p2.1.m1.3" class="ltx_Math" alttext="\mathcal{NN}^{\sigma}_{\infty,d_{0},d_{1}}" display="inline"><semantics id="S4.SS1.p2.1.m1.3a"><mrow id="S4.SS1.p2.1.m1.3.4" xref="S4.SS1.p2.1.m1.3.4.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS1.p2.1.m1.3.4.2" xref="S4.SS1.p2.1.m1.3.4.2.cmml">𝒩</mi><mo lspace="0em" rspace="0em" id="S4.SS1.p2.1.m1.3.4.1" xref="S4.SS1.p2.1.m1.3.4.1.cmml">​</mo><msubsup id="S4.SS1.p2.1.m1.3.4.3" xref="S4.SS1.p2.1.m1.3.4.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS1.p2.1.m1.3.4.3.2.2" xref="S4.SS1.p2.1.m1.3.4.3.2.2.cmml">𝒩</mi><mrow id="S4.SS1.p2.1.m1.3.3.3.3" xref="S4.SS1.p2.1.m1.3.3.3.4.cmml"><mi mathvariant="normal" id="S4.SS1.p2.1.m1.1.1.1.1" xref="S4.SS1.p2.1.m1.1.1.1.1.cmml">∞</mi><mo id="S4.SS1.p2.1.m1.3.3.3.3.3" xref="S4.SS1.p2.1.m1.3.3.3.4.cmml">,</mo><msub id="S4.SS1.p2.1.m1.2.2.2.2.1" xref="S4.SS1.p2.1.m1.2.2.2.2.1.cmml"><mi id="S4.SS1.p2.1.m1.2.2.2.2.1.2" xref="S4.SS1.p2.1.m1.2.2.2.2.1.2.cmml">d</mi><mn id="S4.SS1.p2.1.m1.2.2.2.2.1.3" xref="S4.SS1.p2.1.m1.2.2.2.2.1.3.cmml">0</mn></msub><mo id="S4.SS1.p2.1.m1.3.3.3.3.4" xref="S4.SS1.p2.1.m1.3.3.3.4.cmml">,</mo><msub id="S4.SS1.p2.1.m1.3.3.3.3.2" xref="S4.SS1.p2.1.m1.3.3.3.3.2.cmml"><mi id="S4.SS1.p2.1.m1.3.3.3.3.2.2" xref="S4.SS1.p2.1.m1.3.3.3.3.2.2.cmml">d</mi><mn id="S4.SS1.p2.1.m1.3.3.3.3.2.3" xref="S4.SS1.p2.1.m1.3.3.3.3.2.3.cmml">1</mn></msub></mrow><mi id="S4.SS1.p2.1.m1.3.4.3.2.3" xref="S4.SS1.p2.1.m1.3.4.3.2.3.cmml">σ</mi></msubsup></mrow><annotation-xml encoding="MathML-Content" id="S4.SS1.p2.1.m1.3b"><apply id="S4.SS1.p2.1.m1.3.4.cmml" xref="S4.SS1.p2.1.m1.3.4"><times id="S4.SS1.p2.1.m1.3.4.1.cmml" xref="S4.SS1.p2.1.m1.3.4.1"></times><ci id="S4.SS1.p2.1.m1.3.4.2.cmml" xref="S4.SS1.p2.1.m1.3.4.2">𝒩</ci><apply id="S4.SS1.p2.1.m1.3.4.3.cmml" xref="S4.SS1.p2.1.m1.3.4.3"><csymbol cd="ambiguous" id="S4.SS1.p2.1.m1.3.4.3.1.cmml" xref="S4.SS1.p2.1.m1.3.4.3">subscript</csymbol><apply id="S4.SS1.p2.1.m1.3.4.3.2.cmml" xref="S4.SS1.p2.1.m1.3.4.3"><csymbol cd="ambiguous" id="S4.SS1.p2.1.m1.3.4.3.2.1.cmml" xref="S4.SS1.p2.1.m1.3.4.3">superscript</csymbol><ci id="S4.SS1.p2.1.m1.3.4.3.2.2.cmml" xref="S4.SS1.p2.1.m1.3.4.3.2.2">𝒩</ci><ci id="S4.SS1.p2.1.m1.3.4.3.2.3.cmml" xref="S4.SS1.p2.1.m1.3.4.3.2.3">𝜎</ci></apply><list id="S4.SS1.p2.1.m1.3.3.3.4.cmml" xref="S4.SS1.p2.1.m1.3.3.3.3"><infinity id="S4.SS1.p2.1.m1.1.1.1.1.cmml" xref="S4.SS1.p2.1.m1.1.1.1.1"></infinity><apply id="S4.SS1.p2.1.m1.2.2.2.2.1.cmml" xref="S4.SS1.p2.1.m1.2.2.2.2.1"><csymbol cd="ambiguous" id="S4.SS1.p2.1.m1.2.2.2.2.1.1.cmml" xref="S4.SS1.p2.1.m1.2.2.2.2.1">subscript</csymbol><ci id="S4.SS1.p2.1.m1.2.2.2.2.1.2.cmml" xref="S4.SS1.p2.1.m1.2.2.2.2.1.2">𝑑</ci><cn type="integer" id="S4.SS1.p2.1.m1.2.2.2.2.1.3.cmml" xref="S4.SS1.p2.1.m1.2.2.2.2.1.3">0</cn></apply><apply id="S4.SS1.p2.1.m1.3.3.3.3.2.cmml" xref="S4.SS1.p2.1.m1.3.3.3.3.2"><csymbol cd="ambiguous" id="S4.SS1.p2.1.m1.3.3.3.3.2.1.cmml" xref="S4.SS1.p2.1.m1.3.3.3.3.2">subscript</csymbol><ci id="S4.SS1.p2.1.m1.3.3.3.3.2.2.cmml" xref="S4.SS1.p2.1.m1.3.3.3.3.2.2">𝑑</ci><cn type="integer" id="S4.SS1.p2.1.m1.3.3.3.3.2.3.cmml" xref="S4.SS1.p2.1.m1.3.3.3.3.2.3">1</cn></apply></list></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p2.1.m1.3c">\mathcal{NN}^{\sigma}_{\infty,d_{0},d_{1}}</annotation></semantics></math> the set of neural networks
mapping from <math id="S4.SS1.p2.2.m2.1" class="ltx_Math" alttext="\mathbb{R}^{d_{0}}\to\mathbb{R}^{d_{1}}" display="inline"><semantics id="S4.SS1.p2.2.m2.1a"><mrow id="S4.SS1.p2.2.m2.1.1" xref="S4.SS1.p2.2.m2.1.1.cmml"><msup id="S4.SS1.p2.2.m2.1.1.2" xref="S4.SS1.p2.2.m2.1.1.2.cmml"><mi id="S4.SS1.p2.2.m2.1.1.2.2" xref="S4.SS1.p2.2.m2.1.1.2.2.cmml">ℝ</mi><msub id="S4.SS1.p2.2.m2.1.1.2.3" xref="S4.SS1.p2.2.m2.1.1.2.3.cmml"><mi id="S4.SS1.p2.2.m2.1.1.2.3.2" xref="S4.SS1.p2.2.m2.1.1.2.3.2.cmml">d</mi><mn id="S4.SS1.p2.2.m2.1.1.2.3.3" xref="S4.SS1.p2.2.m2.1.1.2.3.3.cmml">0</mn></msub></msup><mo stretchy="false" id="S4.SS1.p2.2.m2.1.1.1" xref="S4.SS1.p2.2.m2.1.1.1.cmml">→</mo><msup id="S4.SS1.p2.2.m2.1.1.3" xref="S4.SS1.p2.2.m2.1.1.3.cmml"><mi id="S4.SS1.p2.2.m2.1.1.3.2" xref="S4.SS1.p2.2.m2.1.1.3.2.cmml">ℝ</mi><msub id="S4.SS1.p2.2.m2.1.1.3.3" xref="S4.SS1.p2.2.m2.1.1.3.3.cmml"><mi id="S4.SS1.p2.2.m2.1.1.3.3.2" xref="S4.SS1.p2.2.m2.1.1.3.3.2.cmml">d</mi><mn id="S4.SS1.p2.2.m2.1.1.3.3.3" xref="S4.SS1.p2.2.m2.1.1.3.3.3.cmml">1</mn></msub></msup></mrow><annotation-xml encoding="MathML-Content" id="S4.SS1.p2.2.m2.1b"><apply id="S4.SS1.p2.2.m2.1.1.cmml" xref="S4.SS1.p2.2.m2.1.1"><ci id="S4.SS1.p2.2.m2.1.1.1.cmml" xref="S4.SS1.p2.2.m2.1.1.1">→</ci><apply id="S4.SS1.p2.2.m2.1.1.2.cmml" xref="S4.SS1.p2.2.m2.1.1.2"><csymbol cd="ambiguous" id="S4.SS1.p2.2.m2.1.1.2.1.cmml" xref="S4.SS1.p2.2.m2.1.1.2">superscript</csymbol><ci id="S4.SS1.p2.2.m2.1.1.2.2.cmml" xref="S4.SS1.p2.2.m2.1.1.2.2">ℝ</ci><apply id="S4.SS1.p2.2.m2.1.1.2.3.cmml" xref="S4.SS1.p2.2.m2.1.1.2.3"><csymbol cd="ambiguous" id="S4.SS1.p2.2.m2.1.1.2.3.1.cmml" xref="S4.SS1.p2.2.m2.1.1.2.3">subscript</csymbol><ci id="S4.SS1.p2.2.m2.1.1.2.3.2.cmml" xref="S4.SS1.p2.2.m2.1.1.2.3.2">𝑑</ci><cn type="integer" id="S4.SS1.p2.2.m2.1.1.2.3.3.cmml" xref="S4.SS1.p2.2.m2.1.1.2.3.3">0</cn></apply></apply><apply id="S4.SS1.p2.2.m2.1.1.3.cmml" xref="S4.SS1.p2.2.m2.1.1.3"><csymbol cd="ambiguous" id="S4.SS1.p2.2.m2.1.1.3.1.cmml" xref="S4.SS1.p2.2.m2.1.1.3">superscript</csymbol><ci id="S4.SS1.p2.2.m2.1.1.3.2.cmml" xref="S4.SS1.p2.2.m2.1.1.3.2">ℝ</ci><apply id="S4.SS1.p2.2.m2.1.1.3.3.cmml" xref="S4.SS1.p2.2.m2.1.1.3.3"><csymbol cd="ambiguous" id="S4.SS1.p2.2.m2.1.1.3.3.1.cmml" xref="S4.SS1.p2.2.m2.1.1.3.3">subscript</csymbol><ci id="S4.SS1.p2.2.m2.1.1.3.3.2.cmml" xref="S4.SS1.p2.2.m2.1.1.3.3.2">𝑑</ci><cn type="integer" id="S4.SS1.p2.2.m2.1.1.3.3.3.cmml" xref="S4.SS1.p2.2.m2.1.1.3.3.3">1</cn></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p2.2.m2.1c">\mathbb{R}^{d_{0}}\to\mathbb{R}^{d_{1}}</annotation></semantics></math> and with activation function
<math id="S4.SS1.p2.3.m3.1" class="ltx_Math" alttext="\sigma" display="inline"><semantics id="S4.SS1.p2.3.m3.1a"><mi id="S4.SS1.p2.3.m3.1.1" xref="S4.SS1.p2.3.m3.1.1.cmml">σ</mi><annotation-xml encoding="MathML-Content" id="S4.SS1.p2.3.m3.1b"><ci id="S4.SS1.p2.3.m3.1.1.cmml" xref="S4.SS1.p2.3.m3.1.1">𝜎</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS1.p2.3.m3.1c">\sigma</annotation></semantics></math>. The next result (<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">Hor91</a>, Theorems 1 and 2]</cite>)
illustrates that neural networks approximate multivariate functions
arbitrarily well.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.1.1.1" class="ltx_text ltx_font_bold">Theorem 4.2</span></span><span id="S4.Thmtheorem2.2.2" class="ltx_text ltx_font_bold"> </span>(Universal approximation, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">Hor91</a>]</cite>)<span id="S4.Thmtheorem2.3.3" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
