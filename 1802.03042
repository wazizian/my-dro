<math id="S4.SS2.3.p2.6.m6.2" class="ltx_Math" alttext="\pi^{M}(X)\leq\pi(X)+\varepsilon" display="inline"><semantics id="S4.SS2.3.p2.6.m6.2a"><mrow id="S4.SS2.3.p2.6.m6.2.3" xref="S4.SS2.3.p2.6.m6.2.3.cmml"><mrow id="S4.SS2.3.p2.6.m6.2.3.2" xref="S4.SS2.3.p2.6.m6.2.3.2.cmml"><msup id="S4.SS2.3.p2.6.m6.2.3.2.2" xref="S4.SS2.3.p2.6.m6.2.3.2.2.cmml"><mi id="S4.SS2.3.p2.6.m6.2.3.2.2.2" xref="S4.SS2.3.p2.6.m6.2.3.2.2.2.cmml">π</mi><mi id="S4.SS2.3.p2.6.m6.2.3.2.2.3" xref="S4.SS2.3.p2.6.m6.2.3.2.2.3.cmml">M</mi></msup><mo lspace="0em" rspace="0em" id="S4.SS2.3.p2.6.m6.2.3.2.1" xref="S4.SS2.3.p2.6.m6.2.3.2.1.cmml">​</mo><mrow id="S4.SS2.3.p2.6.m6.2.3.2.3.2" xref="S4.SS2.3.p2.6.m6.2.3.2.cmml"><mo stretchy="false" id="S4.SS2.3.p2.6.m6.2.3.2.3.2.1" xref="S4.SS2.3.p2.6.m6.2.3.2.cmml">(</mo><mi id="S4.SS2.3.p2.6.m6.1.1" xref="S4.SS2.3.p2.6.m6.1.1.cmml">X</mi><mo stretchy="false" id="S4.SS2.3.p2.6.m6.2.3.2.3.2.2" xref="S4.SS2.3.p2.6.m6.2.3.2.cmml">)</mo></mrow></mrow><mo id="S4.SS2.3.p2.6.m6.2.3.1" xref="S4.SS2.3.p2.6.m6.2.3.1.cmml">≤</mo><mrow id="S4.SS2.3.p2.6.m6.2.3.3" xref="S4.SS2.3.p2.6.m6.2.3.3.cmml"><mrow id="S4.SS2.3.p2.6.m6.2.3.3.2" xref="S4.SS2.3.p2.6.m6.2.3.3.2.cmml"><mi id="S4.SS2.3.p2.6.m6.2.3.3.2.2" xref="S4.SS2.3.p2.6.m6.2.3.3.2.2.cmml">π</mi><mo lspace="0em" rspace="0em" id="S4.SS2.3.p2.6.m6.2.3.3.2.1" xref="S4.SS2.3.p2.6.m6.2.3.3.2.1.cmml">​</mo><mrow id="S4.SS2.3.p2.6.m6.2.3.3.2.3.2" xref="S4.SS2.3.p2.6.m6.2.3.3.2.cmml"><mo stretchy="false" id="S4.SS2.3.p2.6.m6.2.3.3.2.3.2.1" xref="S4.SS2.3.p2.6.m6.2.3.3.2.cmml">(</mo><mi id="S4.SS2.3.p2.6.m6.2.2" xref="S4.SS2.3.p2.6.m6.2.2.cmml">X</mi><mo stretchy="false" id="S4.SS2.3.p2.6.m6.2.3.3.2.3.2.2" xref="S4.SS2.3.p2.6.m6.2.3.3.2.cmml">)</mo></mrow></mrow><mo id="S4.SS2.3.p2.6.m6.2.3.3.1" xref="S4.SS2.3.p2.6.m6.2.3.3.1.cmml">+</mo><mi id="S4.SS2.3.p2.6.m6.2.3.3.3" xref="S4.SS2.3.p2.6.m6.2.3.3.3.cmml">ε</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.3.p2.6.m6.2b"><apply id="S4.SS2.3.p2.6.m6.2.3.