<p id="S3.Thmtheorem9.p1.4" class="ltx_p">Let <math id="S3.Thmtheorem9.p1.1.m1.2" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline"><semantics id="S3.Thmtheorem9.p1.1.m1.2a"><mrow id="S3.Thmtheorem9.p1.1.m1.2.3" xref="S3.Thmtheorem9.p1.1.m1.2.3.cmml"><mi id="S3.Thmtheorem9.p1.1.m1.2.3.2" xref="S3.Thmtheorem9.p1.1.m1.2.3.2.cmml">α</mi><mo id="S3.Thmtheorem9.p1.1.m1.2.3.1" xref="S3.Thmtheorem9.p1.1.m1.2.3.1.cmml">∈</mo><mrow id="S3.Thmtheorem9.p1.1.m1.2.3.3.2" xref="S3.Thmtheorem9.p1.1.m1.2.3.3.1.cmml"><mo stretchy="false" id="S3.Thmtheorem9.p1.1.m1.2.3.3.2.1" xref="S3.Thmtheorem9.p1.1.m1.2.3.3.1.cmml">(</mo><mn id="S3.Thmtheorem9.p1.1.m1.1.1" xref="S3.Thmtheorem9.p1.1.m1.1.1.cmml">0</mn><mo id="S3.Thmtheorem9.p1.1.m1.2.3.3.2.2" xref="S3.Thmtheorem9.p1.1.m1.2.3.3.1.cmml">,</mo><mn id="S3.Thmtheorem9.p1.1.m1.2.2" xref="S3.Thmtheorem9.p1.1.m1.2.2.cmml">1</mn><mo stretchy="false" id="S3.Thmtheorem9.p1.1.m1.2.3.3.2.3" xref="S3.Thmtheorem9.p1.1.m1.2.3.3.1.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem9.p1.1.m1.2b"><apply id="S3.Thmtheorem9.p1.1.m1.2.3.cmml" xref="S3.Thmtheorem9.p1.1.m1.2.3"><in id="S3.Thmtheorem9.p1.1.m1.2.3.1.cmml" xref="S3.Thmtheorem9.p1.1.m1.2.3.1"></in><ci id="S3.Thmtheorem9.p1.1.m1.2.3.2.cmml" xref="S3.Thmtheorem9.p1.1.m1.2.3.2">𝛼</ci><interval closure="open" id="S3.Thmtheorem9.p1.1.m1.2.3.3.1.cmml" xref="S3.Thmtheorem9.p1.1.m1.2.3.3.2"><cn type="integer" id="S3.Thmtheorem9.p1.1.m1.1.1.cmml" xref="S3.Thmtheorem9.p1.1.m1.1.1">0</cn><cn type="integer" id="S3.Thmtheorem9.p1.1.m1.2.2.cmml" xref="S3.Thmtheorem9.p1.1.m1.2.2">1</cn></interval></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem9.p1.1.m1.2c">\alpha\in(0,1)</annotation></semantics></math> and set
<math id="S3.Thmtheorem9.p1.2.m2.4" class="ltx_Math" alttext="\ell(x):=\frac{1}{1-\alpha}\max(x,0)" display="inline"><semantics id="S3.Thmtheorem9.p1.2.m2.4a"><mrow id="S3.Thmtheorem9.p1.2.m2.4.5" xref="S3.Thmtheorem9.p1.2.m2.4.5.cmml"><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.cmml"><mi mathvariant="normal" id="S3.Thmtheorem9.p1.2.m2.4.5.2.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.2.cmml">ℓ</mi><mo lspace="0em" rspace="0em" id="S3.Thmtheorem9.p1.2.m2.4.5.2.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.1.cmml">​</mo><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.2.3.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.cmml"><mo stretchy="false" id="S3.Thmtheorem9.p1.2.m2.4.5.2.3.2.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.cmml">(</mo><mi id="S3.Thmtheorem9.p1.2.m2.1.1" xref="S3.Thmtheorem9.p1.2.m2.1.1.cmml">x</mi><mo rspace="0.278em" stretchy="false" id="S3.Thmtheorem9.p1.2.m2.4.5.2.3.2.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.cmml">)</mo></mrow></mrow><mo rspace="0.278em" id="S3.Thmtheorem9.p1.2.m2.4.5.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.1.cmml">:=</mo><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.3" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.cmml"><mfrac id="S3.Thmtheorem9.p1.2.m2.4.5.3.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.cmml"><mn id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.2.cmml">1</mn><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.cmml"><mn id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.2.cmml">1</mn><mo id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.1.cmml">−</mo><mi id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.3" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.3.cmml">α</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em" id="S3.Thmtheorem9.p1.2.m2.4.5.3.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.1.cmml">​</mo><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml"><mi id="S3.Thmtheorem9.p1.2.m2.2.2" xref="S3.Thmtheorem9.p1.2.m2.2.2.cmml">max</mi><mo id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2a" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml">⁡</mo><mrow id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml"><mo stretchy="false" id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2.1.1" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml">(</mo><mi id="S3.Thmtheorem9.p1.2.m2.3.3" xref="S3.Thmtheorem9.p1.2.m2.3.3.cmml">x</mi><mo id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2.1.2" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml">,</mo><mn id="S3.Thmtheorem9.p1.2.m2.4.4" xref="S3.Thmtheorem9.p1.2.m2.4.4.cmml">0</mn><mo stretchy="false" id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2.1.3" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml">)</mo></mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem9.p1.2.m2.4b"><apply id="S3.Thmtheorem9.p1.2.m2.4.5.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5"><csymbol cd="latexml" id="S3.Thmtheorem9.p1.2.m2.4.5.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.1">assign</csymbol><apply id="S3.Thmtheorem9.p1.2.m2.4.5.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.2"><times id="S3.Thmtheorem9.p1.2.m2.4.5.2.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.1"></times><ci id="S3.Thmtheorem9.p1.2.m2.4.5.2.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.2.2">ℓ</ci><ci id="S3.Thmtheorem9.p1.2.m2.1.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.1.1">𝑥</ci></apply><apply id="S3.Thmtheorem9.p1.2.m2.4.5.3.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3"><times id="S3.Thmtheorem9.p1.2.m2.4.5.3.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.1"></times><apply id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2"><divide id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2"></divide><cn type="integer" id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.2">1</cn><apply id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3"><minus id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.1"></minus><cn type="integer" id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.2">1</cn><ci id="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.3.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.2.3.3">𝛼</ci></apply></apply><apply id="S3.Thmtheorem9.p1.2.m2.4.5.3.3.1.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.5.3.3.2"><max id="S3.Thmtheorem9.p1.2.m2.2.2.cmml" xref="S3.Thmtheorem9.p1.2.m2.2.2"></max><ci id="S3.Thmtheorem9.p1.2.m2.3.3.cmml" xref="S3.Thmtheorem9.p1.2.m2.3.3">𝑥</ci><cn type="integer" id="S3.Thmtheorem9.p1.2.m2.4.4.cmml" xref="S3.Thmtheorem9.p1.2.m2.4.4">0</cn></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem9.p1.2.m2.4c">\ell(x):=\frac{1}{1-\alpha}\max(x,0)</annotation></semantics></math>. The associated risk measure
(<a href="#S3.E5" title="In 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>) is called <span id="S3.Thmtheorem9.p1.4.1" class="ltx_text ltx_font_italic">average value at risk at level</span>
<math id="S3.Thmtheorem9.p1.3.m3.1" class="ltx_Math" alttext="1-\alpha" display="inline"><semantics id="S3.Thmtheorem9.p1.3.m3.1a"><mrow id="S3.Thmtheorem9.p1.3.m3.1.1" xref="S3.Thmtheorem9.p1.3.m3.1.1.cmml"><mn id="S3.Thmtheorem9.p1.3.m3.1.1.2" xref="S3.Thmtheorem9.p1.3.m3.1.1.2.cmml">1</mn><mo id="S3.Thmtheorem9.p1.3.m3.1.1.1" xref="S3.Thmtheorem9.p1.3.m3.1.1.1.cmml">−</mo><mi id="S3.Thmtheorem9.p1.3.m3.1.1.3" xref="S3.Thmtheorem9.p1.3.m3.1.1.3.cmml">α</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem9.p1.3.m3.1b"><apply id="S3.Thmtheorem9.p1.3.m3.1.1.cmml" xref="S3.Thmtheorem9.p1.3.m3.1.1"><minus id="S3.Thmtheorem9.p1.3.m3.1.1.1.cmml" xref="S3.Thmtheorem9.p1.3.m3.1.1.1"></minus><cn type="integer" id="S3.Thmtheorem9.p1.3.m3.1.1.2.cmml" xref="S3.Thmtheorem9.p1.3.m3.1.1.2">1</cn><ci id="S3.Thmtheorem9.p1.3.m3.1.1.3.cmml" xref="S3.Thmtheorem9.p1.3.m3.1.1.3">𝛼</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem9.p1.3.m3.1c">1-\alpha</annotation></semantics></math> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">FS16</a>, Definition 4.48,
Proposition 4.51]</cite> with <math id="S3.Thmtheorem9.p1.4.m4.1" class="ltx_Math" alttext="\lambda:=1-\alpha" display="inline"><semantics id="S3.Thmtheorem9.p1.4.m4.1a"><mrow id="S3.Thmtheorem9.p1.4.m4.1.1" xref="S3.Thmtheorem9.p1.4.m4.1.1.cmml"><mi id="S3.Thmtheorem9.p1.4.m4.1.1.2" xref="S3.Thmtheorem9.p1.4.m4.1.1.2.cmml">λ</mi><mo lspace="0.278em" rspace="0.278em" id="S3.Thmtheorem9.p1.4.m4.1.1.1" xref="S3.Thmtheorem9.p1.4.m4.1.1.1.cmml">:=</mo><mrow id="S3.Thmtheorem9.p1.4.m4.1.1.3" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.cmml"><mn id="S3.Thmtheorem9.p1.4.m4.1.1.3.2" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.2.cmml">1</mn><mo id="S3.Thmtheorem9.p1.4.m4.1.1.3.1" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.1.cmml">−</mo><mi id="S3.Thmtheorem9.p1.4.m4.1.1.3.3" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.3.cmml">α</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem9.p1.4.m4.1b"><apply id="S3.Thmtheorem9.p1.4.m4.1.1.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1"><csymbol cd="latexml" id="S3.Thmtheorem9.p1.4.m4.1.1.1.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.1">assign</csymbol><ci id="S3.Thmtheorem9.p1.4.m4.1.1.2.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.2">𝜆</ci><apply id="S3.Thmtheorem9.p1.4.m4.1.1.3.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.3"><minus id="S3.Thmtheorem9.p1.4.m4.1.1.3.1.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.1"></minus><cn type="integer" id="S3.Thmtheorem9.p1.4.m4.1.1.3.2.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.2">1</cn><ci id="S3.Thmtheorem9.p1.4.m4.1.1.3.3.cmml" xref="S3.Thmtheorem9.p1.4.m4.1.1.3.3">𝛼</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem9.p1.4.m4.1c">\lambda:=1-\alpha</annotation></semantics></math>) or also
<span id="S3.Thmtheorem9.p1.4.2" class="ltx_text ltx_font_italic">conditional value at risk</span> or <span id="S3.Thmtheorem9.p1.4.3" class="ltx_text ltx_font_italic">expected shortfall</span>.</p>
</div>
</div>
<div id="S3.Thmtheorem10" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem10.1.1.1" class="ltx_text ltx_font_bold">Proposition 3.10</span></span><span id="S3.Thmtheorem10.2.2" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S3.Thmtheorem10.p1" class="ltx_para">
<p id="S3.Thmtheorem10.p1.5" class="ltx_p"><span id="S3.Thmtheorem10.p1.5.5" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmtheorem10.p1.1.1.m1.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S3.Thmtheorem10.p1.1.1.m1.1a"><mi id="S3.Thmtheorem10.p1.1.1.m1.1.1" xref="S3.Thmtheorem10.p1.1.1.m1.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem10.p1.1.1.m1.1b"><ci id="S3.Thmtheorem10.p1.1.1.m1.1.1.cmml" xref="S3.Thmtheorem10.p1.1.1.m1.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem10.p1.1.1.m1.1c">S</annotation></semantics></math> is a
<math id="S3.Thmtheorem10.p1.2.2.m2.1" class="ltx_Math" alttext="\mathbb{P}" display="inline"><semantics id="S3.Thmtheorem10.p1.2.2.m2.1a"><mi id="S3.Thmtheorem10.p1.2.2.m2.1.1" xref="S3.Thmtheorem10.p1.2.2.m2.1.1.cmml">ℙ</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem10.p1.2.2.m2.1b"><ci id="S3.Thmtheorem10.p1.2.2.m2.1.1.cmml" xref="S3.Thmtheorem10.p1.2.2.m2.1.1">ℙ</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem10.p1.2.2.m2.1c">\mathbb{P}</annotation></semantics></math>-martingale, <math id="S3.Thmtheorem10.p1.3.3.m3.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S3.Thmtheorem10.p1.3.3.m3.1a"><mi id="S3.Thmtheorem10.p1.3.3.m3.1.1" xref="S3.Thmtheorem10.p1.3.3.m3.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem10.p1.3.3.m3.1b"><ci id="S3.Thmtheorem10.p1.3.3.m3.1.1.cmml" xref="S3.Thmtheorem10.p1.3.3.m3.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem10.p1.3.3.m3.1c">\rho</annotation></semantics></math> is defined as in (<a href="#S3.E5" title="In 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>) and <math id="S3.Thmtheorem10.p1.4.4.m4.1" class="ltx_Math" alttext="\pi" display="inline"><semantics id="S3.Thmtheorem10.p1.4.4.m4.1a"><mi id="S3.Thmtheorem10.p1.4.4.m4.1.1" xref="S3.Thmtheorem10.p1.4.4.m4.1.1.cmml">π</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem10.p1.4.4.m4.1b"><ci id="S3.Thmtheorem10.p1.4.4.m4.1.1.cmml" xref="S3.Thmtheorem10.p1.4.4.m4.1.1">𝜋</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem10.p1.4.4.m4.1c">\pi</annotation></semantics></math>,
<math id="S3.Thmtheorem10.p1.5.5.m5.1" class="ltx_Math" alttext="p" display="inline"><semantics id="S3.Thmtheorem10.p1.5.5.m5.1a"><mi id="S3.Thmtheorem10.p1.5.5.m5.1.1" xref="S3.Thmtheorem10.p1.5.5.m5.1.1.cmml">p</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem10.p1.5.5.m5.1b"><ci id="S3.Thmtheorem10.p1.5.5.m5.1.1.cmml" xref="S3.Thmtheorem10.p1.5.5.m5.1.1">𝑝</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem10.p1.5.5.m5.1c">p</annotation></semantics></math> as in (<a href="#S3.E1" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), (<a href="#S3.E2" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>). Then</span></p>
<ul id="S3.I3" class="ltx_itemize">
<li id="S3.I3.ix1" class="ltx_item" style="list-style-type:none;">
