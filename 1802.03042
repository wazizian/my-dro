</tr></tbody>
</table>
<p id="S3.SS2.2.p1.9" class="ltx_p">By first applying Jensen’s inequality
(recall that <math id="S3.SS2.2.p1.6.m1.1" class="ltx_Math" alttext="\ell" display="inline"><semantics id="S3.SS2.2.p1.6.m1.1a"><mi mathvariant="normal" id="S3.SS2.2.p1.6.m1.1.1" xref="S3.SS2.2.p1.6.m1.1.1.cmml">ℓ</mi><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.6.m1.1b"><ci id="S3.SS2.2.p1.6.m1.1.1.cmml" xref="S3.SS2.2.p1.6.m1.1.1">ℓ</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.6.m1.1c">\ell</annotation></semantics></math> is convex) and then using (<a href="#S3.E6" title="In Proof. ‣ 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>),
that <math id="S3.SS2.2.p1.7.m2.1" class="ltx_Math" alttext="C_{T}(\delta)\geq 0" display="inline"><semantics id="S3.SS2.2.p1.7.m2.1a"><mrow id="S3.SS2.2.p1.7.m2.1.2" xref="S3.SS2.2.p1.7.m2.1.2.cmml"><mrow id="S3.SS2.2.p1.7.m2.1.2.2" xref="S3.SS2.2.p1.7.m2.1.2.2.cmml"><msub id="S3.SS2.2.p1.7.m2.1.2.2.2" xref="S3.SS2.2.p1.7.m2.1.2.2.2.cmml"><mi id="S3.SS2.2.p1.7.m2.1.2.2.2.2" xref="S3.SS2.2.p1.7.m2.1.2.2.2.2.cmml">C</mi><mi id="S3.SS2.2.p1.7.m2.1.2.2.2.3" xref="S3.SS2.2.p1.7.m2.1.2.2.2.3.cmml">T</mi></msub><mo lspace="0em" rspace="0em" id="S3.SS2.2.p1.7.m2.1.2.2.1" xref="S3.SS2.2.p1.7.m2.1.2.2.1.cmml">​</mo><mrow id="S3.SS2.2.p1.7.m2.1.2.2.3.2" xref="S3.SS2.2.p1.7.m2.1.2.2.cmml"><mo stretchy="false" id="S3.SS2.2.p1.7.m2.1.2.2.3.2.1" xref="S3.SS2.2.p1.7.m2.1.2.2.cmml">(</mo><mi id="S3.SS2.2.p1.7.m2.1.1" xref="S3.SS2.2.p1.7.m2.1.1.cmml">δ</mi><mo stretchy="false" id="S3.SS2.2.p1.7.m2.1.2.2.3.2.2" xref="S3.SS2.2.p1.7.m2.1.2.2.cmml">)</mo></mrow></mrow><mo id="S3.SS2.2.p1.7.m2.1.2.1" xref="S3.SS2.2.p1.7.m2.1.2.1.cmml">≥</mo><mn id="S3.SS2.2.p1.7.m2.1.2.3" xref="S3.SS2.2.p1.7.m2.1.2.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.7.m2.1b"><apply id="S3.SS2.2.p1.7.m2.1.2.cmml" xref="S3.SS2.2.p1.7.m2.1.2"><geq id="S3.SS2.2.p1.7.m2.1.2.1.cmml" xref="S3.SS2.2.p1.7.m2.1.2.1"></geq><apply id="S3.SS2.2.p1.7.m2.1.2.2.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2"><times id="S3.SS2.2.p1.7.m2.1.2.2.1.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2.1"></times><apply id="S3.SS2.2.p1.7.m2.1.2.2.2.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2.2"><csymbol cd="ambiguous" id="S3.SS2.2.p1.7.m2.1.2.2.2.1.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2.2">subscript</csymbol><ci id="S3.SS2.2.p1.7.m2.1.2.2.2.2.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2.2.2">𝐶</ci><ci id="S3.SS2.2.p1.7.m2.1.2.2.2.3.cmml" xref="S3.SS2.2.p1.7.m2.1.2.2.2.3">𝑇</ci></apply><ci id="S3.SS2.2.p1.7.m2.1.1.cmml" xref="S3.SS2.2.p1.7.m2.1.1">𝛿</ci></apply><cn type="integer" id="S3.SS2.2.p1.7.m2.1.2.3.cmml" xref="S3.SS2.2.p1.7.m2.1.2.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.7.m2.1c">C_{T}(\delta)\geq 0</annotation></semantics></math> for any <math id="S3.SS2.2.p1.8.m3.1" class="ltx_Math" alttext="\delta\in\mathcal{H}" display="inline"><semantics id="S3.SS2.2.p1.8.m3.1a"><mrow id="S3.SS2.2.p1.8.m3.1.1" xref="S3.SS2.2.p1.8.m3.1.1.cmml"><mi id="S3.SS2.2.p1.8.m3.1.1.2" xref="S3.SS2.2.p1.8.m3.1.1.2.cmml">δ</mi><mo id="S3.SS2.2.p1.8.m3.1.1.1" xref="S3.SS2.2.p1.8.m3.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S3.SS2.2.p1.8.m3.1.1.3" xref="S3.SS2.2.p1.8.m3.1.1.3.cmml">ℋ</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.8.m3.1b"><apply id="S3.SS2.2.p1.8.m3.1.1.cmml" xref="S3.SS2.2.p1.8.m3.1.1"><in id="S3.SS2.2.p1.8.m3.1.1.1.cmml" xref="S3.SS2.2.p1.8.m3.1.1.1"></in><ci id="S3.SS2.2.p1.8.m3.1.1.2.cmml" xref="S3.SS2.2.p1.8.m3.1.1.2">𝛿</ci><ci id="S3.SS2.2.p1.8.m3.1.1.3.cmml" xref="S3.SS2.2.p1.8.m3.1.1.3">ℋ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.8.m3.1c">\delta\in\mathcal{H}</annotation></semantics></math> and that <math id="S3.SS2.2.p1.9.m4.1" class="ltx_Math" alttext="\ell" display="inline"><semantics id="S3.SS2.2.p1.9.m4.1a"><mi mathvariant="normal" id="S3.SS2.2.p1.9.m4.1.1" xref="S3.SS2.2.p1.9.m4.1.1.cmml">ℓ</mi><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.9.m4.1b"><ci id="S3.SS2.2.p1.9.m4.1.1.cmml" xref="S3.SS2.2.p1.9.m4.1.1">ℓ</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.9.m4.1c">\ell</annotation></semantics></math> is
non-decreasing, one obtains</p>
