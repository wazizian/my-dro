<math id="S5.SS2.SSSx3.p2.9.m9.1" class="ltx_Math" alttext="p(Z)" display="inline"><semantics id="S5.SS2.SSSx3.p2.9.m9.1a"><mrow id="S5.SS2.SSSx3.p2.9.m9.1.2" xref="S5.SS2.SSSx3.p2.9.m9.1.2.cmml"><mi id="S5.SS2.SSSx3.p2.9.m9.1.2.2" xref="S5.SS2.SSSx3.p2.9.m9.1.2.2.cmml">p</mi><mo lspace="0em" rspace="0em" id="S5.SS2.SSSx3.p2.9.m9.1.2.1" xref="S5.SS2.SSSx3.p2.9.m9.1.2.1.cmml">​</mo><mrow id="S5.SS2.SSSx3.p2.9.m9.1.2.3.2" xref="S5.SS2.SSSx3.p2.9.m9.1.2.cmml"><mo stretchy="false" id="S5.SS2.SSSx3.p2.9.m9.1.2.3.2.1" xref="S5.SS2.SSSx3.p2.9.m9.1.2.cmml">(</mo><mi id="S5.SS2.SSSx3.p2.9.m9.1.1" xref="S5.SS2.SSSx3.p2.9.m9.1.1.cmml">Z</mi><mo stretchy="false" id="S5.SS2.SSSx3.p2.9.m9.1.2.3.2.2" xref="S5.SS2.SSSx3.p2.9.m9.1.2.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.9.m9.1b"><apply id="S5.SS2.SSSx3.p2.9.m9.1.2.cmml" xref="S5.SS2.SSSx3.p2.9.m9.1.2"><times id="S5.SS2.SSSx3.p2.9.m9.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.9.m9.1.2.1"></times><ci id="S5.SS2.SSSx3.p2.9.m9.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.9.m9.1.2.2">𝑝</ci><ci id="S5.SS2.SSSx3.p2.9.m9.1.1.cmml" xref="S5.SS2.SSSx3.p2.9.m9.1.1">𝑍</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.9.m9.1c">p(Z)</annotation></semantics></math>. As an out-of-sample test, one can then simulate another set
of sample trajectories (here <math id="S5.SS2.SSSx3.p2.10.m10.1" class="ltx_Math" alttext="10^{6}" display="inline"><semantics id="S5.SS2.SSSx3.p2.10.m10.1a"><msup id="S5.SS2.SSSx3.p2.10.m10.1.1" xref="S5.SS2.SSSx3.p2.10.m10.1.1.cmml"><mn id="S5.SS2.SSSx3.p2.10.m10.1.1.2" xref="S5.SS2.SSSx3.p2.10.m10.1.1.2.cmml">10</mn><mn id="S5.SS2.SSSx3.p2.10.m10.1.1.3" xref="S5.SS2.SSSx3.p2.10.m10.1.1.3.cmml">6</mn></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.10.m10.1b"><apply id="S5.SS2.SSSx3.p2.10.m10.1.1.cmml" xref="S5.SS2.SSSx3.p2.10.m10.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.10.m10.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.10.m10.1.1">superscript</csymbol><cn type="integer" id="S5.SS2.SSSx3.p2.10.m10.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.10.m10.1.1.2">10</cn><cn type="integer" id="S5.SS2.SSSx3.p2.10.m10.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.10.m10.1.1.3">6</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.10.m10.1c">10^{6}</annotation></semantics></math>) and evaluate the terminal hedging
errors <math id="S5.SS2.SSSx3.p2.11.m11.1" class="ltx_Math" alttext="q-Z+(\delta^{H}\cdot S)_{T}" display="inline"><semantics id="S5.SS2.SSSx3.p2.11.m11.1a"><mrow id="S5.SS2.SSSx3.p2.11.m11.1.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.cmml"><mrow id="S5.SS2.SSSx3.p2.11.m11.1.1.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.3.cmml"><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.3.2" xref="S5.SS2.SSSx3.p2.11.m11.1.1.3.2.cmml">q</mi><mo id="S5.SS2.SSSx3.p2.11.m11.1.1.3.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.3.1.cmml">−</mo><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.3.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.3.3.cmml">Z</mi></mrow><mo id="S5.SS2.SSSx3.p2.11.m11.1.1.2" xref="S5.SS2.SSSx3.p2.11.m11.1.1.2.cmml">+</mo><msub id="S5.SS2.SSSx3.p2.11.m11.1.1.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.cmml"><mrow id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.2" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.cmml">(</mo><mrow id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.cmml"><msup id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2.2" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.2.3.cmml">H</mi></msup><mo lspace="0.222em" rspace="0.222em" id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.1" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.1.cmml">⋅</mo><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.3.cmml">S</mi></mrow><mo stretchy="false" id="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.1.1.1.cmml">)</mo></mrow><mi id="S5.SS2.SSSx3.p2.11.m11.1.1.1.3" xref="S5.SS2.SSSx3.p2.11.m11.1.1.1.3.cmml">T</mi></msub></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.11.m11.1b"><apply id="S5.SS2.SSSx3.p2.11.m11.1.1.cmml" xref="S5.SS2.SSSx3.p2.11.m11.1.1"><plus id="S5.SS