1.p4.2.m2.3.3.1.1.1.1.2.2.1.1.1.1.cmml" xref="S3.SS0.SSSx1.p4.2.m2.3.3.1.1.1.1.2.2.1.1">superscript</csymbol><ci id="S3.SS0.SSSx1.p4.2.m2.3.3.1.1.1.1.2.2.1.1.1.2.cmml" xref="S3.SS0.SSSx1.p4.2.m2.3.3.1.1.1.1.2.2.1.1.1.2">𝛿</ci><apply id="S3.SS0.SSSx1.p4.2.m2.2.2.1.2.cmml" xref="S3.SS0.SSSx1.p4.2.m2.2.2.1.3"><csymbol cd="latexml" id="S3.SS0.SSSx1.p4.2.m2.2.2.1.2.1.cmml" xref="S3.SS0.SSSx1.p4.2.m2.2.2.1.3.1">delimited-[]</csymbol><cn type="integer" id="S3.SS0.SSSx1.p4.2.m2.2.2.1.1.cmml" xref="S3.SS0.SSSx1.p4.2.m2.2.2.1.1">0</cn></apply></apply></apply></apply><cn type="integer" id="S3.SS0.SSSx1.p4.2.m2.3.3.1.1.1.1.4.cmml" xref="S3.SS0.SSSx1.p4.2.m2.3.3.1.1.1.1.4">0</cn></apply></apply></apply><cn type="integer" id="S3.SS0.SSSx1.p4.2.m2.3.3.3.cmml" xref="S3.SS0.SSSx1.p4.2.m2.3.3.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS0.SSSx1.p4.2.m2.3c">\mathbb{P}[(\delta^{[0]}S)_{T}+C_{T}(\delta^{[0]})=0]&gt;0</annotation></semantics></math>. Under the extreme risk measure <math id="S3.SS0.SSSx1.p4.3.m3.1" class="ltx_Math" alttext="\rho(X):=-\inf X" display="inline"><semantics id="S3.SS0.SSSx1.p4.3.m3.1a"><mrow id="S3.SS0.SSSx1.p4.3.m3.1.2" xref="S3.SS0.SSSx1.p4.3.m3.1.2.cmml"><mrow id="S3.SS0.SSSx1.p4.3.m3.1.2.2" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.cmml"><mi id="S3.SS0.SSSx1.p4.3.m3.1.2.2.2" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.SS0.SSSx1.p4.3.m3.1.2.2.1" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.1.cmml">​</mo><mrow id="S3.SS0.SSSx1.p4.3.m3.1.2.2.3.2" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.cmml"><mo stretchy="false" id="S3.SS0.SSSx1.p4.3.m3.1.2.2.3.2.1" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.cmml">(</mo><mi id="S3.SS0.SSSx1.p4.3.m3.1.1" xref="S3.SS0.SSSx1.p4.3.m3.1.1.cmml">X</mi><mo rspace="0.278em" stretchy="false" id="S3.SS0.SSSx1.p4.3.m3.1.2.2.3.2.2" xref="S3.SS0.SSSx1.p4.3.m3.1.2.2.cmml">)</mo></mrow></mrow><mo rspace="0.278em" id="S3.SS0.SSSx1.p4.3.m3.1.2.1" xref="S3.SS0.SSSx1.p4.3.m3.1.2.1.cmml">:=</mo><mrow id="