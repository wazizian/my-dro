<math id="S5.SS2.SSSx3.p4.2.m2.1" class="ltx_Math" alttext="K_{1}&lt;K_{2}" display="inline"><semantics id="S5.SS2.SSSx3.p4.2.m2.1a"><mrow id="S5.SS2.SSSx3.p4.2.m2.1.1" xref="S5.SS2.SSSx3.p4.2.m2.1.1.cmml"><msub id="S5.SS2.SSSx3.p4.2.m2.1.1.2" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p4.2.m2.1.1.2.2" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.2.m2.1.1.2.3" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2.3.cmml">1</mn></msub><mo id="S5.SS2.SSSx3.p4.2.m2.1.1.1" xref="S5.SS2.SSSx3.p4.2.m2.1.1.1.cmml">&lt;</mo><msub id="S5.SS2.SSSx3.p4.2.m2.1.1.3" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3.cmml"><mi id="S5.SS2.SSSx3.p4.2.m2.1.1.3.2" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.2.m2.1.1.3.3" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3.3.cmml">2</mn></msub></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.2.m2.1b"><apply id="S5.SS2.SSSx3.p4.2.m2.1.1.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1"><lt id="S5.SS2.SSSx3.p4.2.m2.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.1"></lt><apply id="S5.SS2.SSSx3.p4.2.m2.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.2.m2.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.2.m2.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.2.m2.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.2.3">1</cn></apply><apply id="S5.SS2.SSSx3.p4.2.m2.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.2.m2.1.1.3.1.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.2.m2.1.1.3.2.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.2.m2.1.1.3.3.cmml" xref="S5.SS2.SSSx3.p4.2.m2.1.1.3.3">2</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.2.m2.1c">K_{1}&lt;K_{2}</annotation></semantics></math>. Here we have chosen <math id="S5.SS2.SSSx3.p4.3.m3.1" class="ltx_Math" alttext="K_{1}=s_{0}" display="inline"><semantics id="S5.SS2.SSSx3.p4.3.m3.1a"><mrow id="S5.SS2.SSSx3.p4.3.m3.1.1" xref="S5.SS2.SSSx3.p4.3.m3.1.1.cmml"><msub id="S5.SS2.SSSx3.p4.3.m3.1.1.2" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p4.3.m3.1.1.2.2" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.3.m3.1.1.2.3" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2.3.cmml">1</mn></msub><mo id="S5.SS2.SSSx3.p4.3.m3.1.1.1" xref="S5.SS2.SSSx3.p4.3.m3.1.1.1.cmml">=</mo><msub id="S5.SS2.SSSx3.p4.3.m3.1.1.3" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3.cmml"><mi id="S5.SS2.SSSx3.p4.3.m3.1.1.3.2" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3.2.cmml">s</mi><mn id="S5.SS2.SSSx3.p4.3.m3.1.1.3.3" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3.3.cmml">0</mn></msub></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.3.m3.1b"><apply id="S5.SS2.SSSx3.p4.3.m3.1.1.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1"><eq id="S5.SS2.SSSx3.p4.3.m3.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.1"></eq><apply id="S5.SS2.SSSx3.p4.3.m3.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.3.m3.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.3.m3.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.3.m3.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.2.3">1</cn></apply><apply id="S5.SS2.SSSx3.p4.3.m3.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.3.m3.1.1.3.1.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.3.m3.1.1.3.2.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3.2">𝑠</ci><cn type="integer" id="S5.SS2.SSSx3.p4.3.m3.1.1.3.3.cmml" xref="S5.SS2.SSSx3.p4.3.m3.1.1.3.3">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.3.m3.1c">K_{1}=s_{0}</annotation></semantics></math>, <math id="S5.SS2.SSSx3.p4.4.m4.1" class="ltx_Math" alttext="K_{2}=101" display="inline"><semantics id="S5.SS2.SSSx3.p4.4.m4.1a"><mrow id="S5.SS2.SSSx3.p4.4.m4.1.1" xref="S5.SS2.SSSx3.p4.4.m4.1.1.cmml"><msub id="S5.SS2.SSSx3.p4.4.m4.1.1.2" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p4.4.m4.1.1.2.2" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.4.m4.1.1.2.3" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2.3.cmml">2</mn></msub><mo id="S5.SS2.SSSx3.p4.4.m4.1.1.1" xref="S5.SS2.SSSx3.p4.4.m4.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p4.4.m4.1.1.3" xref="S5.SS2.SSSx3.p4.4.m4.1.1.3.cmml">101</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.4.m4.1b"><apply id="S5.SS2.SSSx3.p4.4.m4.1.1.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1"><eq id="S5.SS2.SSSx3.p4.4.m4.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.1"></eq><apply id="S5.SS2.SSSx3.p4.4.m4.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.4.m4.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.4.m4.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.4.m4.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.2.3">2</cn></apply><cn type="integer" id="S5.SS2.SSSx3.p4.4.m4.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.4.m4.1.1.3">101</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.4.m4.1c">K_{2}=101</annotation></semantics></math>. Proceeding as
above, we compare the model hedge to the more risk-averse hedging
strategies associated to <math id="S5.SS2.SSSx3.p4.5.m5.1" class="ltx_Math" alttext="\alpha=0.95" display="inline"><semantics id="S5.SS2.SSSx3.p4.5.m5.1a"><mrow id="S5.SS2.SSSx3.p4.5.m5.1.1" xref="S5.SS2.SSSx3.p4.5.m5.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.5.m5.1.1.2" xref="S5.SS2.SSSx3.p4.5.m5.1.1.2.cmml">α</mi><mo id="S5.SS2.SSSx3.p4.5.m5.1.1.1" xref="S5.SS2.SSSx3.p4.5.m5.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p4.5.m5.1.1.3" xref="S5.SS2.SSSx3.p4.5.m5.1.1.3.cmml">0.95</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.5.m5.1b"><apply id="S5.SS2.SSSx3.p4.5.m5.1.1.cmml" xref="S5.SS2.SSSx3.p4.5.m5.1.1"><eq id="S5.SS2.SSSx3.p4.5.m5.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.5.m5.1.1.1"></eq><ci id="S5.SS2.SSSx3.p4.5.m5.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.5.m5.1.1.2">𝛼</ci><cn type="float" id="S5.SS2.SSSx3.p4.5.m5.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.5.m5.1.1.3">0.95</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.5.m5.1c">\alpha=0.95</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p4.6.m6.1" class="ltx_Math" alttext="\alpha=0.99" display="inline"><semantics id="S5.SS2.SSSx3.p4.6.m6.1a"><mrow id="S5.SS2.SSSx3.p4.6.m6.1.1" xref="S5.SS2.SSSx3.p4.6.m6.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.6.m6.1.1.2" xref="S5.SS2.SSSx3.p4.6.m6.1.1.2.cmml">α</mi><mo id="S5.SS2.SSSx3.p4.6.m6.1.1.1" xref="S5.SS2.SSSx3.p4.6.m6.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p4.6.m6.1.1.3" xref="S5.SS2.SSSx3.p4.6.m6.1.1.3.cmml">0.99</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.6.m6.1b"><apply id="S5.SS2.SSSx3.p4.6.m6.1.1.cmml" xref="S5.SS2.SSSx3.p4.6.m6.1.1"><eq id="S5.SS2.SSSx3.p4.6.m6.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.6.m6.1.1.1"></eq><ci id="S5.SS2.SSSx3.p4.6.m6.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.6.m6.1.1.2">𝛼</ci><cn type="float" id="S5.SS2.SSSx3.p4.6.m6.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.6.m6.1.1.3">0.99</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.6.m6.1c">\alpha=0.99</annotation></semantics></math>. The
strategies (on a grid of values for spot and variance) are shown in
Figures <a href="#S5.F8" title="Figure 8 ‣ Results ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> and <a href="#S5.F9" title="Figure 9 ‣ Results ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>. The model hedge would
again correspond to <math id="S5.SS2.SSSx3.p4.7.m7.1" class="ltx_Math" alttext="\alpha=0.5" display="inline"><semantics id="S5.SS2.SSSx3.p4.7.m7.1a"><mrow id="S5.SS2.SSSx3.p4.7.m7.1.1" xref="S5.SS2.SSSx3.p4.7.m7.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.7.m7.1.1.2" xref="S5.SS2.SSSx3.p4.7.m7.1.1.2.cmml">α</mi><mo id="S5.SS2.SSSx3.p4.7.m7.1.1.1" xref="S5.SS2.SSSx3.p4.7.m7.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p4.7.m7.1.1.3" xref="S5.SS2.SSSx3.p4.7.m7.1.1.3.cmml">0.5</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.7.m7.1b"><apply id="S5.SS2.SSSx3.p4.7.m7.1.1.cmml" xref="S5.SS2.SSSx3.p4.7.m7.1.1"><eq id="S5.SS2.SSSx3.p4.7.m7.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.7.m7.1.1.1"></eq><ci id="S5.SS2.SSSx3.p4.7.m7.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.7.m7.1.1.2">𝛼</ci><cn type="float" id="S5.SS2.SSSx3.p4.7.m7.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.7.m7.1.1.3">0.5</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.7.m7.1c">\alpha=0.5</annotation></semantics></math>. As one can see for higher levels of
risk-aversion, the strategy flattens. From a practical perspective,
this precisely corresponds to a barrier shift, i.e. a more risk-averse
hedge for a call spread with strikes <math id="S5.SS2.SSSx3.p4.8.m8.1" class="ltx_Math" alttext="K_{1}" display="inline"><semantics id="S5.SS2.SSSx3.p4.8.m8.1a"><msub id="S5.SS2.SSSx3.p4.8.m8.1.1" xref="S5.SS2.SSSx3.p4.8.m8.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.8.m8.1.1.2" xref="S5.SS2.SSSx3.p4.8.m8.1.1.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.8.m8.1.1.3" xref="S5.SS2.SSSx3.p4.8.m8.1.1.3.cmml">1</mn></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.8.m8.1b"><apply id="S5.SS2.SSSx3.p4.8.m8.1.1.cmml" xref="S5.SS2.SSSx3.p4.8.m8.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.8.m8.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.8.m8.1.1">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.8.m8.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.8.m8.1.1.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.8.m8.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.8.m8.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.8.m8.1c">K_{1}</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p4.9.m9.1" class="ltx_Math" alttext="K_{2}" display="inline"><semantics id="S5.SS2.SSSx3.p4.9.m9.1a"><msub id="S5.SS2.SSSx3.p4.9.m9.1.1" xref="S5.SS2.SSSx3.p4.9.m9.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.9.m9.1.1.2" xref="S5.SS2.SSSx3.p4.9.m9.1.1.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.9.m9.1.1.3" xref="S5.SS2.SSSx3.p4.9.m9.1.1.3.cmml">2</mn></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.9.m9.1b"><apply id="S5.SS2.SSSx3.p4.9.m9.1.1.cmml" xref="S5.SS2.SSSx3.p4.9.m9.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.9.m9.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.9.m9.1.1">subscript</csymbol><ci id="S5.SS2.SSSx3.p4.9.m9.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.9.m9.1.1.2">𝐾</ci><cn type="integer" id="S5.SS2.SSSx3.p4.9.m9.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.9.m9.1.1.3">2</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.9.m9.1c">K_{2}</annotation></semantics></math> actually aims at
hedging a spread with strikes <math id="S5.SS2.SSSx3.p4.10.m10.1" class="ltx_Math" alttext="\tilde{K}_{1}" display="inline"><semantics id="S5.SS2.SSSx3.p4.10.m10.1a"><msub id="S5.SS2.SSSx3.p4.10.m10.1.1" xref="S5.SS2.SSSx3.p4.10.m10.1.1.cmml"><mover accent="true" id="S5.SS2.SSSx3.p4.10.m10.1.1.2" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p4.10.m10.1.1.2.2" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2.2.cmml">K</mi><mo id="S5.SS2.SSSx3.p4.10.m10.1.1.2.1" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2.1.cmml">~</mo></mover><mn id="S5.SS2.SSSx3.p4.10.m10.1.1.3" xref="S5.SS2.SSSx3.p4.10.m10.1.1.3.cmml">1</mn></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.10.m10.1b"><apply id="S5.SS2.SSSx3.p4.10.m10.1.1.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.10.m10.1.1.1.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1">subscript</csymbol><apply id="S5.SS2.SSSx3.p4.10.m10.1.1.2.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2"><ci id="S5.SS2.SSSx3.p4.10.m10.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2.1">~</ci><ci id="S5.SS2.SSSx3.p4.10.m10.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1.2.2">𝐾</ci></apply><cn type="integer" id="S5.SS2.SSSx3.p4.10.m10.1.1.3.cmml" xref="S5.SS2.SSSx3.p4.10.m10.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p4.10.m10.1c">\tilde{K}_{1}</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p4.11.m11.1" class="ltx_Math" alttext="K_{2}" display="inline"><semantics id="S5.SS2.SSSx3.p4.11.m11.1a"><msub id="S5.SS2.SSSx3.p4.11.m11.1.1" xref="S5.SS2.SSSx3.p4.11.m11.1.1.cmml"><mi id="S5.SS2.SSSx3.p4.11.m11.1.1.2" xref="S5.SS2.SSSx3.p4.11.m11.1.1.2.cmml">K</mi><mn id="S5.SS2.SSSx3.p4.11.m11.1.1.3" xref="S5.SS2.SSSx3.p4.11.m11.1.1.3.cmml">2</mn></msub><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p4.11.m11.1b"><apply id="S5.SS2.SSSx3.p4.11.m11.1.1.cmml" xref="S5.SS2.SSSx3.p4.11.m11.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p4.11.m11.1.1.1.cmml" xref=