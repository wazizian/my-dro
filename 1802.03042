S5.SS3.SSSx1.p1.6.m6.1.1.2">subscript</csymbol><ci id="S5.SS3.SSSx1.p1.6.m6.1.1.2.2.cmml" xref="S5.SS3.SSSx1.p1.6.m6.1.1.2.2">𝑠</ci><cn type="integer" id="S5.SS3.SSSx1.p1.6.m6.1.1.2.3.cmml" xref="S5.SS3.SSSx1.p1.6.m6.1.1.2.3">0</cn></apply><cn type="integer" id="S5.SS3.SSSx1.p1.6.m6.1.1.3.cmml" xref="S5.SS3.SSSx1.p1.6.m6.1.1.3">100</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.6.m6.1c">s_{0}=100</annotation></semantics></math> and use the explicit form of <math id="S5.SS3.SSSx1.p1.7.m7.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S5.SS3.SSSx1.p1.7.m7.1a"><mi id="S5.SS3.SSSx1.p1.7.m7.1.1" xref="S5.SS3.SSSx1.p1.7.m7.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.7.m7.1b"><ci id="S5.SS3.SSSx1.p1.7.m7.1.1.cmml" xref="S5.SS3.SSSx1.p1.7.m7.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.7.m7.1c">S</annotation></semantics></math> to
generate sample trajectories. Setting <math id="S5.SS3.SSSx1.p1.8.m8.2" class="ltx_Math" alttext="I_{k}=\log(S_{k})" display="inline"><semantics id="S5.SS3.SSSx1.p1.8.m8.2a"><mrow id="S5.SS3.SSSx1.p1.8.m8.2.2" xref="S5.SS3.SSSx1.p1.8.m8.2.2.cmml"><msub id="S5.SS3.SSSx1.p1.8.m8.2.2.3" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3.cmml"><mi id="S5.SS3.SSSx1.p1.8.m8.2.2.3.2" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3.2.cmml">I</mi><mi id="S5.SS3.SSSx1.p1.8.m8.2.2.3.3" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3.3.cmml">k</mi></msub><mo id="S5.SS3.SSSx1.p1.8.m8.2.2.2" xref="S5.SS3.SSSx1.p1.8.m8.2.2.2.cmml">=</mo><mrow id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml"><mi id="S5.SS3.SSSx1.p1.8.m8.1.1" xref="S5.SS3.SSSx1.p1.8.m8.1.1.cmml">log</mi><mo id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1a" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml">⁡</mo><mrow id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml"><mo stretchy="false" id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.2" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml">(</mo><msub id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.cmml"><mi id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.2" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.2.cmml">S</mi><mi id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.3" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.3.cmml">k</mi></msub><mo stretchy="false" id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.3" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml">)</mo></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.8.m8.2b"><apply id="S5.SS3.SSSx1.p1.8.m8.2.2.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2"><eq id="S5.SS3.SSSx1.p1.8.m8.2.2.2.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.2"></eq><apply id="S5.SS3.SSSx1.p1.8.m8.2.2.3.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p1.8.m8.2.2.3.1.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3">subscript</csymbol><ci id="S5.SS3.SSSx1.p1.8.m8.2.2.3.2.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3.2">𝐼</ci><ci id="S5.SS3.SSSx1.p1.8.m8.2.2.3.3.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.3.3">𝑘</ci></apply><apply id="S5.SS3.SSSx1.p1.8.m8.2.2.1.2.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1"><log id="S5.SS3.SSSx1.p1.8.m8.1.1.cmml" xref="S5.SS3.SSSx1.p1.8.m8.1.1"></log><apply id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.1.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1">subscript</csymbol><ci id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.2.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.2">𝑆</ci><ci id="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.3.cmml" xref="S5.SS3.SSSx1.p1.8.m8.2.2.1.1.1.1.3">𝑘</ci></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.8.m8.2c">I_{k}=\log(S_{k})</annotation></semantics></math> and
proceeding precisely as in the Heston case (see
Sections <a href="#S5.SS1" title="5.1. Setting and Implementation ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> and <a href="#S5.SS2" title="5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>), we
may use the deep hedging algorithm to calculate the exponential
utility indifference price <math id="S5.SS3.SSSx1.p1.9.m9.1" class="ltx_Math" alttext="p_{\varepsilon}" display="inline"><semantics id="S5.SS3.SSSx1.p1.9.m9.1a"><msub id="S5.SS3.SSSx1.p1.9.m9.1.1" xref="S5.SS3.SSSx1.p1.9.m9.1.1.cmml"><mi id="S5.SS3.SSSx1.p1.9.m9.1.1.2" xref="S5.SS3.SSSx1.p1.9.m9.1.1.2.cmml">p</mi><mi id="S5.SS3.SSSx1.p1.9.m9.1.1.3" xref="S5.SS3.SSSx1.p1.9.m9.1.1.3.cmml">ε</mi></msub><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.9.m9.1b"><apply id="S5.SS3.SSSx1.p1.9.m9.1.1.cmml" xref="S5.SS3.SSSx1.p1.9.m9.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p1.9.m9.1.1.1.cmml" xref="S5.SS3.SSSx1.p1.9.m9.1.1">subscript</csymbol><ci id="S5.SS3.SSSx1.p1.9.m9.1.1.2.cmml" xref="S5.SS3.SSSx1.p1.9.m9.1.1.2">𝑝</ci><ci id="S5.SS3.SSSx1.p1.9.m9.1.1.3.cmml" xref="S5.SS3.SSSx1.p1.9.m9.1.1.3">𝜀</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.9.m9.1c">p_{\varepsilon}</annotation></semantics></math> for different values of
<math id="S5.SS3.SSSx1.p1.10.m10.1" class="ltx_Math" alttext="\varepsilon" display="inline"><semantics id="S5.SS3.SSSx1.p1.10.m10.1a"><mi id="S5.SS3.SSSx1.p1.10.m10.1.1" xref="S5.SS3.SSSx1.p1.10.m10.1.1.cmml">ε</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.10.m10.1b"><ci id="S5.SS3.SSSx1.p1.10.m10.1.1.cmml" xref="S5.SS3.SSSx1.p1.10.m10.1.1">𝜀</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.10.m10.1c">\varepsilon</annotation></semantics></math>. Recall that we choose proportional transaction costs (<a href="#S5.E7" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>) and <math id="S5.SS3.SSSx1.p1.11.m11.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S5.SS3.SSSx1.p1.11.m11.1a"><mi id="S5.SS3.SSSx1.p1.11.m11.1.1" xref="S5.SS3.SSSx1.p1.11.m11.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.11.m11.1b"><ci id="S5.SS3.SSSx1.p1.11.m11.1.1.cmml" xref="S5.SS3.SSSx1.p1.11.m11.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.11.m11.1c">\rho</annotation></semantics></math> is the entropic risk measure
(<a href="#S3.E4" title="In Lemma 3.6. ‣ 3.1. Exponential Utility Indifference Pricing ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>) (see Lemma <a href="#S3.Thmtheorem6" title="Lemma 3.6. ‣ 3.1. Exponential Utility Indifference Pricing ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>). For the numerical
example we take <math id="S5.SS3.SSSx1.p1.12.m12.1" class="ltx_Math" alttext="\lambda=1" display="inline"><semantics id="S5.SS3.SSSx1.p1.12.m12.1a"><mrow id="S5.SS3.SSSx1.p1.12.m12.1.1" xref="S5.SS3.SSSx1.p1.12.m12.1.1.cmml"><mi id="S5.SS3.SSSx1.p1.12.m12.1.1.2" xref="S5.SS3.SSSx1.p1.12.m12.1.1.2.cmml">λ</mi><mo id="S5.SS3.SSSx1.p1.12.m12.1.1.1" xref="S5.SS3.SSSx1.p1.12.m12.1.1.1.cmml">=</mo><mn id="S5.SS3.SSSx1.p1.12.m12.1.1.3" xref="S5.SS3.SSSx1.p1.12.m12.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p1.12.m12.1b"><apply id="S5.SS3.SSSx1.p1.12.m12.1.1.cmml" xref="S5.SS3.SSSx1.p1.12.m12.1.1"><eq id="S5.SS3.SSSx1.p1.12.m12.1.1.1.cmml" xref="S5.SS3.SSSx1.p1.12.m12.1.1.1"></eq><ci id="S5.SS3.SSSx1.p1.12.m12.1.1.2.cmml" xref="S5.SS3.SSSx1.p1.12.m12.1.1.2">𝜆</ci><cn type="integer" id="S5.SS3.SSSx1.p1.12.m12.1.1.3.cmml" xref="S5.SS3.SSSx1.p1.12.m12.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p1.12.m12.1c">\lambda=1</annotation></semantics></math> and <math id="S5.SS3.SSSx1.p1.13.m13.1" class="ltx_Math" alttext="Z=(S_{T}-K)^{+}" display="inline"><semantics id="S5.SS3.SSSx1.p1.13.m13.1a"><mrow id="S5.SS3.SSSx1.p1.13.m13.1.1" xref="S5.SS3.SSSx1.p1.13.m13.1.1.cmml"><mi id="S5.SS3.SSSx1.p1.13.m13.1.1.3" xref="S5.SS3.SSSx1.p1.13.m13.1.1.3.cmml">Z</mi><mo id="S5.SS3.SSSx1.p1.13.m13.1.1.2" xref="S5.SS3.SSSx1.p1.13.m13.1.1.2.cmml">=</mo><msup id="S5.SS3.SSSx1.p1.13.m13.1.1.1" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.cmml"><mrow id="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.2" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.cmml">(</mo><mrow id="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.cmml"><msub id="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.2" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.2.cmml"><mi id="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.2.2" xref="S5.SS3.SSSx1.p1.13.m13.1.1.1.1.1.1.