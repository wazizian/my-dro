">𝑖</ci></apply><ci id="S2.Ex4.m1.3.3.2.2.1.1.1.2.2.3.cmml" xref="S2.Ex4.m1.3.3.2.2.1.1.1.2.2.3">𝑘</ci></apply><apply id="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.cmml" xref="S2.Ex4.m1.3.3.2.2.1.1.1.2.3"><csymbol cd="ambiguous" id="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.1.cmml" xref="S2.Ex4.m1.3.3.2.2.1.1.1.2.3">superscript</csymbol><ci id="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.2.cmml" xref="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.2">n</ci><ci id="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.3.cmml" xref="S2.Ex4.m1.3.3.2.2.1.1.1.2.3.3">𝑖</ci></apply></apply></apply></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Ex4.m1.3c">c_{k}(\mathrm{n}):=c_{k}^{i}S_{k}^{1}\left|1+\sum_{i=2}^{d}\Delta^{i}_{k}\mathrm{n}^{i}\right|+v_{k}^{i}\left|\sum_{i=2}^{d}\mathcal{V}^{i}_{k}\mathrm{n}^{i}\right|</annotation></semantics></math></td>
