1.1.1.1.1.5.cmml" xref="S3.E6.m1.1.1.1.1.1.1.5"></eq><share href="#S3.E6.m1.1.1.1.1.1.1.2.cmml" id="S3.E6.m1.1.1.1.1.1.1d.cmml" xref="S3.E6.m1.1.1.1.1.1.1"></share><cn type="integer" id="S3.E6.m1.1.1.1.1.1.1.6.cmml" xref="S3.E6.m1.1.1.1.1.1.1.6">0</cn></apply></apply><apply id="S3.E6.m1.1.1.1.1.2.2.cmml" xref="S3.E6.m1.1.1.1.1.2.2"><in id="S3.E6.m1.1.1.1.1.2.2.1.cmml" xref="S3.E6.m1.1.1.1.1.2.2.1"></in><apply id="S3.E6.m1.1.1.1.1.2.2.2.cmml" xref="S3.E6.m1.1.1.1.1.2.2.2"><times id="S3.E6.m1.1.1.1.1.2.2.2.1.cmml" xref="S3.E6.m1.1.1.1.1.2.2.2.1"></times><ci id="S3.E6.m1.1.1.1.1.2.2.2.2a.cmml" xref="S3.E6.m1.1.1.1.1.2.2.2.2"><mtext id="S3.E6.m1.1.1.1.1.2.2.2.2.cmml" xref="S3.E6.m1.1.1.1.1.2.2.2.2"> for any </mtext></ci><ci id="S3.E6.m1.1.1.1.1.2.2.2.3.cmml" xref="S3.E6.m1.1.1.1.1.2.2.2.3">𝛿</ci></apply><ci id="S3.E6.m1.1.1.1.1.2.2.3.cmml" xref="S3.E6.m1.1.1.1.1.2.2.3">ℋ</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.E6.m1.1c">\mathbb{E}[(\delta\cdot S)_{T}]=\sum_{j=0}^{n-1}\mathbb{E}\left[\delta_{j}\mathbb{E}[S_{j+1}-S_{j}|\mathcal{F}_{j}]\right]=0\quad\text{ for any }\delta\in\mathcal{H}.</annotation></semantics></math></td>
