<p id="S5.SS2.SSSx1.p1.15" class="ltx_p">where <math id="S5.SS2.SSSx1.p1.1.m1.1" class="ltx_Math" alttext="B" display="inline"><semantics id="S5.SS2.SSSx1.p1.1.m1.1a"><mi id="S5.SS2.SSSx1.p1.1.m1.1.1" xref="S5.SS2.SSSx1.p1.1.m1.1.1.cmml">B</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p1.1.m1.1b"><ci id="S5.SS2.SSSx1.p1.1.m1.1.1.cmml" xref="S5.SS2.SSSx1.p1.1.m1.1.1">𝐵</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p1.1.m1.1c">B</annotation></semantics></math> and <math id="S5.SS2.SSSx1.p1.2.m2.1" class="ltx_Math" alttext="W" display="inline"><semantics id="S5.SS2.SSSx1.p1.2.m2.1a"><mi id="S5.SS2.SSSx1.p1.2.m2.1.1" xref="S5.SS2.SSSx1.p1.2.m2.1.1.cmml">W</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p1.2.m2.1b"><ci id="S5.SS2.SSSx1.p1.2.m2.1.1.cmml" xref="S5.SS2.SSSx1.p1.2.m2.1.1">𝑊</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p1.2.m2.1c">W</annotation></semantics></math> are
