ml" xref="S5.E6.m1.5.5.5.2.1.1"><ci id="S5.E6.m1.4.4.4.1.cmml" xref="S5.E6.m1.4.4.4.1">𝑡</ci><apply id="S5.E6.m1.5.5.5.2.1.1.1.cmml" xref="S5.E6.m1.5.5.5.2.1.1.1"><csymbol cd="ambiguous" id="S5.E6.m1.5.5.5.2.1.1.1.1.cmml" xref="S5.E6.m1.5.5.5.2.1.1.1">subscript</csymbol><ci id="S5.E6.m1.5.5.5.2.1.1.1.2.cmml" xref="S5.E6.m1.5.5.5.2.1.1.1.2">𝑉</ci><ci id="S5.E6.m1.5.5.5.2.1.1.1.3.cmml" xref="S5.E6.m1.5.5.5.2.1.1.1.3">𝑡</ci></apply></interval></apply></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.E6.m1.7c">\delta^{1}_{t}:=\partial_{s}u(t,S^{1}_{t},V_{t})\text{ and }\delta^{2}_{t}:=\frac{\partial_{v}u(t,S^{1}_{t},V_{t})}{\partial_{v}L(t,V_{t})}.</annotation></semantics></math></td>
