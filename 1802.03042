="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.2.2.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.2.2">𝛿</ci><ci id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.2.3.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.2.3">𝑘</ci></apply><apply id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3"><csymbol cd="ambiguous" id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.1.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3">subscript</csymbol><ci id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.2.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.2">𝛿</ci><apply id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3"><minus id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.1.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.1"></minus><ci id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.2.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.2">𝑘</ci><cn type="integer" id="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.3.cmml" xref="S2.Ex1.m1.2.2.2.2.1.1.1.1.1.3.3.3">1</cn></apply></apply></apply></apply><apply id="S2.Ex1.m1.3.3.3.3.2.2.cmml" xref="S2.Ex1.m1.3.3.3.3.2.2"><csymbol cd="ambiguous" id="S2.Ex1.m1.3.3.3.3.2.2.1.cmml" xref="S2.Ex1.m1.3.3.3.3.2.2">subscript</csymbol><ci id="S2.Ex1.m1.3.3.3.3.2.2.2.cmml" xref="S2.Ex1.m1.3.3.3.3.2.2.2">𝒱</ci><ci id="S2.Ex1.m1.3.3.3.3.2.2.3.cmml" xref="S2.Ex1.m1.3.3.3.3.2.2.3">max</ci></apply></apply></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.Ex1.m1.5c">H_{k}(\delta_{0},\ldots,\delta_{k}):=\delta_{k-1}+(\delta_{k}-\delta_{k-1})\frac{\mathcal{V}_{\mathrm{max}}}{\max\{\mathcal{V}_{k}(\delta_{k}-\delta_{k-1}),\mathcal{V}_{\mathrm{max}}\}}\ .</annotation></semantics></math></td>
