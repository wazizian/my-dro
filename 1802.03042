<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8. </span>Call spread <math id="S5.F8.4.m1.3" class="ltx_Math" alttext="\delta^{H,(1)}_{t}" display="inline"><semantics id="S5.F8.4.m1.3b"><msubsup id="S5.F8.4.m1.3.4" xref="S5.F8.4.m1.3.4.cmml"><mi id="S5.F8.4.m1.3.4.2.2" xref="S5.F8.4.m1.3.4.2.2.cmml">δ</mi><mi id="S5.F8.4.m1.3.4.3" xref="S5.F8.4.m1.3.4.3.cmml">t</mi><mrow id="S5.F8.4.m1.3.3.3.3" xref="S5.F8.4.m1.3.3.3.4.cmml"><mi id="S5.F8.4.m1.2.2.2.2" xref="S5.F8.4.m1.2.2.2.2.cmml">H</mi><mo id="S5.F8.4.m1.3.3.3.3.2" xref="S5.F8.4.m1.3.3.3.4.cmml">,</mo><mrow id="S5.F8.4.m1.3.3.3.3.1.2" xref="S5.F8.4.m1.3.3.3.4.cmml"><mo stretchy="false" id="S5.F8.4.m1.3.3.3.3.1.2.1" xref="S5.F8.4.m1.3.3.3.4.cmml">(</mo><mn id="S5.F8.4.m1.1.1.1.1" xref="S5.F8.4.m1.1.1.1.1.cmml">1</mn><mo stretchy="false" id="S5.F8.4.m1.3.3.3.3.1.2.2" xref="S5.F8.4.m1.3.3.3.4.cmml">)</mo></mrow></mrow></msubsup><annotation-xml encoding="MathML-Content" id="S5.F8.4.m1.3c"><apply id="S5.F8.4.m1.3.4.cmml" xref="S5.F8.4.m1.3.4"><csymbol cd="ambiguous" id="S5.F8.4.m1.3.4.1.cmml" xref="S5.F8.4.m1.3.4">subscript</csymbol><apply id="S5.F8.4.m1.3.4.2.cmml" xref="S5.F8.4.m1.3.4"><csymbol cd="ambiguous" id="S5.F8.4.m1.3.4.2.1.cmml" xref="S5.F8.4.m1.3.4">superscript</csymbol><ci id="S5.F8.4.m1.3.4.2.2.cmml" xref="S5.F8.4.m1.3.4.2.2">𝛿</ci><list id="S5.F8.4.m1.3.3.3.4.cmml" xref="S5.F8.4.m1.3.3.3.3"><ci id="S5.F8.4.m1.2.2.2.2.cmml" xref="S5.F8.4.m1.2.2.2.2">𝐻</ci><cn type="integer" id="S5.F8.4.m1.1.1.1.1.cmml" xref="S5.F8.4.m1.1.1.1.1">1</cn></list></apply><ci id="S5.F8.4.m1.3.4.3.cmml" xref="S5.F8.4.m1.3.4.3">𝑡</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.F8.4.m1.3d">\delta^{H,(1)}_{t}</annotation></semantics></math> and neural network
approximation as a function of <math id="S5.F8.5.m2.2" class="ltx_Math" alttext="(s_{t},v_{t})" display="inline"><semantics id="S5.F8.5.m2.2b"><mrow id="S5.F8.5.m2.2.2.2" xref="S5.F8.5.m2.2.2.3.cmml"><mo stretchy="false" id="S5.F8.5.m2.2.2.2.3" xref="S5.F8.5.m2.2.2.3.cmml">(</mo><msub id="S5.F8.5.m2.1.1.1.1" xref="S5.F8.5.m2.1.1.1.1.cmml"><mi id="S5.F8.5.m2.1.1.1.1.2" xref="S5.F8.5.m2.1.1.1.1.2.cmml">s</mi><mi id="S5.F8.5.m2.1.1.1.1.3" xref="S5.F8.5.m2.1.1.1.1.3.cmml">t</mi></msub><mo id="S5.F8.5.m2.2.2.2.4" xref="S5.F8.5.m2.2.2.3.cmml">,</mo><msub id="S5.F8.5.m2.2.2.2.2" xref="S5.F8.5.m2.2.2.2.2.cmml"><mi id="S5.F8.5.m2.2.2.2.2.2" xref="S5.F8.5.m2.2.2.2.2.2.cmml">v</mi><mi id="S5.F8.5.m2.2.2.2.2.3" xref="S5.F8.5.m2.2.2.2.2.3.cmml">t</mi></msub><mo stretchy="false" id="S5.F8.5.m2.2.2.2.5" xref="S5.F8.5.m2.2.2.3.cmml">)</mo></mrow><annotation-xml encoding="MathML-Content" id="S5.F8.5.m2.2c"><interval closure="open" id="S5.F8.5.m2.2.2.3.cmml" xref="S5.F8.5.m2.2.2.2"><apply id="S5.F8.5.m2.1.1.1.1.cmml" xref="S5.F8.5.m2.1.1.1.1"><csymbol cd="ambiguous" id="S5.F8.5.m2.1.1.1.1.1.cmml" xref="S5.F8.5.m2.1.1.1.1">subscript</csymbol><ci id="S5.F8.5.m2.1.1.1.1.2.cmml" xref="S5.F8.5.m2.1.1.1.1.2">𝑠</ci><ci id="S5.F8.5.m2.1.1.1.1.3.cmml" xref="S5.F8.5.m2.1.1.1.1.3">𝑡</ci></apply><apply id="S5.F8.5.m2.2.2.2.2.cmml" xref="S5.F8.5.m2.2.2.2.2"><csymbol cd="ambiguous" id="S5.F8.5.m2.2.2.2.2.1.cmml" xref="S5.F8.5.m2.2.2.2.2">subscript</csymbol><ci id="S5.F8.5.m2.2.2.2.2.2.cmml" xref="S5.F8.5.m2.2.2.2.2.2">𝑣</ci><ci id="S5.F8.5.m2.2.2.2.2.3.cmml" xref="S5.F8.5.m2.2.2.2.2.3">𝑡</ci></apply></interval></annotation-xml><annotation encoding="application/x-tex" id="S5.F8.5.m2.2d">(s_{t},v_{t})</annotation></semantics></math> for <math id="S5.F8.6.m3.1" class="ltx_Math" alttext="t=15" display="inline"><semantics id="S5.F8.6.m3.1b"><mrow id="S5.F8.6.m3.1.1" xref="S5.F8.6.m3.1.1.cmml"><mi id="S5.F8.6.m3.1.1.2" xref="S5.F8.6.m3.1.1.2.cmml">t</mi><mo id="S5.F8.6.m3.1.1.1" xref="S5.F8.6.m3.1.1.1.c