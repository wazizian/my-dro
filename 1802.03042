1.1.cmml">=</mo><mn id="S5.SS2.SSSx1.p1.14.m14.1.1.3" xref="S5.SS2.SSSx1.p1.14.m14.1.1.3.cmml">0.04</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p1.14.m14.1b"><apply id="S5.SS2.SSSx1.p1.14.m14.1.1.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1"><eq id="S5.SS2.SSSx1.p1.14.m14.1.1.1.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.1"></eq><apply id="S5.SS2.SSSx1.p1.14.m14.1.1.2.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx1.p1.14.m14.1.1.2.1.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.2">subscript</csymbol><ci id="S5.SS2.SSSx1.p1.14.m14.1.1.2.2.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.2.2">𝑣</ci><cn type="integer" id="S5.SS2.SSSx1.p1.14.m14.1.1.2.3.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.2.3">0</cn></apply><cn type="float" id="S5.SS2.SSSx1.p1.14.m14.1.1.3.cmml" xref="S5.SS2.SSSx1.p1.14.m14.1.1.3">0.04</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p1.14.m14.1c">v_{0}=0.04</annotation></semantics></math> and <math id="S5.SS2.SSSx1.p1.15.m15.1" class="ltx_Math" alttext="s_{0}=100" display="inline"><semantics id="S5.SS2.SSSx1.p1.15.m15.1a"><mrow id="S5.SS2.SSSx1.p1.15.m15.1.1" xref="S5.SS2.SSSx1.p1.15.m15.1.1.cmml"><msub id="S5.SS2.SSSx1.p1.15.m15.1.1.2" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2.cmml"><mi id="S5.SS2.SSSx1.p1.15.m15.1.1.2.2" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2.2.cmml">s</mi><mn id="S5.SS2.SSSx1.p1.15.m15.1.1.2.3" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2.3.cmml">0</mn></msub><mo id="S5.SS2.SSSx1.p1.15.m15.1.1.1" xref="S5.SS2.SSSx1.p1.15.m15.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx1.p1.15.m15.1.1.3" xref="S5.SS2.SSSx1.p1.15.m15.1.1.3.cmml">100</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p1.15.m15.1b"><apply id="S5.SS2.SSSx1.p1.15.m15.1.1.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1"><eq id="S5.SS2.SSSx1.p1.15.m15.1.1.1.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.1"></eq><apply id="S5.SS2.SSSx1.p1.15.m15.1.1.2.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx1.p1.15.m15.1.1.2.1.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2">subscript</csymbol><ci id="S5.SS2.SSSx1.p1.15.m15.1.1.2.2.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2.2">𝑠</ci><cn type="integer" id="S5.SS2.SSSx1.p1.15.m15.1.1.2.3.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.2.3">0</cn></apply><cn type="integer" id="S5.SS2.SSSx1.p1.15.m15.1.1.3.cmml" xref="S5.SS2.SSSx1.p1.15.m15.1.1.3">100</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p1.15.m15.1c">s_{0}=100</annotation></semantics></math>,
reflecting a typical situation in an equity market.</p>
</div>
<div id="S5.SS2.SSSx1.p2" class="ltx_para">
<p id="S5.SS2.SSSx1.p2.6" class="ltx_p">Here <math id="S5.SS2.SSSx1.p2.1.m1.1" class="ltx_Math" alttext="S^{1}" display="inline"><semantics id="S5.SS2.SSSx1.p2.1.m1.1a"><msup id="S5.SS2.SSSx1.p2.1.m1.1.1" xref="S5.SS2.SSSx1.p2.1.m1.1.1.cmml"><mi id="S5.SS2.SSSx1.p2.1.m1.1.1.2" xref="S5.SS2.SSSx1.p2.1.m1.1.1.2.cmml">S</mi><mn id="S5.SS2.SSSx1.p2.1.m1.1.1.3" xref="S5.SS2.SSSx1.p2.1.m1.1.1.3.cmml">1</mn></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p2.1.m1.1b"><apply id="S5.SS2.SSSx1.p2.1.m1.1.1.cmml" xref="S5.SS2.SSSx1.p2.1.m1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx1.p2.1.m1.1.1.1.cmml" xref="S5.SS2.SSSx1.p2.1.m1.1.1">superscript</csymbol><ci id="S5.SS2.SSSx1.p2.1.m1.1.1.2.cmml" xref="S5.SS2.SSSx1.p2.1.m1.1.1.2">𝑆</ci><cn type="integer" id="S5.SS2.SSSx1.p2.1.m1.1.1.3.cmml" xref="S5.SS2.SSSx1.p2.1.m1.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.1.m1.1c">S^{1}</annotation></semantics></math> is the price of a liquidly tradeable asset and <math id="S5.SS2.SSSx1.p2.2.m2.1" class="ltx_Math" alttext="V" display="inline"><semantics id="S5.SS2.SSSx1.p2.2.m2.1a"><mi id="S5.SS2.SSSx1.p2.2.m2.1.1" xref="S5.SS2.SSSx1.p2.2.m2.1.1.cmml">V</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p2.2.m2.1b"><ci id="S5.SS2.SSSx1.p2.2.m2.1.1.cmml" xref="S5.SS2.SSSx1.p2.2.m2.1.1">𝑉</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.2.m2.1c">V</annotation></semantics></math> is
the (stochastic) variance process of <math id="S5.SS2.SSSx1.p2.3.m3.1" class="ltx_Math" alttext="S^{1}" display="inline"><semantics id="S5.SS2.SSSx1.p2.3.m3.1a"><msup id="S5.SS2.SSSx1.p2.3.m3.1.1" xref="S5.SS2.SSSx1.p2.3.m3.1.1.cmml"><mi id="S5.SS2.SSSx1.p2.3.m3.1.1.2" xref="S5.SS2.SSSx1.p2.3.m3.1.1.2.cmml">S</mi><mn id="S5.SS2.SSSx1.p2.3.m3.1.1.3" xref="S5.SS2.SSSx1.p2.3.m3.1.1.3.cmml">1</mn></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p2.3.m3.1b"><apply id="S5.SS2.SSSx1.p2.3.m3.1.1.cmml" xref="S5.SS2.SSSx1.p2.3.m3.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx1.p2.3.m3.1.1.1.cmml" xref="S5.SS2.SSSx1.p2.3.m3.1.1">superscript</csymbol><ci id="S5.SS2.SSSx1.p2.3.m3.1.1.2.cmml" xref="S5.SS2.SSSx1.p2.3.m3.1.1.2">𝑆</ci><cn type="integer" id="S5.SS2.SSSx1.p2.3.m3.1.1.3.cmml" xref="S5.SS2.SSSx1.p2.3.m3.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.3.m3.1c">S^{1}</annotation></semantics></math>, modeled by a
Cox-Ingersoll-Ross (CIR) process. <math id="S5.SS2.SSSx1.p2.4.m4.1" class="ltx_Math" alttext="V" display="inline"><semantics id="S5.SS2.SSSx1.p2.4.m4.1a"><mi id="S5.SS2.SSSx1.p2.4.m4.1.1" xref="S5.SS2.SSSx1.p2.4.m4.1.1.cmml">V</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p2.4.m4.1b"><ci id="S5.SS2.SSSx1.p2.4.m4.1.1.cmml" xref="S5.SS2.SSSx1.p2.4.m4.1.1">𝑉</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.4.m4.1c">V</annotation></semantics></math> itself is not tradable directly,
but only through options on variance. In our framework this is modeled
by an idealized variance swap with maturity <math id="S5.SS2.SSSx1.p2.5.m5.1" class="ltx_Math" alttext="T" display="inline"><semantics id="S5.SS2.SSSx1.p2.5.m5.1a"><mi id="S5.SS2.SSSx1.p2.5.m5.1.1" xref="S5.SS2.SSSx1.p2.5.m5.1.1.cmml">T</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx1.p2.5.m5.1b"><ci id="S5.SS2.SSSx1.p2.5.m5.1.1.cmml" xref="S5.SS2.SSSx1.p2.5.m5.1.1">𝑇</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.5.m5.1c">T</annotation></semantics></math>, i.e. we set
<math id="S5.SS2.SSSx1.p2.6.m6.1" class="ltx_math_unparsed" alttext="\mathcal{F}^{H}_{t}:=\sigma((S^{1}_{s},V_{s})\,:\,s\in[0,t])" display="inline"><semantics id="S5.SS2.SSSx1.p2.6.m6.1a"><mrow id="S5.SS2.SSSx1.p2.6.m6.1b"><msubsup id="S5.SS2.SSSx1.p2.6.m6.1.1"><mi class="ltx_font_mathcaligraphic" id="S5.SS2.SSSx1.p2.6.m6.1.1.2.2">ℱ</mi><mi id="S5.SS2.SSSx1.p2.6.m6.1.1.3">t</mi><mi id="S5.SS2.SSSx1.p2.6.m6.1.1.2.3">H</mi></msubsup><mo lspace="0.278em" rspace="0.278em" id="S5.SS2.SSSx1.p2.6.m6.1.2">:=</mo><mi id="S5.SS2.SSSx1.p2.6.m6.1.3">σ</mi><mrow id="S5.SS2.SSSx1.p2.6.m6.1.4"><mo stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.1">(</mo><mrow id="S5.SS2.SSSx1.p2.6.m6.1.4.2"><mo stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.2.1">(</mo><msubsup id="S5.SS2.SSSx1.p2.6.m6.1.4.2.2"><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.2.2.2.2">S</mi><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.2.2.3">s</mi><mn id="S5.SS2.SSSx1.p2.6.m6.1.4.2.2.2.3">1</mn></msubsup><mo id="S5.SS2.SSSx1.p2.6.m6.1.4.2.3">,</mo><msub id="S5.SS2.SSSx1.p2.6.m6.1.4.2.4"><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.2.4.2">V</mi><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.2.4.3">s</mi></msub><mo rspace="0.448em" stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.2.5">)</mo></mrow><mo rspace="0.448em" id="S5.SS2.SSSx1.p2.6.m6.1.4.3">:</mo><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.4">s</mi><mo id="S5.SS2.SSSx1.p2.6.m6.1.4.5">∈</mo><mrow id="S5.SS2.SSSx1.p2.6.m6.1.4.6"><mo stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.6.1">[</mo><mn id="S5.SS2.SSSx1.p2.6.m6.1.4.6.2">0</mn><mo id="S5.SS2.SSSx1.p2.6.m6.1.4.6.3">,</mo><mi id="S5.SS2.SSSx1.p2.6.m6.1.4.6.4">t</mi><mo stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.6.5">]</mo></mrow><mo stretchy="false" id="S5.SS2.SSSx1.p2.6.m6.1.4.7">)</mo></mrow></mrow><annotation encoding="application/x-tex" id="S5.SS2.SSSx1.p2.6.m6.1c">\mathcal{F}^{H}_{t}:=\sigma((S^{1}_{s},V_{s})\,:\,s\in[0,t])</annotation></semantics></math> and</p>
<table id="S5.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
