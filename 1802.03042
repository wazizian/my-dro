<div id="S4.SS2.1.p1" class="ltx_para">
<p id="S4.SS2.1.p1.4" class="ltx_p">Note that <math id="S4.SS2.1.p1.1.m1.1" class="ltx_Math" alttext="H\!\circ\!\delta=\delta" display="inline"><semantics id="S4.SS2.1.p1.1.m1.1a"><mrow id="S4.SS2.1.p1.1.m1.1.1" xref="S4.SS2.1.p1.1.m1.1.1.cmml"><mrow id="S4.SS2.1.p1.1.m1.1.1.2" xref="S4.SS2.1.p1.1.m1.1.1.2.cmml"><mi id="S4.SS2.1.p1.1.m1.1.1.2.2" xref="S4.SS2.1.p1.1.m1.1.1.2.2.cmml">H</mi><mo lspace="0.052em" rspace="0.052em" id="S4.SS2.1.p1.1.m1.1.1.2.1" xref="S4.SS2.1.p1.1.m1.1.1.2.1.cmml">∘</mo><mi id="S4.SS2.1.p1.1.m1.1.1.2.3" xref="S4.SS2.1.p1.1.m1.1.1.2.3.cmml">δ</mi></mrow><mo id="S4.SS2.1.p1.1.m1.1.1.1" xref="S4.SS2.1.p1.1.m1.1.1.1.cmml">=</mo><mi id="S4.SS2.1.p1.1.m1.1.1.3" xref="S4.SS2.1.p1.1.m1.1.1.3.cmml">δ</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.1.p1.1.m1.1b"><apply id="S4.SS2.1.p1.1.m1.1.1.cmml" xref="S4.SS2.1.p1.1.m1.1.1"><eq id="S4.SS2.1.p1.1.m1.1.1.1.cmml" xref="S4.SS2.1.p1.1.m1.1.1.1"></eq><apply id="S4.SS2.1.p1.1.m1.1.1.2.cmml" xref="S4.SS2.1.p1.1.m1.1.1.2"><compose id="S4.SS2.1.p1.1.m1.1.1.2.1.cmml" xref="S4.SS2.1.p1.1.m1.1.1.2.1"></compose><ci id="S4.SS2.1.p1.1.m1.1.1.2.2.cmml" xref="S4.SS2.1.p1.1.m1.1.1.2.2">𝐻</ci><ci id="S4.SS2.1.p1.1.m1.1.1.2.3.cmml" xref="S4.SS2.1.p1.1.m1.1.1.2.3">𝛿</ci></apply><ci id="S4.SS2.1.p1.1.m1.1.1.3.cmml" xref="S4.SS2.1.p1.1.m1.1.1.3">𝛿</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.1.p1.1.m1.1c">H\!\circ\!\delta=\delta</annotation></semantics></math> for all <math id="S4.SS2.1.p1.2.m2.1" class="ltx_Math" alttext="\delta\in\mathcal{H}" display="inline"><semantics id="S4.SS2.1.p1.2.m2.1a"><mrow id="S4.SS2.1.p1.2.m2.1.1" xref="S4.SS2.1.p1.2.m2.1.1.cmml"><mi id="S4.SS2.1.p1.2.m2.1.1.2" xref="S4.SS2.1.p1.2.m2.1.1.2.cmml">δ</mi><mo id="S4.SS2.1.p1.2.m2.1.1.1" xref="S4.SS2.1.p1.2.m2.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S4.SS2.1.p1.2.m2.1.1.3" xref="S4.SS2.1.p1.2.m2.1.1.3.cmml">ℋ</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.1.p1.2.m2.1b"><apply id="S4.SS2.1.p1.2.m2.1.1.cmml" xref="S4.SS2.1.p1.2.m2.1.1"><in id="S4.SS2.1.p1.2.m2.1.1.1.cmml" xref="S4.SS2.1.p1.2.m2.1.1.1"></in><ci id="S4.SS2.1.p1.2.m2.1.1.2.cmml" xref="S4.SS2.1.p1.2.m2.1.1.2">𝛿</ci><ci id="S4.SS2.1.p1.2.m2.1.1.3.cmml" xref="S4.SS2.1.p1.2.m2.1.1.3">ℋ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.1.p1.2.m2.1c">\delta\in\mathcal{H}</annotation></semantics></math>, and
