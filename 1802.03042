<div id="S3.SS2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.1.p1" class="ltx_para">
<p id="S3.SS2.1.p1.1" class="ltx_p">Let <math id="S3.SS2.1.p1.1.m1.2" class="ltx_Math" alttext="X,Y\in\mathcal{X}" display="inline"><semantics id="S3.SS2.1.p1.1.m1.2a"><mrow id="S3.SS2.1.p1.1.m1.2.3" xref="S3.SS2.1.p1.1.m1.2.3.cmml"><mrow id="S3.SS2.1.p1.1.m1.2.3.2.2" xref="S3.SS2.1.p1.1.m1.2.3.2.1.cmml"><mi id="S3.SS2.1.p1.1.m1.1.1" xref="S3.SS2.1.p1.1.m1.1.1.cmml">X</mi><mo id="S3.SS2.1.p1.1.m1.2.3.2.2.1" xref="S3.SS2.1.p1.1.m1.2.3.2.1.cmml">,</mo><mi id="S3.SS2.1.p1.1.m1.2.2" xref="S3.SS2.1.p1.1.m1.2.2.cmml">Y</mi></mrow><mo id="S3.SS2.1.p1.1.m1.2.3.1" xref="S3.SS2.1.p1.1.m1.2.3.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S3.SS2.1.p1.1.m1.2.3.3" xref="S3.SS2.1.p1.1.m1.2.3.3.cmml">𝒳</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.1.p1.1.m1.2b"><apply id="S3.SS2.1.p1.1.m1.2.3.cmml" xref="S3.SS2.1.p1.1.m1.2.3"><in id="S3.SS2.1.p1.1.m1.2.3.1.cmml" xref="S3.SS2.1.p1.1.m1.2.3.1"></in><list id="S3.SS2.1.p1.1.m1.2.3.2.1.cmml" xref="S3.SS2.1.p1.1.m1.2.3.2.2"><ci id="S3.SS2.1.p1.1.m1.1.1.cmml" xref="S3.SS2.1.p1.1.m1.1.1">𝑋</ci><ci id="S3.SS2.1.p1.1.m1.2.2.cmml" xref="S3.SS2.1.p1.1.m1.2.2">𝑌</ci></list><ci id="S3.SS2.1.p1.1.m1.2.3.3.cmml" xref="S3.SS2.1.p1.1.m1.2.3.3">𝒳</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.1.p1.1.m1.2c">X,Y\in\mathcal{X}</annotation></semantics></math> be assets.</p>
<ul id="S3.I2" class="ltx_itemize">
<li id="S3.I2.ix1" class="ltx_item" style="list-style-type:none;">
<span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S3.I2.ix1.p1" class="ltx_para">
<p id="S3.I2.ix1.p1.5" class="ltx_p">Monotonicity: suppose <math id="S3.I2.ix1.p1.1.m1.1" class="ltx_Math" alttext="X\leq Y" display="inline"><semantics id="S3.I2.ix1.p1.1.m1.1a"><mrow id="S3.I2.ix1.p1.1.m1.1.1" xref="S3.I2.ix1.p1.1.m1.1.1.cmml"><mi id="S3.I2.ix1.p1.1.m1.1.1.2" xref="S3.I2.ix1.p1.1.m1.1.1.2.cmml">X</mi><mo id="S3.I2.ix1.p1.1.m1.1.1.1" xref="S3.I2.ix1.p1.1.m1.1.1.1.cmml">≤</mo><mi id="S3.I2.ix1.p1.1.m1.1.1.3" xref="S3.I2.ix1.p1.1.m1.1.1.3.cmml">Y</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.I2.ix1.p1.1.m1.1b"><apply id="S3.I2.ix1.p1.1.m1.1.1.cmml" xref="S3.I2.ix1.p1.1.m1.1.1"><leq id="S3.I2.ix1.p1.1.m1.1.1.1.cmml" xref="S3.I2.ix1.p1.1.m1.1.1.1"></leq><ci id="S3.I2.ix1.p1.1.m1.1.1.2.cmml" xref="S3.I2.ix1.p1.1.m1.1.1.2">𝑋</ci><ci id="S3.I2.ix1.p1.1.m1.1.1.3.cmml" xref="S3.I2.ix1.p1.1.m1.1.1.3">𝑌</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I2.ix1.p1.1.m1.1c">X\leq Y</annotation></semantics></math>. Since <math id="S3.I2.ix1.p1.2.m2.1" class="ltx_Math" alttext="\ell" display="inline"><semantics id="S3.I2.ix1.p1.2.m2.1a"><mi mathvariant="normal" id="S3.I2.ix1.p1.2.m2.1.1" xref="S3.I2.ix1.p1.2.m2.1.1.cmml">ℓ</mi><annotation-xml encoding="MathML-Content" id="S3.I2.ix1.p1.2.m2.1b"><ci id="S3.I2.ix1.p1.2.m2.1.1.cmml" xref="S3.I2.ix1.p1.2.m2.1.1">ℓ</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.I2.ix1.p1.2.m2.1c">\ell</annotation></semantics></math> is
non-decreasing, for any <math id="S3.I2.ix1.p1.3.m3.1" class="ltx_Math" alttext="w\in\mathbb{R}" display="inline"><semantics id="S3.I2.ix1.p1.3.m3.1a"><mrow id="S3.I2.ix1.p1.3.m3.1.1" xref="S3.I2.ix1.p1.3.m3.1.1.cmml"><mi id="S3.I2.ix1.p1.3.m3.1.1.2" xref="S3.I2.ix1.p1.3.m3.1.1.2.cmml">w</mi><mo id="S3.I2.ix1.p1.3.m3.1.1.1" xref="S3.I2.ix1.p1.3.m3.1.1.1.cmml">∈</mo><mi id="S3.I2.ix1.p1.3.m3.1.1.3" xref="S3.I2.ix1.p1.3.m3.1.1.3.cmml">ℝ</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.I2.ix1.p1.3.m3.1b"><apply id="S3.I2.ix1.p1.3.m3.1.1.cmml" xref="S3.I2.ix1.p1.3.m3.1.1"><in id="S3.I2.ix1.p1.3.m3.1.1.1.cmml" xref="S3.I2.ix1.p1.3.m3.1.1.1"></in><ci id="S3.I2.ix1.p1.3.m3.1.1.2.cmml" xref="S3.I2.ix1.p1.3.m3.1.1.2">𝑤</ci><ci id="S3.I2.ix1.p1.3.m3.1.1.3.cmml" xref="S3.I2.ix1.p1.3.m3.1.1.3">ℝ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I2.ix1.p1.3.m3.1c">w\in\mathbb{R}</annotation></semantics></math> one has
