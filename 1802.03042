SSSx3.p2.15.m15.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.2"></plus><apply id="S5.SS2.SSSx3.p2.15.m15.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.3"><minus id="S5.SS2.SSSx3.p2.15.m15.1.1.3.1.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.3.1"></minus><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.3.2.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.3.2">𝑞</ci><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.3.3.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.3.3">𝑍</ci></apply><apply id="S5.SS2.SSSx3.p2.15.m15.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.15.m15.1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1">subscript</csymbol><apply id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1"><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.1">⋅</ci><apply id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.2.3">𝜃</ci></apply><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.1.1.1.3">𝑆</ci></apply><ci id="S5.SS2.SSSx3.p2.15.m15.1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.15.m15.1.1.1.3">𝑇</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.15.m15.1c">q-Z+(\delta^{\theta}\cdot S)_{T}</annotation></semantics></math>, i.e. the hedging error from using
the optimal strategy associated to <math id="S5.SS2.SSSx3.p2.16.m16.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S5.SS2.SSSx3.p2.16.m16.1a"><mi id="S5.SS2.SSSx3.p2.16.m16.1.1" xref="S5.SS2.SSSx3.p2.16.m16.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.16.m16.1b"><ci id="S5.SS2.SSSx3.p2.16.m16.1.1.cmml" xref="S5.SS2.SSSx3.p2.16.m16.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.16.m16.1c">\rho</annotation></semantics></math>, but only charging the
risk-neutral price <math id="S5.SS2.SSSx3.p2.17.m17.1" class="ltx_Math" alttext="q" display="inline"><semantics id="S5.SS2.SSSx3.p2.17.m17.1a"><mi id="S5.SS2.SSSx3.p2.17.m17.1.1" xref="S5.SS2.SSSx3.p2.17.m17.1.1.cmml">q</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.17.m17.1b"><ci id="S5.SS2.SSSx3.p2.17.m17.1.1.cmml" xref="S5.SS2.SSSx3.p2.17.m17.1.1">𝑞</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.17.m17.1c">q</annotation></semantics></math>. This is shown in a histogram in
Figure <a href="#S5.F2" title="Figure 2 ‣ Results ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> for <math id="S5.SS2.SSSx3.p2.18.m18.1" class="ltx_Math" alttext="\alpha=0.5" display="inline"><semantics id="S5.SS2.SSSx3.p2.18.m18.1a"><mrow id="S5.SS2.SSSx3.p2.18.m18.1.1" xref="S5.SS2.SSSx3.p2.18.m18.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.18.m18.1.1.2" xref="S5.SS2.SSSx3.p2.18.m18.1.1.2.cmml">α</mi><mo id="S5.SS2.SSSx3.p2.18.m18.1.1.1" xref="S5.SS2.SSSx3.p2.18.m18.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p2.18.m18.1.1.3" xref="S5.SS2.SSSx3.p2.18.m18.1.1.3.cmml">0.5</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.18.m18.1b"><apply id="S5.SS2.SSSx3.p2.18.m18.1.1.cmml" xref="S5.SS2.SSSx3.p2.18.m18.1.1"><eq id="S5.SS2.SSSx3.p2.18.m18.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.18.m18.1.1.1"></eq><ci id="S5.SS2.SSSx3.p2.18.m18.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.18.m18.1.1.2">𝛼</ci><cn type="float" id="S5.SS2.SSSx3.p2.18.m18.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.18.m18.1.1.3">0.5</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.18.m18.1c">\alpha=0.5</annotation></semantics></math>, yielding a risk-adjusted price
<math id="S5.SS2.SSSx3.p2.19.m19.1" class="ltx_Math" alttext="p^{\theta}_{0}=1.94" display="inline"><semantics id="S5.SS2.SSSx3.p2.19.m19.1a"><mrow id="S5.SS2.SSSx3.p2.19.m19.1.1" xref="S5.SS2.SSSx3.p2.19.m19.1.1.cmml"><msubsup id="S5.SS2.SSSx3.p2.19.m19.1.1.2" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.cmml"><mi id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.2" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.2.cmml">p</mi><mn id="S5.SS2.SSSx3.p2.19.m19.1.1.2.3" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.3.cmml">0</mn><mi id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.3" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.3.cmml">θ</mi></msubsup><mo id="S5.SS2.SSSx3.p2.19.m19.1.1.1" xref="S5.SS2.SSSx3.p2.19.m19.1.1.1.cmml">=</mo><mn id="S5.SS2.SSSx3.p2.19.m19.1.1.3" xref="S5.SS2.SSSx3.p2.19.m19.1.1.3.cmml">1.94</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.19.m19.1b"><apply id="S5.SS2.SSSx3.p2.19.m19.1.1.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1"><eq id="S5.SS2.SSSx3.p2.19.m19.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.1"></eq><apply id="S5.SS2.SSSx3.p2.19.m19.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.19.m19.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2">subscript</csymbol><apply id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.1.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.2.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.2">𝑝</ci><ci id="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.3.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.2.3">𝜃</ci></apply><cn type="integer" id="S5.SS2.SSSx3.p2.19.m19.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.2.3">0</cn></apply><cn type="float" id="S5.SS2.SSSx3.p2.19.m19.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.19.m19.1.1.3">1.94</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.19.m19.1c">p^{\theta}_{0}=1.94</annotation></semantics></math>. As one can see, the hedging performance of
<math id="S5.SS2.SSSx3.p2.20.m20.1" class="ltx_Math" alttext="\delta^{H}" display="inline"><semantics id="S5.SS2.SSSx3.p2.20.m20.1a"><msup id="S5.SS2.SSSx3.p2.20.m20.1.1" xref="S5.SS2.SSSx3.p2.20.m20.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.20.m20.1.1.2" xref="S5.SS2.SSSx3.p2.20.m20.1.1.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.20.m20.1.1.3" xref="S5.SS2.SSSx3.p2.20.m20.1.1.3.cmml">H</mi></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.20.m20.1b"><apply id="S5.SS2.SSSx3.p2.20.m20.1.1.cmml" xref="S5.SS2.SSSx3.p2.20.m20.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.20.m20.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.20.m20.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.20.m20.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.20.m20.1.1.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.20.m20.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.20.m20.1.1.3">𝐻</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.20.m20.1c">\delta^{H}</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p2.21.m21.1" class="ltx_Math" alttext="\delta^{\theta}" display="inline"><semantics id="S5.SS2.SSSx3.p2.21.m21.1a"><msup id="S5.SS2.SSSx3.p2.21.m21.1.1" xref="S5.SS2.SSSx3.p2.21.m21.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.21.m21.1.1.2" xref="S5.SS2.SSSx3.p2.21.m21.1.1.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.21.m21.1.1.3" xref="S5.SS2.SSSx3.p2.21.m21.1.1.3.cmml">θ</mi></msup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.21.m21.1b"><apply id="S5.SS2.SSSx3.p2.21.m21.1.1.cmml" xref="S5.SS2.SSSx3.p2.21.m21.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.21.m21.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.21.m21.1.1">superscript</csymbol><ci id="S5.SS2.SSSx3.p2.21.m21.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.21.m21.1.1.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.21.m21.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.21.m21.1.1.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.21.m21.1c">\delta^{\theta}</annotation></semantics></math> is very similar. In particular</p>
<ul id="S5.I2" class="ltx_itemize">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;">
<span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.3" class="ltx_p">for this choice of risk-preferences (<math id="S5.I2.i1.p1.1.m1.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S5.I2.i1.p1.1.m1.1a"><mi id="S5.I2.i1.p1.1.m1.1.1" xref="S5.I2.i1.p1.1.m1.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S5.I2.i1.p1.1.m1.1b"><ci id="S5.I2.i1.p1.1.m1.1.1.cmml" xref="S5.I2.i1.p1.1.m1.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.I2.i1.p1.1.m1.1c">\rho</annotation></semantics></math> as in
(<a href="#S5.E1" title="In 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>) with <math id="S5.I2.i1.p1.2.m2.1" class="ltx_Math" alttext="\alpha=0.5" display="inline"><semantics id="S5.I2.i1.p1.2.m2.1a"><mrow id="S5.I2.i1.p1.2.m2.1.1" xref="S5.I2.i1.p1.2.m2.1.1.cmml"><mi id="S5.I2.i1.p1.2.m2.1.1.2" xref="S5.I2.i1.p1.2.m2.1.1.2.cmml">α</mi><mo id="S5.I2.i1.p1.2.m2.1.1.1" xref="S5.I2.i1.p1.2.m2.1.1.1.cmml">=</mo><mn id="S5.I2.i1.p1.2.m2.1.1.3" xref="S5.I2.i1.p1.2.m2.1.1.3.cmml">0.5</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.I2.i1.p1.2.m2.1b"><apply id="S5.I2.i1.p1.2.m2.1.1.cmml" xref="S5.I2.i1.p1.2.m2.1.1"><eq id="S5.I2.i1.p1.2.m2.1.1.1.cmml" xref="S5.I2.i1.p1.2.m2.1.1.1"></eq><ci id="S5.I2.i1.p1.2.m2.1.1.2.cmml" xref="S5.I2.i1.p1.2.m2.1.1.2">𝛼</ci><cn type="float" id="S5.I2.i1.p1.2.m2.1.1.3.cmml" xref="S5.I2.i1.p1.2.m2.1.1.3">0.5</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.I2.i1.p1.2.m2.1c">\alpha=0.5</annotation></semantics></math>) the optimal strategy in
(<a href="#S3.E1" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>) is close to the model hedge <math id="S5.I2.i1.p1.3.m3.1" class="ltx_Math" alttext="\delta^{H}" display="inline"><semantics id="S5.I2.i1.p1.3.m3.1a"><msup id="S5.I2.i1.p1.3.m3.1.1" xref="S5.I2.i1.p1.3.m3.1.1.cmml"><mi id="S5.I2.i1.p1.3.m3.1.1.2" xref="S5.I2.i1.p1.3.m3.1.1.2.cmml">δ</mi><mi id="S5.I2.i1.p1.3.m3.1.1.3" xref="S5.I2.i1.p1.3.m3.1.1.3.cmml">H</mi></msup><annotation-xml encoding="MathML-Content" id="S5.I2.i1.p1.3.m3.1b"><apply id="S5.I2.i1.p1.3.m3.1.1.cmml" xref="S5.I2.i1.p1.3.m3.1.1"><csymbol cd="ambiguous" id="S5.I2.i1.p1.3.m3.1.1.1.cmml" xref="S5.I2.i1.p1.3.m3.1.1">superscript</csymbol><ci id="S5.I2.i1.p1.3.m3.1.1.2.cmml" xref="S5.I2.i1.p1.3.m3.1.1.2">𝛿</ci><ci id="S5.I2.i1.p1.3.m3.1.1.3.cmml" xref="S5.I2.i1.p1.3.m3.1.1.3">𝐻</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.I2.i1.p1.3.m3.1c">\delta^{H}</annotation></semantics></math>,</p>
</div>
</li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;">
<span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p">the neural network strategy <math id="S5.I2.i2.p1.1.m1.1" class="ltx_Math" alttext="\delta^{\theta}" display="inline"><semantics id="S5.I2.i2.p1.1.m1.1a"><msup id="S5.I2.i2.p1.1.m1.1.1" xref="S5.I2.i2.p1.1.m1.1.1.cmml"><mi id="S5.I2.i2.p1.1.m1.1.1.2" xref="S5.I2.i2.p1.1.m1.1.1.2.cmml">δ</mi><mi id="S5.I2.i2.p1.1.m1.1.1.3" xref="S5.I2.i2.p1.1.m1.1.1.3.cmml">θ</mi></msup><annotation-xml encoding="MathML-Content" id="S5.I2.i2.p1.1.m1.1b"><apply id="S5.I2.i2.p1.1.m1.1.1.cmml" xref="S5.I2.i2.p1.1.m1.1.1"><csymbol cd="ambiguous" id="S5.I2.i2.p1.1.m1.1.1.1.cmml" xref="S5.I2.i2.p1.1.m1.1.1">superscript</csymbol><ci id="S5.I2.i2.p1.1.m1.1.1.2.cmml" xref="S5.I2.i2.p1.1.m1.1.1.2">𝛿</ci><ci id="S5.I2.i2.p1.1.m1.1.1.3.cmml" xref="S5.I2.i2.p1.1.m1.1.1.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.I2.i2.p1.1.m1.1c">\delta^{\theta}</annotation></semantics></math> is able to
approximate well the optimal strategy in (<a href="#S3.E1" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>).</p>
</div>
</li>
</ul>
<p id="S5.SS2.SSSx3.p2.28" class="ltx_p">This is also illustrated by Figure <a href="#S5.F3" title="Figure 3 ‣ Results ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, where the strategies
<math id="S5.SS2.SSSx3.p2.22.m1.1" class="ltx_Math" alttext="\delta_{t}^{\theta}" display="inline"><semantics id="S5.SS2.SSSx3.p2.22.m1.1a"><msubsup id="S5.SS2.SSSx3.p2.22.m1.1.1" xref="S5.SS2.SSSx3.p2.22.m1.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.22.m1.1.1.2.2" xref="S5.SS2.SSSx3.p2.22.m1.1.1.2.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.22.m1.1.1.2.3" xref="S5.SS2.SSSx3.p2.22.m1.1.1.2.3.cmml">t</mi><mi id="S5.SS2.SSSx3.p2.22.m1.1.1.3" xref="S5.SS2.SSSx3.p2.22.m1.1.1.3.cmml">θ</mi></msubsup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.22.m1.1b"><apply id="S5.SS2.SSSx3.p2.22.m1.1.1.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.22.m1.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1">superscript</csymbol><apply id="S5.SS2.SSSx3.p2.22.m1.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.22.m1.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1">subscript</csymbol><ci id="S5.SS2.SSSx3.p2.22.m1.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1.2.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.22.m1.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1.2.3">𝑡</ci></apply><ci id="S5.SS2.SSSx3.p2.22.m1.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.22.m1.1.1.3">𝜃</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.22.m1.1c">\delta_{t}^{\theta}</annotation></semantics></math> and <math id="S5.SS2.SSSx3.p2.23.m2.1" class="ltx_Math" alttext="\delta_{t}^{H}" display="inline"><semantics id="S5.SS2.SSSx3.p2.23.m2.1a"><msubsup id="S5.SS2.SSSx3.p2.23.m2.1.1" xref="S5.SS2.SSSx3.p2.23.m2.1.1.cmml"><mi id="S5.SS2.SSSx3.p2.23.m2.1.1.2.2" xref="S5.SS2.SSSx3.p2.23.m2.1.1.2.2.cmml">δ</mi><mi id="S5.SS2.SSSx3.p2.23.m2.1.1.2.3" xref="S5.SS2.SSSx3.p2.23.m2.1.1.2.3.cmml">t</mi><mi id="S5.SS2.SSSx3.p2.23.m2.1.1.3" xref="S5.SS2.SSSx3.p2.23.m2.1.1.3.cmml">H</mi></msubsup><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.23.m2.1b"><apply id="S5.SS2.SSSx3.p2.23.m2.1.1.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.23.m2.1.1.1.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1">superscript</csymbol><apply id="S5.SS2.SSSx3.p2.23.m2.1.1.2.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1"><csymbol cd="ambiguous" id="S5.SS2.SSSx3.p2.23.m2.1.1.2.1.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1">subscript</csymbol><ci id="S5.SS2.SSSx3.p2.23.m2.1.1.2.2.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1.2.2">𝛿</ci><ci id="S5.SS2.SSSx3.p2.23.m2.1.1.2.3.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1.2.3">𝑡</ci></apply><ci id="S5.SS2.SSSx3.p2.23.m2.1.1.3.cmml" xref="S5.SS2.SSSx3.p2.23.m2.1.1.3">𝐻</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.23.m2.1c">\delta_{t}^{H}</annotation></semantics></math> at a fixed time-point <math id="S5.SS2.SSSx3.p2.24.m3.1" class="ltx_Math" alttext="t" display="inline"><semantics id="S5.SS2.SSSx3.p2.24.m3.1a"><mi id="S5.SS2.SSSx3.p2.24.m3.1.1" xref="S5.SS2.SSSx3.p2.24.m3.1.1.cmml">t</mi><annotation-xml encoding="MathML-Content" id="S5.SS2.SSSx3.p2.24.m3.1b"><ci id="S5.SS2.SSSx3.p2.24.m3.1.1.cmml" xref="S5.SS2.SSSx3.p2.24.m3.1.1">𝑡</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.SSSx3.p2.24.m3.1c">t</annotation></semantics></math> are
