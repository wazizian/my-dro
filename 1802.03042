 id="S3.Thmtheorem8.p1.3.m3.1.1" xref="S3.Thmtheorem8.p1.3.m3.1.1.cmml"><mi id="S3.Thmtheorem8.p1.3.m3.1.1.2" xref="S3.Thmtheorem8.p1.3.m3.1.1.2.cmml">x</mi><mo id="S3.Thmtheorem8.p1.3.m3.1.1.1" xref="S3.Thmtheorem8.p1.3.m3.1.1.1.cmml">∈</mo><mi id="S3.Thmtheorem8.p1.3.m3.1.1.3" xref="S3.Thmtheorem8.p1.3.m3.1.1.3.cmml">ℝ</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem8.p1.3.m3.1b"><apply id="S3.Thmtheorem8.p1.3.m3.1.1.cmml" xref="S3.Thmtheorem8.p1.3.m3.1.1"><in id="S3.Thmtheorem8.p1.3.m3.1.1.1.cmml" xref="S3.Thmtheorem8.p1.3.m3.1.1.1"></in><ci id="S3.Thmtheorem8.p1.3.m3.1.1.2.cmml" xref="S3.Thmtheorem8.p1.3.m3.1.1.2">𝑥</ci><ci id="S3.Thmtheorem8.p1.3.m3.1.1.3.cmml" xref="S3.Thmtheorem8.p1.3.m3.1.1.3">ℝ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem8.p1.3.m3.1c">x\in\mathbb{R}</annotation></semantics></math>. Then the optimization problem in (<a href="#S3.E5" title="In 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>) can be solved
explicitly and the minimizer <math id="S3.Thmtheorem8.p1.4.m4.1" class="ltx_Math" alttext="w^{*}" display="inline"><semantics id="S3.Thmtheorem8.p1.4.m4.1a"><msup id="S3.Thmtheorem8.p1.4.m4.1.1" xref="S3.Thmtheorem8.p1.4.m4.1.1.cmml"><mi id="S3.Thmtheorem8.p1.4.m4.1.1.2" xref="S3.Thmtheorem8.p1.4.m4.1.1.2.cmml">w</mi><mo id="S3.Thmtheorem8.p1.4.m4.1.1.3" xref="S3.Thmtheorem8.p1.4.m4.1.1.3.cmml">∗</mo></msup><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem8.p1.4.m4.1b"><apply id="S3.Thmtheorem8.p1.4.m4.1.1.cmml" xref="S3.Thmtheorem8.p1.4.m4.1.1"><csymbol cd="ambiguous" id="S3.Thmtheorem8.p1.4.m4.1.1.1.cmml" xref="S3.Thmtheorem8.p1.4.m4.1.1">superscript</csymbol><ci id="S3.Thmtheorem8.p1.4.m4.1.1.2.cmml" xref="S3.Thmtheorem8.p1.4.m4.1.1.2">𝑤</ci><times id="S3.Thmtheorem8.p1.4.m4.1.1.3.cmml" xref="S3.Thmtheorem8.p1.4.m4.1.1.3"></times></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem8.p1.4.m4.1c">w^{*}</annotation></semantics></math> satisfies
