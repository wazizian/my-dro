its constrained “projection” into <math id="S2.SS0.SSSx2.p3.3.m3.1" class="ltx_Math" alttext="\mathcal{H}_{k}" display="inline"><semantics id="S2.SS0.SSSx2.p3.3.m3.1a"><msub id="S2.SS0.SSSx2.p3.3.m3.1.1" xref="S2.SS0.SSSx2.p3.3.m3.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS0.SSSx2.p3.3.m3.1.1.2" xref="S2.SS0.SSSx2.p3.3.m3.1.1.2.cmml">ℋ</mi><mi id="S2.SS0.SSSx2.p3.3.m3.1.1.3" xref="S2.SS0.SSSx2.p3.3.m3.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p3.3.m3.1b"><apply id="S2.SS0.SSSx2.p3.3.m3.1.1.cmml" xref="S2.SS0.SSSx2.p3.3.m3.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p3.3.m3.1.1.1.cmml" xref="S2.SS0.SSSx2.p3.3.m3.1.1">subscript</csymbol><ci id="S2.SS0.SSSx2.p3.3.m3.1.1.2.cmml" xref="S2.SS0.SSSx2.p3.3.m3.1.1.2">ℋ</ci><ci id="S2.SS0.SSSx2.p3.3.m3.1.1.3.cmml" xref="S2.SS0.SSSx2.p3.3.m3.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p3.3.m3.1c">\mathcal{H}_{k}</annotation></semantics></math>.
