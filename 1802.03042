uperscript</csymbol><apply id="S4.SS2.p3.5.m1.3.4.3.1.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1"><csymbol cd="ambiguous" id="S4.SS2.p3.5.m1.3.4.3.1.2.1.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1">subscript</csymbol><csymbol cd="latexml" id="S4.SS2.p3.5.m1.3.4.3.1.2.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.2.2">product</csymbol><apply id="S4.SS2.p3.5.m1.3.4.3.1.2.3.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.2.3"><eq id="S4.SS2.p3.5.m1.3.4.3.1.2.3.1.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.2.3.1"></eq><ci id="S4.SS2.p3.5.m1.3.4.3.1.2.3.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.2.3.2">𝑘</ci><cn type="integer" id="S4.SS2.p3.5.m1.3.4.3.1.2.3.3.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.2.3.3">0</cn></apply></apply><apply id="S4.SS2.p3.5.m1.3.4.3.1.3.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.3"><minus id="S4.SS2.p3.5.m1.3.4.3.1.3.1.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.3.1"></minus><ci id="S4.SS2.p3.5.m1.3.4.3.1.3.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.3.2">𝑛</ci><cn type="integer" id="S4.SS2.p3.5.m1.3.4.3.1.3.3.cmml" xref="S4.SS2.p3.5.m1.3.4.3.1.3.3">1</cn></apply></apply><apply id="S4.SS2.p3.5.m1.3.4.3.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.2"><csymbol cd="ambiguous" id="S4.SS2.p3.5.m1.3.4.3.2.1.cmml" xref="S4.SS2.p3.5.m1.3.4.3.2">subscript</csymbol><ci id="S4.SS2.p3.5.m1.3.4.3.2.2.cmml" xref="S4.SS2.p3.5.m1.3.4.3.2.2">Θ</ci><list id="S4.SS2.p3.5.m1.3.3.3.4.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3"><ci id="S4.SS2.p3.5.m1.1.1.1.1.cmml" xref="S4.SS2.p3.5.m1.1.1.1.1">𝑀</ci><apply id="S4.SS2.p3.5.m1.3.3.3.3.1.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1"><plus id="S4.SS2.p3.5.m1.3.3.3.3.1.2.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.2"></plus><apply id="S4.SS2.p3.5.m1.3.3.3.3.1.1.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1"><times id="S4.SS2.p3.5.m1.3.3.3.3.1.1.2.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.2"></times><ci id="S4.SS2.p3.5.m1.3.3.3.3.1.1.3.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.3">𝑟</ci><apply id="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1"><plus id="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.1.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.1"></plus><ci id="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.2.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.2">𝑘</ci><cn type="integer" id="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.3.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.1.1.1.1.3">1</cn></apply></apply><ci id="S4.SS2.p3.5.m1.3.3.3.3.1.3.cmml" xref="S4.SS2.p3.5.m1.3.3.3.3.1.3">𝑑</ci></apply><ci id="S4.SS2.p3.5.m1.2.2.2.2.cmml" xref="S4.SS2.p3.5.m1.2.2.2.2">𝑑</ci></list></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.p3.5.m1.3c">\Theta_{M}=\prod_{k=0}^{n-1}\Theta_{M,r(k+1)+d,d}</annotation></semantics></math>. Thus, the
infinite-dimensional problem of finding an optimal hedging strategy is
reduced to the finite-dimensional constraint problem of finding optimal
parameters for our neural network.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.1.1.1" class="ltx_text ltx_font_italic">Remark 4.5</span></span><span id="S4.Thmtheorem5.2.2" class="ltx_text ltx_font_italic">.</span>
</h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.3" class="ltx_p">Our setup becomes truly “recurrent” if we enforce <math id="S4.Thmtheorem5.p1.1.m1.1" class="ltx_Math" alttext="\theta^{k}=\theta^{0}" display="inline"><semantics id="S4.Thmtheorem5.p1.1.m1.1a"><mrow id="S4.Thmtheorem5.p1.1.m1.1.1" xref="S4.Thmtheorem5.p1.1.m1.1.1.cmml"><msup id="S4.Thmtheorem5.p1.1.m1.1.1.2" xref="S4.Thmtheorem5.p1.1.m1.1.1.2.cmml"><mi id="S4.Thmtheorem5.p1.1.m1.1.1.2.2" xref="S4.Thmtheorem5.p1.1.m1.1.1.2.2.cmml">θ</mi><mi id="S4.Thmtheorem5.p1.1.m1.1.1.2.3" xref="S4.Thmtheorem5.p1.1.m1.1.1.2.3.cmml">k</mi></msup><mo id="S4.Thmtheorem5.p1.1.m1.1.1.1" xref="S4.Thmtheorem5.p1.1.m1.1.1.1.cmml">=</mo><msup id="S4.Thmtheorem5.p1.1.m1.1.1.3" xref="S4.Thmtheorem5.p1.1.m1.1.1.3.cmml"><mi id="S4.Thmtheorem5.p1.1.m1.1.1.3.2" xref="S4.Thmtheorem5.p1.1.m1.1.1.3.2.cmml">θ</mi><mn id="S4.Thmtheorem5.p1.1.m1.1.1.3.3" xref="S4.Thmtheorem5.p1.1.m1.1.1.3.3.cmml">0</mn></msup></mrow><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem5.p1.1.m1.1b"><apply id="S4.Thmtheorem5.p1.1.m1.1.1.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1"><eq id="S4.Thmtheorem5.p1.1.m1.1.1.1.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.1"></eq><apply id="S4.Thmtheorem5.p1.1.m1.1.1.2.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.2"><csymbol cd="ambiguous" id="S4.Thmtheorem5.p1.1.m1.1.1.2.1.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.2">superscript</csymbol><ci id="S4.Thmtheorem5.p1.1.m1.1.1.2.2.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.2.2">𝜃</ci><ci id="S4.Thmtheorem5.p1.1.m1.1.1.2.3.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.2.3">𝑘</ci></apply><apply id="S4.Thmtheorem5.p1.1.m1.1.1.3.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.3"><csymbol cd="ambiguous" id="S4.Thmtheorem5.p1.1.m1.1.1.3.1.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.3">superscript</csymbol><ci id="S4.Thmtheorem5.p1.1.m1.1.1.3.2.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.3.2">𝜃</ci><cn type="integer" id="S4.Thmtheorem5.p1.1.m1.1.1.3.3.cmml" xref="S4.Thmtheorem5.p1.1.m1.1.1.3.3">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem5.p1.1.m1.1c">\theta^{k}=\theta^{0}</annotation></semantics></math> for all <math id="S4.Thmtheorem5.p1.2.m2.1" class="ltx_Math" alttext="k" display="inline"><semantics id="S4.Thmtheorem5.p1.2.m2.1a"><mi id="S4.Thmtheorem5.p1.2.m2.1.1" xref="S4.Thmtheorem5.p1.2.m2.1.1.cmml">k</mi><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem5.p1.2.m2.1b"><ci id="S4.Thmtheorem5.p1.2.m2.1.1.cmml" xref="S4.Thmtheorem5.p1.2.m2.1.1">𝑘</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem5.p1.2.m2.1c">k</annotation></semantics></math> and add “<math id="S4.Thmtheorem5.p1.3.m3.1" class="ltx_Math" alttext="k" display="inline"><semantics id="S4.Thmtheorem5.p1.3.m3.1a"><mi id="S4.Thmtheorem5.p1.3.m3.1.1" xref="S4.Thmtheorem5.p1.3.m3.1.1.cmml">k</mi><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem5.p1.3.m3.1b"><ci id="S4.Thmtheorem5.p1.3.m3.1.1.cmml" xref="S4.Thmtheorem5.p1.3.m3.1.1">𝑘</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem5.p1.3.m3.1c">k</annotation></semantics></math>”
as a parameter into the network. Below proof applies with few modifications.</p>
</div>
</div>
<div id="S4.Thmtheorem6" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem6.1.1.1" class="ltx_text ltx_font_italic">Remark 4.6</span></span><span id="S4.Thmtheorem6.2.2" class="ltx_text ltx_font_italic">.</span>
</h6>
<div id="S4.Thmtheorem6.p1" class="ltx_para">
<p id="S4.Thmtheorem6.p1.6" class="ltx_p">If <math id="S4.Thmtheorem6.p1.1.m1.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S4.Thmtheorem6.p1.1.m1.1a"><mi id="S4.Thmtheorem6.p1.1.m1.1.1" xref="S4.Thmtheorem6.p1.1.m1.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem6.p1.1.m1.1b"><ci id="S4.Thmtheorem6.p1.1.m1.1.1.cmml" xref="S4.Thmtheorem6.p1.1.m1.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem6.p1.1.m1.1c">S</annotation></semantics></math> is an <math id="S4.Thmtheorem6.p1.2.m2.2" class="ltx_Math" alttext="(\mathbb{F},\mathbb{P})" display="inline"><semantics id="S4.Thmtheorem6.p1.2.m2.2a"><mrow id="S4.Thmtheorem6.p1.2.m2.2.3.2" xref="S4.Thmtheorem6.p1.2.m2.2.3.1.cmml"><mo stretchy="false" id="S4.Thmtheorem6.p1.2.m2.2.3.2.1" xref="S4.Thmtheorem6.p1.2.m2.2.3.1.cmml">(</mo><mi id="S4.Thmtheorem6.p1.2.m2.1.1" xref="S4.Thmtheorem6.p1.2.m2.1.1.cmml">𝔽</mi><mo id="S4.Thmtheorem6.p1.2.m2.2.3.2.2" xref="S4.Thmtheorem6.p1.2.m2.2.3.1.cmml">,</mo><mi id="S4.Thmtheorem6.p1.2.m2.2.2" xref="S4.Thmtheorem6.p1.2.m2.2.2.cmml">ℙ</mi><mo stretchy="false" id="S4.Thmtheorem6.p1.2.m2.2.3.2.3" xref="S4.Thmtheorem6.p1.2.m2.2.3.1.cmml">)</mo></mrow><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem6.p1.2.m2.2b"><interval closure="open" id="S4.Thmtheorem6.p1.2.m2.2.3.1.cmml" xref="S4.Thmtheorem6.p1.2.m2.2.3.2"><ci id="S4.Thmtheorem6.p1.2.m2.1.1.cmml" xref="S4.Thmtheorem6.p1.2.m2.1.1">𝔽</ci><ci id="S4.Thmtheorem6.p1.2.m2.2.2.cmml" xref="S4.Thmtheorem6.p1.2.m2.2.2">ℙ</ci></interval></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem6.p1.2.m2.2c">(\mathbb{F},\mathbb{P})</annotation></semantics></math>-Markov process
