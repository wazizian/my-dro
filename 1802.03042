<p id="S4.SS2.7.p6.8" class="ltx_p">Since <math id="S4.SS2.7.p6.1.m1.1" class="ltx_Math" alttext="\Omega" display="inline"><semantics id="S4.SS2.7.p6.1.m1.1a"><mi mathvariant="normal" id="S4.SS2.7.p6.1.m1.1.1" xref="S4.SS2.7.p6.1.m1.1.1.cmml">Ω</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.1.m1.1b"><ci id="S4.SS2.7.p6.1.m1.1.1.cmml" xref="S4.SS2.7.p6.1.m1.1.1">Ω</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.1.m1.1c">\Omega</annotation></semantics></math> is finite, <math id="S4.SS2.7.p6.2.m2.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S4.SS2.7.p6.2.m2.1a"><mi id="S4.SS2.7.p6.2.m2.1.1" xref="S4.SS2.7.p6.2.m2.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.2.m2.1b"><ci id="S4.SS2.7.p6.2.m2.1.1.cmml" xref="S4.SS2.7.p6.2.m2.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.2.m2.1c">\rho</annotation></semantics></math> can be viewed as a convex function <math id="S4.SS2.7.p6.3.m3.1" class="ltx_Math" alttext="\rho\colon\mathbb{R}^{N}\to\mathbb{R}" display="inline"><semantics id="S4.SS2.7.p6.3.m3.1a"><mrow id="S4.SS2.7.p6.3.m3.1.1" xref="S4.SS2.7.p6.3.m3.1.1.cmml"><mi id="S4.SS2.7.p6.3.m3.1.1.2" xref="S4.SS2.7.p6.3.m3.1.1.2.cmml">ρ</mi><mo lspace="0.278em" rspace="0.278em" id="S4.SS2.7.p6.3.m3.1.1.1" xref="S4.SS2.7.p6.3.m3.1.1.1.cmml">:</mo><mrow id="S4.SS2.7.p6.3.m3.1.1.3" xref="S4.SS2.7.p6.3.m3.1.1.3.cmml"><msup id="S4.SS2.7.p6.3.m3.1.1.3.2" xref="S4.SS2.7.p6.3.m3.1.1.3.2.cmml"><mi id="S4.SS2.7.p6.3.m3.1.1.3.2.2" xref="S4.SS2.7.p6.3.m3.1.1.3.2.2.cmml">ℝ</mi><mi id="S4.SS2.7.p6.3.m3.1.1.3.2.3" xref="S4.SS2.7.p6.3.m3.1.1.3.2.3.cmml">N</mi></msup><mo stretchy="false" id="S4.SS2.7.p6.3.m3.1.1.3.1" xref="S4.SS2.7.p6.3.m3.1.1.3.1.cmml">→</mo><mi id="S4.SS2.7.p6.3.m3.1.1.3.3" xref="S4.SS2.7.p6.3.m3.1.1.3.3.cmml">ℝ</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.3.m3.1b"><apply id="S4.SS2.7.p6.3.m3.1.1.cmml" xref="S4.SS2.7.p6.3.m3.1.1"><ci id="S4.SS2.7.p6.3.m3.1.1.1.cmml" xref="S4.SS2.7.p6.3.m3.1.1.1">:</ci><ci id="S4.SS2.7.p6.3.m3.1.1.2.cmml" xref="S4.SS2.7.p6.3.m3.1.1.2">𝜌</ci><apply id="S4.SS2.7.p6.3.m3.1.1.3.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3"><ci id="S4.SS2.7.p6.3.m3.1.1.3.1.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.1">→</ci><apply id="S4.SS2.7.p6.3.m3.1.1.3.2.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.2"><csymbol cd="ambiguous" id="S4.SS2.7.p6.3.m3.1.1.3.2.1.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.2">superscript</csymbol><ci id="S4.SS2.7.p6.3.m3.1.1.3.2.2.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.2.2">ℝ</ci><ci id="S4.SS2.7.p6.3.m3.1.1.3.2.3.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.2.3">𝑁</ci></apply><ci id="S4.SS2.7.p6.3.m3.1.1.3.3.cmml" xref="S4.SS2.7.p6.3.m3.1.1.3.3">ℝ</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.3.m3.1c">\rho\colon\mathbb{R}^{N}\to\mathbb{R}</annotation></semantics></math>. In particular, <math id="S4.SS2.7.p6.4.m4.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S4.SS2.7.p6.4.m4.1a"><mi id="S4.SS2.7.p6.4.m4.1.1" xref="S4.SS2.7.p6.4.m4.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.4.m4.1b"><ci id="S4.SS2.7.p6.4.m4.1.1.cmml" xref="S4.SS2.7.p6.4.m4.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.4.m4.1c">\rho</annotation></semantics></math> is continuous. Using
continuity of <math id="S4.SS2.7.p6.5.m5.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S4.SS2.7.p6.5.m5.1a"><mi id="S4.SS2.7.p6.5.m5.1.1" xref="S4.SS2.7.p6.5.m5.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.5.m5.1b"><ci id="S4.SS2.7.p6.5.m5.1.1.cmml" xref="S4.SS2.7.p6.5.m5.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.5.m5.1c">\rho</annotation></semantics></math> in the first step and upper semi-continuity of <math id="S4.SS2.7.p6.6.m6.2" class="ltx_Math" alttext="c_{k}(\cdot)(\omega)" display="inline"><semantics id="S4.SS2.7.p6.6.m6.2a"><mrow id="S4.SS2.7.p6.6.m6.2.3" xref="S4.SS2.7.p6.6.m6.2.3.cmml"><msub id="S4.SS2.7.p6.6.m6.2.3.2" xref="S4.SS2.7.p6.6.m6.2.3.2.cmml"><mi id="S4.SS2.7.p6.6.m6.2.3.2.2" xref="S4.SS2.7.p6.6.m6.2.3.2.2.cmml">c</mi><mi id="S4.SS2.7.p6.6.m6.2.3.2.3" xref="S4.SS2.7.p6.6.m6.2.3.2.3.cmml">k</mi></msub><mo lspace="0em" rspace="0em" id="S4.SS2.7.p6.6.m6.2.3.1" xref="S4.SS2.7.p6.6.m6.2.3.1.cmml">​</mo><mrow id="S4.SS2.7.p6.6.m6.2.3.3.2" xref="S4.SS2.7.p6.6.m6.2.3.cmml"><mo stretchy="false" id="S4.SS2.7.p6.6.m6.2.3.3.2.1" xref="S4.SS2.7.p6.6.m6.2.3.cmml">(</mo><mo lspace="0em" rspace="0em" id="S4.SS2.7.p6.6.m6.1.1" xref="S4.SS2.7.p6.6.m6.1.1.cmml">⋅</mo><mo stretchy="false" id="S4.SS2.7.p6.6.m6.2.3.3.2.2" xref="S4.SS2.7.p6.6.m6.2.3.cmml">)</mo></mrow><mo lspace="0em" rspace="0em" id="S4.SS2.7.p6.6.m6.2.3.1a" xref="S4.SS2.7.p6.6.m6.2.3.1.cmml">​</mo><mrow id="S4.SS2.7.p6.6.m6.2.3.4.2" xref="S4.SS2.7.p6.6.m6.2.3.cmml"><mo stretchy="false" id="S4.SS2.7.p6.6.m6.2.3.4.2.1" xref="S4.SS2.7.p6.6.m6.2.3.cmml">(</mo><mi id="S4.SS2.7.p6.6.m6.2.2" xref="S4.SS2.7.p6.6.m6.2.2.cmml">ω</mi><mo stretchy="false" id="S4.SS2.7.p6.6.m6.2.3.4.2.2" xref="S4.SS2.7.p6.6.m6.2.3.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.6.m6.2b"><apply id="S4.SS2.7.p6.6.m6.2.3.cmml" xref="S4.SS2.7.p6.6.m6.2.3"><times id="S4.SS2.7.p6.6.m6.2.3.1.cmml" xref="S4.SS2.7.p6.6.m6.2.3.1"></times><apply id="S4.SS2.7.p6.6.m6.2.3.2.cmml" xref="S4.SS2.7.p6.6.m6.2.3.2"><csymbol cd="ambiguous" id="S4.SS2.7.p6.6.m6.2.3.2.1.cmml" xref="S4.SS2.7.p6.6.m6.2.3.2">subscript</csymbol><ci id="S4.SS2.7.p6.6.m6.2.3.2.2.cmml" xref="S4.SS2.7.p6.6.m6.2.3.2.2">𝑐</ci><ci id="S4.SS2.7.p6.6.m6.2.3.2.3.cmml" xref="S4.SS2.7.p6.6.m6.2.3.2.3">𝑘</ci></apply><ci id="S4.SS2.7.p6.6.m6.1.1.cmml" xref="S4.SS2.7.p6.6.m6.1.1">⋅</ci><ci id="S4.SS2.7.p6.6.m6.2.2.cmml" xref="S4.SS2.7.p6.6.m6.2.2">𝜔</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.6.m6.2c">c_{k}(\cdot)(\omega)</annotation></semantics></math> for each <math id="S4.SS2.7.p6.7.m7.1" class="ltx_Math" alttext="\omega\in\Omega" display="inline"><semantics id="S4.SS2.7.p6.7.m7.1a"><mrow id="S4.SS2.7.p6.7.m7.1.1" xref="S4.SS2.7.p6.7.m7.1.1.cmml"><mi id="S4.SS2.7.p6.7.m7.1.1.2" xref="S4.SS2.7.p6.7.m7.1.1.2.cmml">ω</mi><mo id="S4.SS2.7.p6.7.m7.1.1.1" xref="S4.SS2.7.p6.7.m7.1.1.1.cmml">∈</mo><mi mathvariant="normal" id="S4.SS2.7.p6.7.m7.1.1.3" xref="S4.SS2.7.p6.7.m7.1.1.3.cmml">Ω</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.7.m7.1b"><apply id="S4.SS2.7.p6.7.m7.1.1.cmml" xref="S4.SS2.7.p6.7.m7.1.1"><in id="S4.SS2.7.p6.7.m7.1.1.1.cmml" xref="S4.SS2.7.p6.7.m7.1.1.1"></in><ci id="S4.SS2.7.p6.7.m7.1.1.2.cmml" xref="S4.SS2.7.p6.7.m7.1.1.2">𝜔</ci><ci id="S4.SS2.7.p6.7.m7.1.1.3.cmml" xref="S4.SS2.7.p6.7.m7.1.1.3">Ω</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.7.m7.1c">\omega\in\Omega</annotation></semantics></math> combined with monotonicity of <math id="S4.SS2.7.p6.8.m8.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S4.SS2.7.p6.8.m8.1a"><mi id="S4.SS2.7.p6.8.m8.1.1" xref="S4.SS2.7.p6.8.m8.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S4.SS2.7.p6.8.m8.1b"><ci id="S4.SS2.7.p6.8.m8.1.1.cmml" xref="S4.SS2.7.p6.8.m8.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS2.7.p6.8.m8.1c">\rho</annotation></semantics></math> in the second step, one obtains</p>
