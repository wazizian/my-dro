<h6 class="ltx_title ltx_runin ltx_title_theorem">
<span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem9.1.1.1" class="ltx_text ltx_font_bold">Proposition 4.9</span></span><span id="S4.Thmtheorem9.2.2" class="ltx_text ltx_font_bold">.</span>
</h6>
<div id="S4.Thmtheorem9.p1" class="ltx_para">
<p id="S4.Thmtheorem9.p1.3" class="ltx_p"><span id="S4.Thmtheorem9.p1.3.3" class="ltx_text ltx_font_italic">Define <math id="S4.Thmtheorem9.p1.1.1.m1.1" class="ltx_Math" alttext="\mathcal{H}_{M}" display="inline"><semantics id="S4.Thmtheorem9.p1.1.1.m1.1a"><msub id="S4.Thmtheorem9.p1.1.1.m1.1.1" xref="S4.Thmtheorem9.p1.1.1.m1.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.Thmtheorem9.p1.1.1.m1.1.1.2" xref="S4.Thmtheorem9.p1.1.1.m1.1.1.2.cmml">ℋ</mi><mi id="S4.Thmtheorem9.p1.1.1.m1.1.1.3" xref="S4.Thmtheorem9.p1.1.1.m1.1.1.3.cmml">M</mi></msub><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem9.p1.1.1.m1.1b"><apply id="S4.Thmtheorem9.p1.1.1.m1.1.1.cmml" xref="S4.Thmtheorem9.p1.1.1.m1.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem9.p1.1.1.m1.1.1.1.cmml" xref="S4.Thmtheorem9.p1.1.1.m1.1.1">subscript</csymbol><ci id="S4.Thmtheorem9.p1.1.1.m1.1.1.2.cmml" xref="S4.Thmtheorem9.p1.1.1.m1.1.1.2">ℋ</ci><ci id="S4.Thmtheorem9.p1.1.1.m1.1.1.3.cmml" xref="S4.Thmtheorem9.p1.1.1.m1.1.1.3">𝑀</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem9.p1.1.1.m1.1c">\mathcal{H}_{M}</annotation></semantics></math> as in
(<a href="#S4.E1" title="In 4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>) and <math id="S4.Thmtheorem9.p1.2.2.m2.1" class="ltx_Math" alttext="\pi^{M}" display="inline"><semantics id="S4.Thmtheorem9.p1.2.2.m2.1a"><msup id="S4.Thmtheorem9.p1.2.2.m2.1.1" xref="S4.Thmtheorem9.p1.2.2.m2.1.1.cmml"><mi id="S4.Thmtheorem9.p1.2.2.m2.1.1.2" xref="S4.Thmtheorem9.p1.2.2.m2.1.1.2.cmml">π</mi><mi id="S4.Thmtheorem9.p1.2.2.m2.1.1.3" xref="S4.Thmtheorem9.p1.2.2.m2.1.1.3.cmml">M</mi></msup><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem9.p1.2.2.m2.1b"><apply id="S4.Thmtheorem9.p1.2.2.m2.1.1.cmml" xref="S4.Thmtheorem9.p1.2.2.m2.1.1"><csymbol cd="ambiguous" id="S4.Thmtheorem9.p1.2.2.m2.1.1.1.cmml" xref="S4.Thmtheorem9.p1.2.2.m2.1.1">superscript</csymbol><ci id="S4.Thmtheorem9.p1.2.2.m2.1.1.2.cmml" xref="S4.Thmtheorem9.p1.2.2.m2.1.1.2">𝜋</ci><ci id="S4.Thmtheorem9.p1.2.2.m2.1.1.3.cmml" xref="S4.Thmtheorem9.p1.2.2.m2.1.1.3">𝑀</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem9.p1.2.2.m2.1c">\pi^{M}</annotation></semantics></math> as in
(<a href="#S4.Ex4" title="4.2. Optimal hedging using deep neural networks ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>). Then for any <math id="S4.Thmtheorem9.p1.3.3.m3.1" class="ltx_Math" alttext="X\in\mathcal{X}" display="inline"><semantics id="S4.Thmtheorem9.p1.3.3.m3.1a"><mrow id="S4.Thmtheorem9.p1.3.3.m3.1.1" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.cmml"><mi id="S4.Thmtheorem9.p1.3.3.m3.1.1.2" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.2.cmml">X</mi><mo id="S4.Thmtheorem9.p1.3.3.m3.1.1.1" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S4.Thmtheorem9.p1.3.3.m3.1.1.3" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.3.cmml">𝒳</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.Thmtheorem9.p1.3.3.m3.1b"><apply id="S4.Thmtheorem9.p1.3.3.m3.1.1.cmml" xref="S4.Thmtheorem9.p1.3.3.m3.1.1"><in id="S4.Thmtheorem9.p1.3.3.m3.1.1.1.cmml" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.1"></in><ci id="S4.Thmtheorem9.p1.3.3.m3.1.1.2.cmml" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.2">𝑋</ci><ci id="S4.Thmtheorem9.p1.3.3.m3.1.1.3.cmml" xref="S4.Thmtheorem9.p1.3.3.m3.1.1.3">𝒳</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.Thmtheorem9.p1.3.3.m3.1c">X\in\mathcal{X}</annotation></semantics></math>,</span></p>
