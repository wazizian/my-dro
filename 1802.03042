<times id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.1.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.1"></times><ci id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.2.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.2">𝔼</ci><apply id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.3.1.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.3.2"><csymbol cd="latexml" id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.3.1.1.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.2.3.2.1">delimited-[]</csymbol><ci id="S3.E7Xb.2.1.1.m1.3.3.cmml" xref="S3.E7Xb.2.1.1.m1.3.3">𝑍</ci></apply></apply><apply id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3"><times id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3.1.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3.1"></times><ci id="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3.2.cmml" xref="S3.E7Xb.2.1.1.m1.5.5.1.1.8.3.2">𝜌</ci><cn type="integer" id="S3.E7Xb.2.1.1.m1.4.4.cmml" xref="S3.E7Xb.2.1.1.m1.4.4">0</cn></apply></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.E7Xb.2.1.1.m1.5c">\displaystyle\geq\inf_{w\in\mathbb{R}}\left\{w+\ell(\mathbb{E}[Z]-w)\right\}=\rho(-\mathbb{E}[Z])=\mathbb{E}[Z]+\rho(0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
</tr>
</tbody>
</table>
<p id="S3.SS2.2.p1.11" class="ltx_p">Inserting <math id="S3.SS2.2.p1.10.m1.1" class="ltx_Math" alttext="Z=0" display="inline"><semantics id="S3.SS2.2.p1.10.m1.1a"><mrow id="S3.SS2.2.p1.10.m1.1.1" xref="S3.SS2.2.p1.10.m1.1.1.cmml"><mi id="S3.SS2.2.p1.10.m1.1.1.2" xref="S3.SS2.2.p1.10.m1.1.1.2.cmml">Z</mi><mo id="S3.SS2.2.p1.10.m1.1.1.1" xref="S3.SS2.2.p1.10.m1.1.1.1.cmml">=</mo><mn id="S3.SS2.2.p1.10.m1.1.1.3" xref="S3.SS2.2.p1.10.m1.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.10.m1.1b"><apply id="S3.SS2.2.p1.10.m1.1.1.cmml" xref="S3.SS2.2.p1.10.m1.1.1"><eq id="S3.SS2.2.p1.10.m1.1.1.1.cmml" xref="S3.SS2.2.p1.10.m1.1.1.1"></eq><ci id="S3.SS2.2.p1.10.m1.1.1.2.cmml" xref="S3.SS2.2.p1.10.m1.1.1.2">𝑍</ci><cn type="integer" id="S3.SS2.2.p1.10.m1.1.1.3.cmml" xref="S3.SS2.2.p1.10.m1.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.10.m1.1c">Z=0</annotation></semantics></math> yields the converse inequality <math id="S3.SS2.2.p1.11.m2.2" class="ltx_Math" alttext="\pi(0)\geq\rho(0)" display="inline"><semantics id="S3.SS2.2.p1.11.m2.2a"><mrow id="S3.SS2.2.p1.11.m2.2.3" xref="S3.SS2.2.p1.11.m2.2.3.cmml"><mrow id="S3.SS2.2.p1.11.m2.2.3.2" xref="S3.SS2.2.p1.11.m2.2.3.2.cmml"><mi id="S3.SS2.2.p1.11.m2.2.3.2.2" xref="S3.SS2.2.p1.11.m2.2.3.2.2.cmml">π</mi><mo lspace="0em" rspace="0em" id="S3.SS2.2.p1.11.m2.2.3.2.1" xref="S3.SS2.2.p1.11.m2.2.3.2.1.cmml">​</mo><mrow id="S3.SS2.2.p1.11.m2.2.3.2.3.2" xref="S3.SS2.2.p1.11.m2.2.3.2.cmml"><mo stretchy="false" id="S3.SS2.2.p1.11.m2.2.3.2.3.2.1" xref="S3.SS2.2.p1.11.m2.2.3.2.cmml">(</mo><mn id="S3.SS2.2.p1.11.m2.1.1" xref="S3.SS2.2.p1.11.m2.1.1.cmml">0</mn><mo stretchy="false" id="S3.SS2.2.p1.11.m2.2.3.2.3.2.2" xref="S3.SS2.2.p1.11.m2.2.3.2.cmml">)</mo></mrow></mrow><mo id="S3.SS2.2.p1.11.m2.2.3.1" xref="S3.SS2.2.p1.11.m2.2.3.1.cmml">≥</mo><mrow id="S3.SS2.2.p1.11.m2.2.3.3" xref="S3.SS2.2.p1.11.m2.2.3.3.cmml"><mi id="S3.SS2.2.p1.11.m2.2.3.3.2" xref="S3.SS2.2.p1.11.m2.2.3.3.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.SS2.2.p1.11.m2.2.3.3.1" xref="S3.SS2.2.p1.11.m2.2.3.3.1.cmml">​</mo><mrow id="S3.SS2.2.p1.11.m2.2.3.3.3.2" xref="S3.SS2.2.p1.11.m2.2.3.3.cmml"><mo stretchy="false" id="S3.SS2.2.p1.11.m2.2.3.3.3.2.1" xref="S3.SS2.2.p1.11.m2.2.3.3.cmml">(</mo><mn id="S3.SS2.2.p1.11.m2.2.2" xref="S3.SS2.2.p1.11.m2.2.2.cmml">0</mn><mo stretchy="false" id="S3.SS2.2.p1.11.m2.2.3.3.3.2.2" xref="S3.SS2.2.p1.11.m2.2.3.3.cmml">)</mo></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.SS2.2.p1.11.m2.2b"><apply id="S3.SS2.2.p1.11.m2.2.3.cmml" xref="S3.SS2.2.p1.11.m2.2.3"><geq id="S3.SS2.2.p1.11.m2.2.3.1.cmml" xref="S3.SS2.2.p1.11.m2.2.3.1"></geq><apply id="S3.SS2.2.p1.11.m2.2.3.2.cmml" xref="S3.SS2.2.p1.11.m2.2.3.2"><times id="S3.SS2.2.p1.11.m2.2.3.2.1.cmml" xref="S3.SS2.2.p1.11.m2.2.3.2.1"></times><ci id="S3.SS2.2.p1.11.m2.2.3.2.2.cmml" xref="S3.SS2.2.p1.11.m2.2.3.2.2">𝜋</ci><cn type="integer" id="S3.SS2.2.p1.11.m2.1.1.cmml" xref="S3.SS2.2.p1.11.m2.1.1">0</cn></apply><apply id="S3.SS2.2.p1.11.m2.2.3.3.cmml" xref="S3.SS2.2.p1.11.m2.2.3.3"><times id="S3.SS2.2.p1.11.m2.2.3.3.1.cmml" xref="S3.SS2.2.p1.11.m2.2.3.3.1"></times><ci id="S3.SS2.2.p1.11.m2.2.3.3.2.cmml" xref="S3.SS2.2.p1.11.m2.2.3.3.2">𝜌</ci><cn type="integer" id="S3.SS2.2.p1.11.m2.2.2.cmml" xref="S3.SS2.2.p1.11.m2.2.2">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS2.2.p1.11.m2.2c">\pi(0)\geq\rho(0)</annotation></semantics></math>
and thus (i). Combining (i), (<a href="#S3.E2" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>) and
(<a href="#S3.E7" title="In Proof. ‣ 3.2. Optimized certainty equivalents ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>) then directly gives (ii).
∎</p>
