closest (in squared distance) straight line with slope <math id="S5.SS3.SSSx1.p2.2.m2.1" class="ltx_Math" alttext="2/3" display="inline"><semantics id="S5.SS3.SSSx1.p2.2.m2.1a"><mrow id="S5.SS3.SSSx1.p2.2.m2.1.1" xref="S5.SS3.SSSx1.p2.2.m2.1.1.cmml"><mn id="S5.SS3.SSSx1.p2.2.m2.1.1.2" xref="S5.SS3.SSSx1.p2.2.m2.1.1.2.cmml">2</mn><mo id="S5.SS3.SSSx1.p2.2.m2.1.1.1" xref="S5.SS3.SSSx1.p2.2.m2.1.1.1.cmml">/</mo><mn id="S5.SS3.SSSx1.p2.2.m2.1.1.3" xref="S5.SS3.SSSx1.p2.2.m2.1.1.3.cmml">3</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p2.2.m2.1b"><apply id="S5.SS3.SSSx1.p2.2.m2.1.1.cmml" xref="S5.SS3.SSSx1.p2.2.m2.1.1"><divide id="S5.SS3.SSSx1.p2.2.m2.1.1.1.cmml" xref="S5.SS3.SSSx1.p2.2.m2.1.1.1"></divide><cn type="integer" id="S5.SS3.SSSx1.p2.2.m2.1.1.2.cmml" xref="S5.SS3.SSSx1.p2.2.m2.1.1.2">2</cn><cn type="integer" id="S5.SS3.SSSx1.p2.2.m2.1.1.3.cmml" xref="S5.SS3.SSSx1.p2.2.m2.1.1.3">3</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p2.2.m2.1c">2/3</annotation></semantics></math> (in
blue). Thus, in this range of <math id="S5.SS3.SSSx1.p2.3.m3.1" class="ltx_Math" alttext="\varepsilon" display="inline"><semantics id="S5.SS3.SSSx1.p2.3.m3.1a"><mi id="S5.SS3.SSSx1.p2.3.m3.1.1" xref="S5.SS3.SSSx1.p2.3.m3.1.1.cmml">ε</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p2.3.m3.1b"><ci id="S5.SS3.SSSx1.p2.3.m3.1.1.cmml" xref="S5.SS3.SSSx1.p2.3.m3.1.1">𝜀</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p2.3.m3.1c">\varepsilon</annotation></semantics></math> the relation
<math id="S5.SS3.SSSx1.p2.4.m4.4" class="ltx_Math" alttext="\log(p_{\varepsilon}-p_{0})=2/3\log(\varepsilon)+C" display="inline"><semantics id="S5.SS3.SSSx1.p2.4.m4.4a"><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4" xref="S5.SS3.SSSx1.p2.4.m4.4.4.cmml"><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml"><mi id="S5.SS3.SSSx1.p2.4.m4.1.1" xref="S5.SS3.SSSx1.p2.4.m4.1.1.cmml">log</mi><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1a" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml">⁡</mo><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml"><mo stretchy="false" id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml">(</mo><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.cmml"><msub id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.cmml"><mi id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.2.cmml">p</mi><mi id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.3.cmml">ε</mi></msub><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.1.cmml">−</mo><msub id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.cmml"><mi id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.2.cmml">p</mi><mn id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.3.cmml">0</mn></msub></mrow><mo stretchy="false" id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml">)</mo></mrow></mrow><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.2.cmml">=</mo><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.cmml"><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.cmml"><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.cmml"><mn id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.2.cmml">2</mn><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.1.cmml">/</mo><mn id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.3.cmml">3</mn></mrow><mo lspace="0.167em" rspace="0em" id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.1.cmml">​</mo><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml"><mi id="S5.SS3.SSSx1.p2.4.m4.2.2" xref="S5.SS3.SSSx1.p2.4.m4.2.2.cmml">log</mi><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2a" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml">⁡</mo><mrow id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml"><mo stretchy="false" id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2.1.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml">(</mo><mi id="S5.SS3.SSSx1.p2.4.m4.3.3" xref="S5.SS3.SSSx1.p2.4.m4.3.3.cmml">ε</mi><mo stretchy="false" id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2.1.2" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml">)</mo></mrow></mrow></mrow><mo id="S5.SS3.SSSx1.p2.4.m4.4.4.3.1" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.1.cmml">+</mo><mi id="S5.SS3.SSSx1.p2.4.m4.4.4.3.3" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.3.cmml">C</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p2.4.m4.4b"><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4"><eq id="S5.SS3.SSSx1.p2.4.m4.4.4.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.2"></eq><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.1.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1"><log id="S5.SS3.SSSx1.p2.4.m4.1.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.1.1"></log><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1"><minus id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.1"></minus><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2">subscript</csymbol><ci id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.2">𝑝</ci><ci id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.2.3">𝜀</ci></apply><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3">subscript</csymbol><ci id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.2">𝑝</ci><cn type="integer" id="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.1.1.1.1.3.3">0</cn></apply></apply></apply><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3"><plus id="S5.SS3.SSSx1.p2.4.m4.4.4.3.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.1"></plus><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2"><times id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.1"></times><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2"><divide id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.1"></divide><cn type="integer" id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.2">2</cn><cn type="integer" id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.2.3">3</cn></apply><apply id="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.1.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.2.3.2"><log id="S5.SS3.SSSx1.p2.4.m4.2.2.cmml" xref="S5.SS3.SSSx1.p2.4.m4.2.2"></log><ci id="S5.SS3.SSSx1.p2.4.m4.3.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.3.3">𝜀</ci></apply></apply><ci id="S5.SS3.SSSx1.p2.4.m4.4.4.3.3.cmml" xref="S5.SS3.SSSx1.p2.4.m4.4.4.3.3">𝐶</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p2.4.m4.4c">\log(p_{\varepsilon}-p_{0})=2/3\log(\varepsilon)+C</annotation></semantics></math> for some
<math id="S5.SS3.SSSx1.p2.5.m5.1" class="ltx_Math" alttext="C\in\mathbb{R}" display="inline"><semantics id="S5.SS3.SSSx1.p2.5.m5.1a"><mrow id="S5.SS3.SSSx1.p2.5.m5.1.1" xref="S5.SS3.SSSx1.p2.5.m5.1.1.cmml"><mi id="S5.SS3.SSSx1.p2.5.m5.1.1.2" xref="S5.SS3.SSSx1.p2.5.m5.1.1.2.cmml">C</mi><mo id="S5.SS3.SSSx1.p2.5.m5.1.1.1" xref="S5.SS3.SSSx1.p2.5.m5.1.1.1.cmml">∈</mo><mi id="S5.SS3.SSSx1.p2.5.m5.1.1.3" xref="S5.SS3.SSSx1.p2.5.m5.1.1.3.cmml">ℝ</mi></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p2.5.m5.1b"><apply id="S5.SS3.SSSx1.p2.5.m5.1.1.cmml" xref="S5.SS3.SSSx1.p2.5.m5.1.1"><in id="S5.SS3.SSSx1.p2.5.m5.1.1.1.cmml" xref="S5.SS3.SSSx1.p2.5.m5.1.1.1"></in><ci id="S5.SS3.SSSx1.p2.5.m5.1.1.2.cmml" xref="S5.SS3.SSSx1.p2.5.m5.1.1.2">𝐶</ci><ci id="S5.SS3.SSSx1.p2.5.m5.1.1.3.cmml" xref="S5.SS3.SSSx1.p2.5.m5.1.1.3">ℝ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p2.5.m5.1c">C\in\mathbb{R}</annotation></semantics></math> indeed holds true and hence also
(<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>).</p>
</div>
<div id="S5.SS3.SSSx1.p3" class="ltx_para">
<p id="S5.SS3.SSSx1.p3.4" class="ltx_p">Note that trading is only possible at discrete time-points and so the
indifference price and the risk-neutral price do not coincide. Since
(<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) is a result for continuous-time trading
(where <math id="S5.SS3.SSSx1.p3.1.m1.1" class="ltx_Math" alttext="q=p_{0}" display="inline"><semantics id="S5.SS3.SSSx1.p3.1.m1.1a"><mrow id="S5.SS3.SSSx1.p3.1.m1.1.1" xref="S5.SS3.SSSx1.p3.1.m1.1.1.cmml"><mi id="S5.SS3.SSSx1.p3.1.m1.1.1.2" xref="S5.SS3.SSSx1.p3.1.m1.1.1.2.cmml">q</mi><mo id="S5.SS3.SSSx1.p3.1.m1.1.1.1" xref="S5.SS3.SSSx1.p3.1.m1.1.1.1.cmml">=</mo><msub id="S5.SS3.SSSx1.p3.1.m1.1.1.3" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3.cmml"><mi id="S5.SS3.SSSx1.p3.1.m1.1.1.3.2" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3.2.cmml">p</mi><mn id="S5.SS3.SSSx1.p3.1.m1.1.1.3.3" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3.3.cmml">0</mn></msub></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p3.1.m1.1b"><apply id="S5.SS3.SSSx1.p3.1.m1.1.1.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1"><eq id="S5.SS3.SSSx1.p3.1.m1.1.1.1.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.1"></eq><ci id="S5.SS3.SSSx1.p3.1.m1.1.1.2.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.2">𝑞</ci><apply id="S5.SS3.SSSx1.p3.1.m1.1.1.3.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p3.1.m1.1.1.3.1.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3">subscript</csymbol><ci id="S5.SS3.SSSx1.p3.1.m1.1.1.3.2.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3.2">𝑝</ci><cn type="integer" id="S5.SS3.SSSx1.p3.1.m1.1.1.3.3.cmml" xref="S5.SS3.SSSx1.p3.1.m1.1.1.3.3">0</cn></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p3.1.m1.1c">q=p_{0}</annotation></semantics></math>), we have compared to the risk-neutral price <math id="S5.SS3.SSSx1.p3.2.m2.1" class="ltx_Math" alttext="q" display="inline"><semantics id="S5.SS3.SSSx1.p3.2.m2.1a"><mi id="S5.SS3.SSSx1.p3.2.m2.1.1" xref="S5.SS3.SSSx1.p3.2.m2.1.1.cmml">q</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p3.2.m2.1b"><ci id="S5.SS3.SSSx1.p3.2.m2.1.1.cmml" xref="S5.SS3.SSSx1.p3.2.m2.1.1">𝑞</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p3.2.m2.1c">q</annotation></semantics></math> here
(thus neglecting the discrete-time friction in <math id="S5.SS3.SSSx1.p3.3.m3.1" class="ltx_Math" alttext="p_{\varepsilon}" display="inline"><semantics id="S5.SS3.SSSx1.p3.3.m3.1a"><msub id="S5.SS3.SSSx1.p3.3.m3.1.1" xref="S5.SS3.SSSx1.p3.3.m3.1.1.cmml"><mi id="S5.SS3.SSSx1.p3.3.m3.1.1.2" xref="S5.SS3.SSSx1.p3.3.m3.1.1.2.cmml">p</mi><mi id="S5.SS3.SSSx1.p3.3.m3.1.1.3" xref="S5.SS3.SSSx1.p3.3.m3.1.1.3.cmml">ε</mi></msub><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p3.3.m3.1b"><apply id="S5.SS3.SSSx1.p3.3.m3.1.1.cmml" xref="S5.SS3.SSSx1.p3.3.m3.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx1.p3.3.m3.1.1.1.cmml" xref="S5.SS3.SSSx1.p3.3.m3.1.1">subscript</csymbol><ci id="S5.SS3.SSSx1.p3.3.m3.1.1.2.cmml" xref="S5.SS3.SSSx1.p3.3.m3.1.1.2">𝑝</ci><ci id="S5.SS3.SSSx1.p3.3.m3.1.1.3.cmml" xref="S5.SS3.SSSx1.p3.3.m3.1.1.3">𝜀</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p3.3.m3.1c">p_{\varepsilon}</annotation></semantics></math> for
<math id="S5.SS3.SSSx1.p3.4.m4.1" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline"><semantics id="S5.SS3.SSSx1.p3.4.m4.1a"><mrow id="S5.SS3.SSSx1.p3.4.m4.1.1" xref="S5.SS3.SSSx1.p3.4.m4.1.1.cmml"><mi id="S5.SS3.SSSx1.p3.4.m4.1.1.2" xref="S5.SS3.SSSx1.p3.4.m4.1.1.2.cmml">ε</mi><mo id="S5.SS3.SSSx1.p3.4.m4.1.1.1" xref="S5.SS3.SSSx1.p3.4.m4.1.1.1.cmml">&gt;</mo><mn id="S5.SS3.SSSx1.p3.4.m4.1.1.3" xref="S5.SS3.SSSx1.p3.4.m4.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx1.p3.4.m4.1b"><apply id="S5.SS3.SSSx1.p3.4.m4.1.1.cmml" xref="S5.SS3.SSSx1.p3.4.m4.1.1"><gt id="S5.SS3.SSSx1.p3.4.m4.1.1.1.cmml" xref="S5.SS3.SSSx1.p3.4.m4.1.1.1"></gt><ci id="S5.SS3.SSSx1.p3.4.m4.1.1.2.cmml" xref="S5.SS3.SSSx1.p3.4.m4.1.1.2">𝜀</ci><cn type="integer" id="S5.SS3.SSSx1.p3.4.m4.1.1.3.cmml" xref="S5.SS3.SSSx1.p3.4.m4.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx1.p3.4.m4.1c">\varepsilon&gt;0</annotation></semantics></math>).</p>
</div>
</section>
<section id="S5.SS3.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Heston model</h4>

<div id="S5.SS3.SSSx2.p1" class="ltx_para">
<p id="S5.SS3.SSSx2.p1.7" class="ltx_p">We now consider a Heston model with two
hedging instruments, i.e. <math id="S5.SS3.SSSx2.p1.1.m1.1" class="ltx_Math" alttext="d=2" display="inline"><semantics id="S5.SS3.SSSx2.p1.1.m1.1a"><mrow id="S5.SS3.SSSx2.p1.1.m1.1.1" xref="S5.SS3.SSSx2.p1.1.m1.1.1.cmml"><mi id="S5.SS3.SSSx2.p1.1.m1.1.1.2" xref="S5.SS3.SSSx2.p1.1.m1.1.1.2.cmml">d</mi><mo id="S5.SS3.SSSx2.p1.1.m1.1.1.1" xref="S5.SS3.SSSx2.p1.1.m1.1.1.1.cmml">=</mo><mn id="S5.SS3.SSSx2.p1.1.m1.1.1.3" xref="S5.SS3.SSSx2.p1.1.m1.1.1.3.cmml">2</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.1.m1.1b"><apply id="S5.SS3.SSSx2.p1.1.m1.1.1.cmml" xref="S5.SS3.SSSx2.p1.1.m1.1.1"><eq id="S5.SS3.SSSx2.p1.1.m1.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.1.m1.1.1.1"></eq><ci id="S5.SS3.SSSx2.p1.1.m1.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.1.m1.1.1.2">𝑑</ci><cn type="integer" id="S5.SS3.SSSx2.p1.1.m1.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.1.m1.1.1.3">2</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.1.m1.1c">d=2</annotation></semantics></math> and the setting is precisely as in
Section <a href="#S5.SS2" title="5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, except that here <math id="S5.SS3.SSSx2.p1.2.m2.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S5.SS3.SSSx2.p1.2.m2.1a"><mi id="S5.SS3.SSSx2.p1.2.m2.1.1" xref="S5.SS3.SSSx2.p1.2.m2.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.2.m2.1b"><ci id="S5.SS3.SSSx2.p1.2.m2.1.1.cmml" xref="S5.SS3.SSSx2.p1.2.m2.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.2.m2.1c">\rho</annotation></semantics></math> is chosen as
(<a href="#S3.E4" title="In Lemma 3.6. ‣ 3.1. Exponential Utility Indifference Pricing ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>) and proportional transaction costs (<a href="#S5.E7" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>) are incurred. Choosing
<math id="S5.SS3.SSSx2.p1.3.m3.1" class="ltx_Math" alttext="\lambda=1" display="inline"><semantics id="S5.SS3.SSSx2.p1.3.m3.1a"><mrow id="S5.SS3.SSSx2.p1.3.m3.1.1" xref="S5.SS3.SSSx2.p1.3.m3.1.1.cmml"><mi id="S5.SS3.SSSx2.p1.3.m3.1.1.2" xref="S5.SS3.SSSx2.p1.3.m3.1.1.2.cmml">λ</mi><mo id="S5.SS3.SSSx2.p1.3.m3.1.1.1" xref="S5.SS3.SSSx2.p1.3.m3.1.1.1.cmml">=</mo><mn id="S5.SS3.SSSx2.p1.3.m3.1.1.3" xref="S5.SS3.SSSx2.p1.3.m3.1.1.3.cmml">1</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.3.m3.1b"><apply id="S5.SS3.SSSx2.p1.3.m3.1.1.cmml" xref="S5.SS3.SSSx2.p1.3.m3.1.1"><eq id="S5.SS3.SSSx2.p1.3.m3.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.3.m3.1.1.1"></eq><ci id="S5.SS3.SSSx2.p1.3.m3.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.3.m3.1.1.2">𝜆</ci><cn type="integer" id="S5.SS3.SSSx2.p1.3.m3.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.3.m3.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.3.m3.1c">\lambda=1</annotation></semantics></math>, <math id="S5.SS3.SSSx2.p1.4.m4.1" class="ltx_Math" alttext="Z=(S_{T}^{1}-K)^{+}" display="inline"><semantics id="S5.SS3.SSSx2.p1.4.m4.1a"><mrow id="S5.SS3.SSSx2.p1.4.m4.1.1" xref="S5.SS3.SSSx2.p1.4.m4.1.1.cmml"><mi id="S5.SS3.SSSx2.p1.4.m4.1.1.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.3.cmml">Z</mi><mo id="S5.SS3.SSSx2.p1.4.m4.1.1.2" xref="S5.SS3.SSSx2.p1.4.m4.1.1.2.cmml">=</mo><msup id="S5.SS3.SSSx2.p1.4.m4.1.1.1" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.cmml"><mrow id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.2" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.cmml">(</mo><mrow id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.cmml"><msubsup id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.cmml"><mi id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.2" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.2.cmml">S</mi><mi id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.3.cmml">T</mi><mn id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.3.cmml">1</mn></msubsup><mo id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.1" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.1.cmml">−</mo><mi id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.3.cmml">K</mi></mrow><mo stretchy="false" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.cmml">)</mo></mrow><mo id="S5.SS3.SSSx2.p1.4.m4.1.1.1.3" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.3.cmml">+</mo></msup></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.4.m4.1b"><apply id="S5.SS3.SSSx2.p1.4.m4.1.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1"><eq id="S5.SS3.SSSx2.p1.4.m4.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.2"></eq><ci id="S5.SS3.SSSx2.p1.4.m4.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.3">𝑍</ci><apply id="S5.SS3.SSSx2.p1.4.m4.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1">superscript</csymbol><apply id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1"><minus id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.1"></minus><apply id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2">superscript</csymbol><apply id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2"><csymbol cd="ambiguous" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.1.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2">subscript</csymbol><ci id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.2.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.2">𝑆</ci><ci id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.3.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.2.3">𝑇</ci></apply><cn type="integer" id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.3.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.2.3">1</cn></apply><ci id="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.1.1.1.3">𝐾</ci></apply><plus id="S5.SS3.SSSx2.p1.4.m4.1.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.4.m4.1.1.1.3"></plus></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.4.m4.1c">Z=(S_{T}^{1}-K)^{+}</annotation></semantics></math> and <math id="S5.SS3.SSSx2.p1.5.m5.1" class="ltx_Math" alttext="\varepsilon_{i}" display="inline"><semantics id="S5.SS3.SSSx2.p1.5.m5.1a"><msub id="S5.SS3.SSSx2.p1.5.m5.1.1" xref="S5.SS3.SSSx2.p1.5.m5.1.1.cmml"><mi id="S5.SS3.SSSx2.p1.5.m5.1.1.2" xref="S5.SS3.SSSx2.p1.5.m5.1.1.2.cmml">ε</mi><mi id="S5.SS3.SSSx2.p1.5.m5.1.1.3" xref="S5.SS3.SSSx2.p1.5.m5.1.1.3.cmml">i</mi></msub><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.5.m5.1b"><apply id="S5.SS3.SSSx2.p1.5.m5.1.1.cmml" xref="S5.SS3.SSSx2.p1.5.m5.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx2.p1.5.m5.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.5.m5.1.1">subscript</csymbol><ci id="S5.SS3.SSSx2.p1.5.m5.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.5.m5.1.1.2">𝜀</ci><ci id="S5.SS3.SSSx2.p1.5.m5.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.5.m5.1.1.3">𝑖</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.5.m5.1c">\varepsilon_{i}</annotation></semantics></math> as in the
Black-Scholes case above, one can again calculate the exponential
utility indifference prices and show the difference to <math id="S5.SS3.SSSx2.p1.6.m6.1" class="ltx_Math" alttext="p_{0}" display="inline"><semantics id="S5.SS3.SSSx2.p1.6.m6.1a"><msub id="S5.SS3.SSSx2.p1.6.m6.1.1" xref="S5.SS3.SSSx2.p1.6.m6.1.1.cmml"><mi id="S5.SS3.SSSx2.p1.6.m6.1.1.2" xref="S5.SS3.SSSx2.p1.6.m6.1.1.2.cmml">p</mi><mn id="S5.SS3.SSSx2.p1.6.m6.1.1.3" xref="S5.SS3.SSSx2.p1.6.m6.1.1.3.cmml">0</mn></msub><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.6.m6.1b"><apply id="S5.SS3.SSSx2.p1.6.m6.1.1.cmml" xref="S5.SS3.SSSx2.p1.6.m6.1.1"><csymbol cd="ambiguous" id="S5.SS3.SSSx2.p1.6.m6.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.6.m6.1.1">subscript</csymbol><ci id="S5.SS3.SSSx2.p1.6.m6.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.6.m6.1.1.2">𝑝</ci><cn type="integer" id="S5.SS3.SSSx2.p1.6.m6.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.6.m6.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.6.m6.1c">p_{0}</annotation></semantics></math> in a
log-log plot (see above) in a graph. These are shown as red dots in
Figure <a href="#S5.F11" title="Figure 11 ‣ Heston model ‣ 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>. Here the blue line in
Figure <a href="#S5.F11" title="Figure 11 ‣ Heston model ‣ 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> is the regression line, i.e. the
least squares fit of the red dots. The rate is very close to <math id="S5.SS3.SSSx2.p1.7.m7.1" class="ltx_Math" alttext="2/3" display="inline"><semantics id="S5.SS3.SSSx2.p1.7.m7.1a"><mrow id="S5.SS3.SSSx2.p1.7.m7.1.1" xref="S5.SS3.SSSx2.p1.7.m7.1.1.cmml"><mn id="S5.SS3.SSSx2.p1.7.m7.1.1.2" xref="S5.SS3.SSSx2.p1.7.m7.1.1.2.cmml">2</mn><mo id="S5.SS3.SSSx2.p1.7.m7.1.1.1" xref="S5.SS3.SSSx2.p1.7.m7.1.1.1.cmml">/</mo><mn id="S5.SS3.SSSx2.p1.7.m7.1.1.3" xref="S5.SS3.SSSx2.p1.7.m7.1.1.3.cmml">3</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS3.SSSx2.p1.7.m7.1b"><apply id="S5.SS3.SSSx2.p1.7.m7.1.1.cmml" xref="S5.SS3.SSSx2.p1.7.m7.1.1"><divide id="S5.SS3.SSSx2.p1.7.m7.1.1.1.cmml" xref="S5.SS3.SSSx2.p1.7.m7.1.1.1"></divide><cn type="integer" id="S5.SS3.SSSx2.p1.7.m7.1.1.2.cmml" xref="S5.SS3.SSSx2.p1.7.m7.1.1.2">2</cn><cn type="integer" id="S5.SS3.SSSx2.p1.7.m7.1.1.3.cmml" xref="S5.SS3.SSSx2.p1.7.m7.1.1.3">3</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS3.SSSx2.p1.7.m7.1c">2/3</annotation></semantics></math> and
so it appears that the relation (<a href="#S5.E8" title="In 5.3. Price asymptotics under proportional transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>) also holds
in this case.</p>
</div>
<figure id="S5.F10" class="ltx_figure"><img src="/html/1802.03042/assets/x10.png" id="S5.F10.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="392" height="271" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 10. </span>Black-Scholes model price asymptotics.</figcaption>
</figure>
<figure id="S5.F11" class="ltx_figure"><img src="/html/1802.03042/assets/x11.png" id="S5.F11.g1" class="ltx_graphics ltx_centering ltx_img_landscape" width="392" height="271" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 11. </span>Heston model price asymptotics</figcaption>
</figure>
</section>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">
<span class="ltx_tag ltx_tag_subsection">5.4. </span>High-dimensional example</h3>

<div id="S5.SS4.p1" class="ltx_para">
<p id="S5.SS4.p1.15" class="ltx_p">As a last
example consider a model built from <math id="S5.SS4.p1.1.m1.1" class="ltx_Math" alttext="5" display="inline"><semantics id="S5.SS4.p1.1.m1.1a"><mn id="S5.SS4.p1.1.m1.1.1" xref="S5.SS4.p1.1.m1.1.1.cmml">5</mn><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.1.m1.1b"><cn type="integer" id="S5.SS4.p1.1.m1.1.1.cmml" xref="S5.SS4.p1.1.m1.1.1">5</cn></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.1.m1.1c">5</annotation></semantics></math> separate Heston models,
i.e. <math id="S5.SS4.p1.2.m2.1" class="ltx_Math" alttext="d=10" display="inline"><semantics id="S5.SS4.p1.2.m2.1a"><mrow id="S5.SS4.p1.2.m2.1.1" xref="S5.SS4.p1.2.m2.1.1.cmml"><mi id="S5.SS4.p1.2.m2.1.1.2" xref="S5.SS4.p1.2.m2.1.1.2.cmml">d</mi><mo id="S5.SS4.p1.2.m2.1.1.1" xref="S5.SS4.p1.2.m2.1.1.1.cmml">=</mo><mn id="S5.SS4.p1.2.m2.1.1.3" xref="S5.SS4.p1.2.m2.1.1.3.cmml">10</mn></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.2.m2.1b"><apply id="S5.SS4.p1.2.m2.1.1.cmml" xref="S5.SS4.p1.2.m2.1.1"><eq id="S5.SS4.p1.2.m2.1.1.1.cmml" xref="S5.SS4.p1.2.m2.1.1.1"></eq><ci id="S5.SS4.p1.2.m2.1.1.2.cmml" xref="S5.SS4.p1.2.m2.1.1.2">𝑑</ci><cn type="integer" id="S5.SS4.p1.2.m2.1.1.3.cmml" xref="S5.SS4.p1.2.m2.1.1.3">10</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.2.m2.1c">d=10</annotation></semantics></math> and <math id="S5.SS4.p1.3.m3.2" class="ltx_Math" alttext="(S^{h},S^{h+1})" display="inline"><semantics id="S5.SS4.p1.3.m3.2a"><mrow id="S5.SS4.p1.3.m3.2.2.2" xref="S5.SS4.p1.3.m3.2.2.3.cmml"><mo stretchy="false" id="S5.SS4.p1.3.m3.2.2.2.3" xref="S5.SS4.p1.3.m3.2.2.3.cmml">(</mo><msup id="S5.SS4.p1.3.m3.1.1.1.1" xref="S5.SS4.p1.3.m3.1.1.1.1.cmml"><mi id="S5.SS4.p1.3.m3.1.1.1.1.2" xref="S5.SS4.p1.3.m3.1.1.1.1.2.cmml">S</mi><mi id="S5.SS4.p1.3.m3.1.1.1.1.3" xref="S5.SS4.p1.3.m3.1.1.1.1.3.cmml">h</mi></msup><mo id="S5.SS4.p1.3.m3.2.2.2.4" xref="S5.SS4.p1.3.m3.2.2.3.cmml">,</mo><msup id="S5.SS4.p1.3.m3.2.2.2.2" xref="S5.SS4.p1.3.m3.2.2.2.2.cmml"><mi id="S5.SS4.p1.3.m3.2.2.2.2.2" xref="S5.SS4.p1.3.m3.2.2.2.2.2.cmml">S</mi><mrow id="S5.SS4.p1.3.m3.2.2.2.2.3" xref="S5.SS4.p1.3.m3.2.2.2.2.3.cmml"><mi id="S5.SS4.p1.3.m3.2.2.2.2.3.2" xref="S5.SS4.p1.3.m3.2.2.2.2.3.2.cmml">h</mi><mo id="S5.SS4.p1.3.m3.2.2.2.2.3.1" xref="S5.SS4.p1.3.m3.2.2.2.2.3.1.cmml">+</mo><mn id="S5.SS4.p1.3.m3.2.2.2.2.3.3" xref="S5.SS4.p1.3.m3.2.2.2.2.3.3.cmml">1</mn></mrow></msup><mo stretchy="false" id="S5.SS4.p1.3.m3.2.2.2.5" xref="S5.SS4.p1.3.m3.2.2.3.cmml">)</mo></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.3.m3.2b"><interval closure="open" id="S5.SS4.p1.3.m3.2.2.3.cmml" xref="S5.SS4.p1.3.m3.2.2.2"><apply id="S5.SS4.p1.3.m3.1.1.1.1.cmml" xref="S5.SS4.p1.3.m3.1.1.1.1"><csymbol cd="ambiguous" id="S5.SS4.p1.3.m3.1.1.1.1.1.cmml" xref="S5.SS4.p1.3.m3.1.1.1.1">superscript</csymbol><ci id="S5.SS4.p1.3.m3.1.1.1.1.2.cmml" xref="S5.SS4.p1.3.m3.1.1.1.1.2">𝑆</ci><ci id="S5.SS4.p1.3.m3.1.1.1.1.3.cmml" xref="S5.SS4.p1.3.m3.1.1.1.1.3">ℎ</ci></apply><apply id="S5.SS4.p1.3.m3.2.2.2.2.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2"><csymbol cd="ambiguous" id="S5.SS4.p1.3.m3.2.2.2.2.1.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2">superscript</csymbol><ci id="S5.SS4.p1.3.m3.2.2.2.2.2.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2.2">𝑆</ci><apply id="S5.SS4.p1.3.m3.2.2.2.2.3.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2.3"><plus id="S5.SS4.p1.3.m3.2.2.2.2.3.1.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2.3.1"></plus><ci id="S5.SS4.p1.3.m3.2.2.2.2.3.2.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2.3.2">ℎ</ci><cn type="integer" id="S5.SS4.p1.3.m3.2.2.2.2.3.3.cmml" xref="S5.SS4.p1.3.m3.2.2.2.2.3.3">1</cn></apply></apply></interval></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.3.m3.2c">(S^{h},S^{h+1})</annotation></semantics></math> is the price process of spot and
variance swap in a Heston model (specified by (<a href="#S5.E2" title="In A brief reminder on the Heston model ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>)
and (<a href="#S5.E4" title="In A brief reminder on the Heston model ‣ 5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>)) for <math id="S5.SS4.p1.4.m4.3" class="ltx_Math" alttext="h=1,\ldots,5" display="inline"><semantics id="S5.SS4.p1.4.m4.3a"><mrow id="S5.SS4.p1.4.m4.3.4" xref="S5.SS4.p1.4.m4.3.4.cmml"><mi id="S5.SS4.p1.4.m4.3.4.2" xref="S5.SS4.p1.4.m4.3.4.2.cmml">h</mi><mo id="S5.SS4.p1.4.m4.3.4.1" xref="S5.SS4.p1.4.m4.3.4.1.cmml">=</mo><mrow id="S5.SS4.p1.4.m4.3.4.3.2" xref="S5.SS4.p1.4.m4.3.4.3.1.cmml"><mn id="S5.SS4.p1.4.m4.1.1" xref="S5.SS4.p1.4.m4.1.1.cmml">1</mn><mo id="S5.SS4.p1.4.m4.3.4.3.2.1" xref="S5.SS4.p1.4.m4.3.4.3.1.cmml">,</mo><mi mathvariant="normal" id="S5.SS4.p1.4.m4.2.2" xref="S5.SS4.p1.4.m4.2.2.cmml">…</mi><mo id="S5.SS4.p1.4.m4.3.4.3.2.2" xref="S5.SS4.p1.4.m4.3.4.3.1.cmml">,</mo><mn id="S5.SS4.p1.4.m4.3.3" xref="S5.SS4.p1.4.m4.3.3.cmml">5</mn></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.4.m4.3b"><apply id="S5.SS4.p1.4.m4.3.4.cmml" xref="S5.SS4.p1.4.m4.3.4"><eq id="S5.SS4.p1.4.m4.3.4.1.cmml" xref="S5.SS4.p1.4.m4.3.4.1"></eq><ci id="S5.SS4.p1.4.m4.3.4.2.cmml" xref="S5.SS4.p1.4.m4.3.4.2">ℎ</ci><list id="S5.SS4.p1.4.m4.3.4.3.1.cmml" xref="S5.SS4.p1.4.m4.3.4.3.2"><cn type="integer" id="S5.SS4.p1.4.m4.1.1.cmml" xref="S5.SS4.p1.4.m4.1.1">1</cn><ci id="S5.SS4.p1.4.m4.2.2.cmml" xref="S5.SS4.p1.4.m4.2.2">…</ci><cn type="integer" id="S5.SS4.p1.4.m4.3.3.cmml" xref="S5.SS4.p1.4.m4.3.3">5</cn></list></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.4.m4.3c">h=1,\ldots,5</annotation></semantics></math>. To have a benchmark
at hand the <math id="S5.SS4.p1.5.m5.1" class="ltx_Math" alttext="5" display="inline"><semantics id="S5.SS4.p1.5.m5.1a"><mn id="S5.SS4.p1.5.m5.1.1" xref="S5.SS4.p1.5.m5.1.1.cmml">5</mn><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.5.m5.1b"><cn type="integer" id="S5.SS4.p1.5.m5.1.1.cmml" xref="S5.SS4.p1.5.m5.1.1">5</cn></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.5.m5.1c">5</annotation></semantics></math> models are assumed independent and each of them has
parameters as specified in Section <a href="#S5.SS2" title="5.2. Benchmark: No transaction costs ‣ 5. Numerical experiments and results ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>. This choice
is of course no restriction for the algorithm and is only made for
convenience. The payoff is a sum of call options on each of the
underlyings, i.e. <math id="S5.SS4.p1.6.m6.1" class="ltx_Math" alttext="Z=\sum_{h=1}^{5}Z_{h}" display="inline"><semantics id="S5.SS4.p1.6.m6.1a"><mrow id="S5.SS4.p1.6.m6.1.1" xref="S5.SS4.p1.6.m6.1.1.cmml"><mi id="S5.SS4.p1.6.m6.1.1.2" xref="S5.SS4.p1.6.m6.1.1.2.cmml">Z</mi><mo rspace="0.111em" id="S5.SS4.p1.6.m6.1.1.1" xref="S5.SS4.p1.6.m6.1.1.1.cmml">=</mo><mrow id="S5.SS4.p1.6.m6.1.1.3" xref="S5.SS4.p1.6.m6.1.1.3.cmml"><msubsup id="S5.SS4.p1.6.m6.1.1.3.1" xref="S5.SS4.p1.6.m6.1.1.3.1.cmml"><mo id="S5.SS4.p1.6.m6.1.1.3.1.2.2" xref="S5.SS4.p1.6.m6.1.1.3.1.2.2.cmml">∑</mo><mrow id="S5.SS4.p1.6.m6.1.1.3.1.2.3" xref="S5.SS4.p1.6.m6.1.1.3.1.2.3.cmml"><mi id="S5.SS4.p1.6.m6.1.1.3.1.2.3.2" xref="S5.SS4.p1.6.m6.1.1.3.1.2.3.2.cmml">h</mi><mo id="S5.SS4.p1.6.m6.1.1.3.1.2.3.1" xref="S5.SS4.p1.6.m6.1.1.3.1.2.3.1.cmml">=</mo><mn id="S5.SS4.p1.6.m6.1.1.3.1.2.3.3" xref="S5.SS4.p1.6.m6.1.1.3.1.2.3.3.cmml">1</mn></mrow><mn id="S5.SS4.p1.6.m6.1.1.3.1.3" xref="S5.SS4.p1.6.m6.1.1.3.1.3.cmml">5</mn></msubsup><msub id="S5.SS4.p1.6.m6.1.1.3.2" xref="S5.SS4.p1.6.m6.1.1.3.2.cmml"><mi id="S5.SS4.p1.6.m6.1.1.3.2.2" xref="S5.SS4.p1.6.m6.1.1.3.2.2.cmml">Z</mi><mi id="S5.SS4.p1.6.m6.1.1.3.2.3" xref="S5.SS4.p1.6.m6.1.1.3.2.3.cmml">h</mi></msub></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.6.m6.1b"><apply id="S5.SS4.p1.6.m6.1.1.cmml" xref="S5.SS4.p1.6.m6.1.1"><eq id="S5.SS4.p1.6.m6.1.1.1.cmml" xref="S5.SS4.p1.6.m6.1.1.1"></eq><ci id="S5.SS4.p1.6.m6.1.1.2.cmml" xref="S5.SS4.p1.6.m6.1.1.2">𝑍</ci><apply id="S5.SS4.p1.6.m6.1.1.3.cmml" xref="S5.SS4.p1.6.m6.1.1.3"><apply id="S5.SS4.p1.6.m6.1.1.3.1.cmml" xref="S5.SS4.p1.6.m6.1.1.3.1"><csymbol cd="ambiguous" id="S5.SS4.p1.6.m6.1.1.3.1.1.cmml" xref="S5.SS4.p1.6.m6.1.1.3.1">superscript</csymbol><apply id="S5.SS4.p1.6.m6.1.1.3.1.2.cmml" xref="S5.SS4.p1.6.m6.1.1.3.1"><csymbol cd="ambiguous" id="S5.SS4.p1.6.m6.1.1.3.1.2.1.cmml" xref="S5.SS4.p1.6.m6.1.1.3.1">subscript</csymbol><sum id="S5.SS4.p1.6.m6.1.1.3.1.2.2.cmml" xref="S5.SS4.p1.