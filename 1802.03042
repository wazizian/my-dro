<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1.2" class="ltx_Math" alttext="\pi^{M}(-Z)=\inf_{\bar{\theta}\in\Theta_{M}}\inf_{w\in\mathbb{R}}\left\{w+\mathbb{E}[\ell(Z-(\delta^{\bar{\theta}}\cdot S)_{T}+C_{T}(\delta^{\bar{\theta}})-w)]\right\}=\inf_{\theta\in\Theta}J(\theta)," display="block"><semantics id="S4.Ex11.m1.2a"><mrow id="S4.Ex11.m1.2.2.1" xref="S4.Ex11.m1.2.2.1.1.cmml"><mrow id="S4.Ex11.m1.2.2.1.1" xref="S4.Ex11.m1.2.2.1.1.cmml"><mrow id="S4.Ex11.m1.2.2.1.1.1" xref="S4.Ex11.m1.2.2.1.1.1.cmml"><msup id="S4.Ex11.m1.2.2.1.1.1.3" xref="S4.Ex11.m1.2.2.1.1.1.3.cmml"><mi id="S4.Ex11.m1.2.2.1.1.1.3.2" xref="S4.Ex11.m1.2.2.1.1.1.3.2.cmml">π</mi><mi id="S4.Ex11.m1.2.2.1.1.1.3.3" xref="S4.Ex11.m1.2.2.1.1.1.3.3.cmml">M</mi></msup><mo lspace="0em" rspace="0em" id="S4.Ex11.m1.2.2.1.1.1.2" xref="S4.Ex11.m1.2.2.1.1.1.2.cmml">​</mo><mrow id="S4.Ex11.m1.2.2.1.1.1.1.1" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S4.Ex11.m1.2.2.1.1.1.1.1.2" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.cmml">(</mo><mrow id="S4.Ex11.m1.2.2.1.1.1.1.1.1" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.cmml"><mo id="S4.Ex11.m1.2.2.1.1.1.1.1.1a" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.cmml">−</mo><mi id="S4.Ex11.m1.2.2.1.1.1.1.1.1.2" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.2.cmml">Z</mi></mrow><mo stretchy="false" id="S4.Ex11.m1.2.2.1.1.1.1.1.3" xref="S4.Ex11.m1.2.2.1.1.1.1.1.1.cmml">)</mo></mrow></mrow><mo rspace="0.1389em" id="S4.Ex11.m1.2.2.1.1.4" xref="S4.Ex11.m1.2.2.1.1.4.cmml">=</mo><mrow id="S4.Ex11.m1.2.2.1.1.2" xref="S4.Ex11.m1.2.2.1.1.2.cmml"><munder id="S4.Ex11.m1.2.2.1.1.2.2" xref="S4.Ex11.m1.2.2.1.1.2.2.cmml"><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em" id="S4.Ex11.m1.2.2.1.1.2.2.2" xref="S4.Ex11.m1.2.2.1.1.2.2.2.cmml">inf</mo><mrow id="S4.Ex11.m1.2.2.1.1.2.2.3" xref="S4.Ex11.m1.2.2.1.1.2.2.3.cmml"><mover accent="true" id="S4.Ex11.m1.2.2.1.1.2.2.3.2" xref="S4.Ex11.m1.2.2.1.1.2.2.3.2.cmml"><mi id="S4.Ex11.m1.2.2.1.1.2.2.3.2.2" xref="S4.Ex11.m1.2.2.1.1.2.2.3.2.2.cmml">θ</mi>