<p id="S5.SS2.p1.13" class="ltx_p">for some <math id="S5.SS2.p1.3.m1.2" class="ltx_Math" alttext="\alpha\in[0,1)" display="inline"><semantics id="S5.SS2.p1.3.m1.2a"><mrow id="S5.SS2.p1.3.m1.2.3" xref="S5.SS2.p1.3.m1.2.3.cmml"><mi id="S5.SS2.p1.3.m1.2.3.2" xref="S5.SS2.p1.3.m1.2.3.2.cmml">α</mi><mo id="S5.SS2.p1.3.m1.2.3.1" xref="S5.SS2.p1.3.m1.2.3.1.cmml">∈</mo><mrow id="S5.SS2.p1.3.m1.2.3.3.2" xref="S5.SS2.p1.3.m1.2.3.3.1.cmml"><mo stretchy="false" id="S5.SS2.p1.3.m1.2.3.3.2.1" xref="S5.SS2.p1.3.m1.2.3.3.1.cmml">[</mo><mn id="S5.SS2.p1.3.m1.1.1" xref="S5.SS2.p1.3.m1.1.1.cmml">0</mn><mo id="S5.SS2.p1.3.m1.2.3.3.2.2" xref="S5.SS2.p1.3.m1.2.3.3.1.cmml">,</mo><mn id="S5.SS2.p1.3.m1.2.2" xref="S5.SS2.p1.3.m1.2.2.cmml">1</mn><mo stretchy="false" id="S5.SS2.p1.3.m1.2.3.3.2.3" xref="S5.SS2.p1.3.m1.2.3.3.1.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS2.p1.3.m1.2b"><apply id="S5.SS2.p1.3.m1.2.3.cmml" xref="S5.SS2.p1.3.m1.2.3"><in id="S5.SS2.p1.3.m1.2.3.1.cmml" xref="S5.SS2.p1.3.m1.2.3.1"></in><ci id="S5.SS2.p1.3.m1.2.3.2.cmml" xref="S5.SS2.p1.3.m1.2.3.2">𝛼</ci><interval closure="closed-open" id="S5.SS2.p1.3.m1.2.3.3.1.cmml" xref="S5.SS2.p1.3.m1.2.3.3.2"><cn type="integer" id="S5.SS2.p1.3.m1.1.1.cmml" xref="S5.SS2.p1.3.m1.1.1">0</cn><cn type="integer" id="S5.SS2.p1.3.m1.2.2.cmml" xref="S5.SS2.p1.3.m1.2.2">1</cn></interval></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS2.p1.3.m1.2c">\alpha\in[0,1)</annotation></semantics></math>, where
