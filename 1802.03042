i.e. <math id="S2.p2.6.m6.1" class="ltx_Math" alttext="\mathcal{F}_{k}" display="inline"><semantics id="S2.p2.6.m6.1a"><msub id="S2.p2.6.m6.1.1" xref="S2.p2.6.m6.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.p2.6.m6.1.1.2" xref="S2.p2.6.m6.1.1.2.cmml">ℱ</mi><mi id="S2.p2.6.m6.1.1.3" xref="S2.p2.6.m6.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.p2.6.m6.1b"><apply id="S2.p2.6.m6.1.1.cmml" xref="S2.p2.6.m6.1.1"><csymbol cd="ambiguous" id="S2.p2.6.m6.1.1.1.cmml" xref="S2.p2.6.m6.1.1">subscript</csymbol><ci id="S2.p2.6.m6.1.1.2.cmml" xref="S2.p2.6.m6.1.1.2">ℱ</ci><ci id="S2.p2.6.m6.1.1.3.cmml" xref="S2.p2.6.m6.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p2.6.m6.1c">\mathcal{F}_{k}</annotation></semantics></math> represents all information available up to <math id="S2.p2.7.m7.1" class="ltx_Math" alttext="t_{k}" display="inline"><semantics id="S2.p2.7.m7.1a"><msub id="S2.p2.7.m7.1.1" xref="S2.p2.7.m7.1.1.cmml"><mi id="S2.p2.7.m7.1.1.2" xref="S2.p2.7.m7.1.1.2.cmml">t</mi><mi id="S2.p2.7.m7.1.1.3" xref="S2.p2.7.m7.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.p2.7.m7.1b"><apply id="S2.p2.7.m7.1.1.cmml" xref="S2.p2.7.m7.1.1"><csymbol cd="ambiguous" id="S2.p2.7.m7.1.1.1.cmml" xref="S2.p2.7.m7.1.1">subscript</csymbol><ci id="S2.p2.7.m7.1.1.2.cmml" xref="S2.p2.7.m7.1.1.2">𝑡</ci><ci id="S2.p2.7.m7.1.1.3.cmml" xref="S2.p2.7.m7.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p2.7.m7.1c">t_{k}</annotation></semantics></math>. Note that each <math id="S2.p2.8.m8.1" class="ltx_Math" alttext="\mathcal{F}_{k}" display="inline"><semantics id="S2.p2.8.m8.1a"><msub id="S2.p2.8.m8.1.1" xref="S2.p2.8.m8.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.p2.8.m8.1.1.2" xref="S2.p2.8.m8.1.1.2.cmml">ℱ</mi><mi id="S2.p2.8.m8.1.1.3" xref="S2.p2.8.m8.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.p2.8.m8.1b"><apply id="S2.p2.8.m8.1.1.cmml" xref="S2.p2.8.m8.1.1"><csymbol cd="ambiguous" id="S2.p2.8.m8.1.1.1.cmml" xref="S2.p2.8.m8.1.1">subscript</csymbol><ci id="S2.p2.8.m8.1.1.2.cmml" xref="S2.p2.8.m8.1.1.2">ℱ</ci><ci id="S2.p2.8.m8.1.1.3.cmml" xref="S2.p2.8.m8.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p2.8.m8.1c">\mathcal{F}_{k}</annotation></semantics></math>-measurable random variable
can be written as a function of <math id="S2.p2.9.m9.3" class="ltx_Math" alttext="I_{0},\ldots,I_{k}" display="inline"><semantics id="S2.p2.9.m9.3a"><mrow id="S2.p2.9.m9.3.3.2" xref="S2.p2.9.m9.3.3.3.cmml"><msub id="S2.p2.9.m9.2.2.1.1" xref="S2.p2.9.m9.2.2.1.1.cmml"><mi id="S2.p2.9.m9.2.2.1.1.2" xref="S2.p2.9.m9.2.2.1.1.2.cmml">I</mi><mn id="S2.p2.9.m9.2.2.1.1.3" xref="S2.p2.9.m9.2.2.1.1.3.cmml">0</mn></msub><mo id="S2.p2.9.m9.3.3.2.3" xref="S2.p2.9.m9.3.3.3.cmml">,</mo><mi mathvariant="normal" id="S2.p2.9.m9.1.1" xref="S2.p2.9.m9.1.1.cmml">…</mi><mo id="S2.p2.9.m9.3.3.2.4" xref="S2.p2.9.m9.3.3.3.cmml">,</mo><msub id="S2.p2.9.m9.3.3.2.2" xref="S2.p2.9.m9.3.3.2.2.cmml"><mi id="S2.p2.9.m9.3.3.2.2.2" xref="S2.p2.9.m9.3.3.2.2.2.cmml">I</mi><mi id="S2.p2.9.m9.3.3.2.2.3" xref="S2.p2.9.m9.3.3.2.2.3.cmml">k</mi></msub></mrow><annotation-xml encoding="MathML-Content" id="S2.p2.9.m9.3b"><list id="S2.p2.9.m9.3.3.3.cmml" xref="S2.p2.9.m9.3.3.2"><apply id="S2.p2.9.m9.2.2.1.1.cmml" xref="S2.p2.9.m9.2.2.1.1"><csymbol cd="ambiguous" id="S2.p2.9.m9.2.2.1.1.1.cmml" xref="S2.p2.9.m9.2.2.1.1">subscript</csymbol><ci id="S2.p2.9.m9.2.2.1.1.2.cmml" xref="S2.p2.9.m9.2.2.1.1.2">𝐼</ci><cn type="integer" id="S2.p2.9.m9.2.2.1.1.3.cmml" xref="S2.p2.9.m9.2.2.1.1.3">0</cn></apply><ci id="S2.p2.9.m9.1.1.cmml" xref="S2.p2.9.m9.1.1">…</ci><apply id="S2.p2.9.m9.3.3.2.2.cmml" xref="S2.p2.9.m9.3.3.2.2"><csymbol cd="ambiguous" id="S2.p2.9.m9.3.3.2.2.1.cmml" xref="S2.p2.9.m9.3.3.2.2">subscript</csymbol><ci id="S2.p2.9.m9.3.3.2.2.2.cmml" xref="S2.p2.9.m9.3.3.2.2.2">𝐼</ci><ci id="S2.p2.9.m9.3.3.2.2.3.cmml" xref="S2.p2.9.m9.3.3.2.2.3">𝑘</ci></apply></list></annotation-xml><annotation encoding="application/x-tex" id="S2.p2.9.m9.3c">I_{0},\ldots,I_{k}</annotation></semantics></math>; this is therefore the richest available feature set for any
decision taken at <math id="S2.p2.10.m10.1" class="ltx_Math" alttext="t_{k}" display="inline"><semantics id="S2.p2.10.m10.1a"><msub id="S2.p2.10.m10.1.1" xref="S2.p2.10.m10.1.1.cmml"><mi id="S2.p2.10.m10.1.1.2" xref="S2.p2.10.m10.1.1.2.cmml">t</mi><mi id="S2.p2.10.m10.1.1.3" xref="S2.p2.10.m10.1.1.3.cmml">k</mi></msub><annotation-xml encoding="MathML-Content" id="S2.p2.10.m10.1b"><apply id="S2.p2.10.m10.1.1.cmml" xref="S2.p2.10.m10.1.1"><csymbol cd="ambiguous" id="S2.p2.10.m10.1.1.1.cmml" xref="S2.p2.10.m10.1.1">subscript</csymbol><ci id="S2.p2.10.m10.1.1.2.cmml" xref="S2.p2.10.m10.1.1.2">𝑡</ci><ci id="S2.p2.10.m10.1.1.3.cmml" xref="S2.p2.10.m10.1.1.3">𝑘</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p2.10.m10.1c">t_{k}</annotation></semantics></math>.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.5" class="ltx_p">The market contains <math id="S2.p3.1.m1.1" class="ltx_Math" alttext="d" display="inline"><semantics id="S2.p3.1.m1.1a"><mi id="S2.p3.1.m1.1.1" xref="S2.p3.1.m1.1.1.cmml">d</mi><annotation-xml encoding="MathML-Content" id="S2.p3.1.m1.1b"><ci id="S2.p3.1.m1.1.1.cmml" xref="S2.p3.1.m1.1.1">𝑑</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p3.1.m1.1c">d</annotation></semantics></math> hedging instruments with mid-prices given
by an <math id="S2.p3.2.m2.1" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline"><semantics id="S2.p3.2.m2.1a"><msup id="S2.p3.2.m2.1.1" xref="S2.p3.2.m2.1.1.cmml"><mi id="S2.p3.2.m2.1.1.2" xref="S2.p3.2.m2.1.1.2.cmml">ℝ</mi><mi id="S2.p3.2.m2.1.1.3" xref="S2.p3.2.m2.1.1.3.cmml">d</mi></msup><annotation-xml encoding="MathML-Content" id="S2.p3.2.m2.1b"><apply id="S2.p3.2.m2.1.1.cmml" xref="S2.p3.2.m2.1.1"><csymbol cd="ambiguous" id="S2.p3.2.m2.1.1.1.cmml" xref="S2.p3.2.m2.1.1">superscript</csymbol><ci id="S2.p3.2.m2.1.1.2.cmml" xref="S2.p3.2.m2.1.1.2">ℝ</ci><ci id="S2.p3.2.m2.1.1.3.cmml" xref="S2.p3.2.m2.1.1.3">𝑑</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p3.2.m2.1c">\mathbb{R}^{d}</annotation></semantics></math>-valued <math id="S2.p3.3.m3.1" class="ltx_Math" alttext="\mathbb{F}" display="inline"><semantics id="S2.p3.3.m3.1a"><mi id="S2.p3.3.m3.1.1" xref="S2.p3.3.m3.1.1.cmml">𝔽</mi><annotation-xml encoding="MathML-Content" id="S2.p3.3.m3.1b"><ci id="S2.p3.3.m3.1.1.cmml" xref="S2.p3.3.m3.1.1">𝔽</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p3.3.m3.1c">\mathbb{F}</annotation></semantics></math>-adapted stochastic process
<math id="S2.p3.4.m4.4" class="ltx_Math" alttext="S=(S_{k})_{k=0,\ldots,n}" display="inline"><semantics id="S2.p3.4.m4.4a"><mrow id="S2.p3.4.m4.4.4" xref="S2.p3.4.m4.4.4.cmml"><mi id="S2.p3.4.m4.4.4.3" xref="S2.p3.4.m4.4.4.3.cmml">S</mi><mo id="S2.p3.4.m4.4.4.2" xref="S2.p3.4.m4.4.4.2.cmml">=</mo><msub id="S2.p3.4.m4.4.4.1" xref="S2.p3.4.m4.4.4.1.cmml"><mrow id="S2.p3.4.m4.4.4.1.1.1" xref="S2.p3.4.m4.4.4.1.1.1.1.cmml"><mo stretchy="false" id="S2.p3.4.m4.4.4.1.1.1.2" xref="S2.p3.4.m4.4.4.1.1.1.1.cmml">(</mo><msub id="S2.p3.4.m4.4.4.1.1.1.1" xref="S2.p3.4.m4.4.4.1.1.1.1.cmml"><mi id="S2.p3.4.m4.4.4.1.1.1.1.2" xref="S2.p3.4.m4.4.4.1.1.1.1.2.cmml">S</mi><mi id="S2.p3.4.m4.4.4.1.1.1.1.3" xref="S2.p3.4.m4.4.4.1.1.1.1.3.cmml">k</mi></msub><mo stretchy="false" id="S2.p3.4.m4.4.4.1.1.1.3" xref="S2.p3.4.m4.4.4.1.1.1.1.cmml">)</mo></mrow><mrow id="S2.p3.4.m4.3.3.3" xref="S2.p3.4.m4.3.3.3.cmml"><mi id="S2.p3.4.m4.3.3.3.5" xref="S2.p3.4.m4.3.3.3.5.cmml">k</mi><mo id="S2.p3.4.m4.3.3.3.4" xref="S2.p3.4.m4.3.3.3.4.cmml">=</mo><mrow id="S2.p3.4.m4.3.3.3.6.2" xref="S2.p3.4.m4.3.3.3.6.1.cmml"><mn id="S2.p3.4.m4.1.1.1.1" xref="S2.p3.4.m4.1.1.1.1.cmml">0</mn><mo id="S2.p3.4.m4.3.3.3.6.2.1" xref="S2.p3.4.m4.3.3.3.6.1.cmml">,</mo><mi mathvariant="normal" id="S2.p3.4.m4.2.2.2.2" xref="S2.p3.4.m4.2.2.2.2.cmml">…</mi><mo id="S2.p3.4.m4.3.3.3.6.2.2" xref="S2.p3.4.m4.3.3.3.6.1.cmml">,</mo><mi id="S2.p3.4.m4.3.3.3.3" xref="S2.p3.4.m4.3.3.3.3.cmml">n</mi></mrow></mrow></msub></mrow><annotation-xml encoding="MathML-Content" id="S2.p3.4.m4.4b"><apply id="S2.p3.4.m4.4.4.cmml" xref="S2.p3.4.m4.4.4"><eq id="S2.p3.4.m4.4.4.2.cmml" xref="S2.p3.4.m4.4.4.2"></eq><ci id="S2.p3.4.m4.4.4.3.cmml" xref="S2.p3.4.m4.4.4.3">𝑆</ci><apply id="S2.p3.4.m4.4.4.1.cmml" xref="S2.p3.4.m4.4.4.1"><csymbol cd="ambiguous" id="S2.p3.4.m4.4.4.1.2.cmml" xref="S2.p3.4.m4.4.4.1">subscript</csymbol><apply id="S2.p3.4.m4.4.4.1.1.1.1.cmml" xref="S2.p3.4.m4.4.4.1.1.1"><csymbol cd="ambiguous" id="S2.p3.4.m4.4.4.1.1.1.1.1.cmml" xref="S2.p3.4.m4.4.4.1.1.1">subscript</csymbol><ci id="S2.p3.4.m4.4.4.1.1.1.1.2.cmml" xref="S2.p3.4.m4.4.4.1.1.1.1.2">𝑆</ci><ci id="S2.p3.4.m4.4.4.1.1.1.1.3.cmml" xref="S2.p3.4.m4.4.4.1.1.1.1.3">𝑘</ci></apply><apply id="S2.p3.4.m4.3.3.3.cmml" xref="S2.p3.4.m4.3.3.3"><eq id="S2.p3.4.m4.3.3.3.4.cmml" xref="S2.p3.4.m4.3.3.3.4"></eq><ci id="S2.p3.4.m4.3.3.3.5.cmml" xref="S2.p3.4.m4.3.3.3.5">𝑘</ci><list id="S2.p3.4.m4.3.3.3.6.1.cmml" xref="S2.p3.4.m4.3.3.3.6.2"><cn type="integer" id="S2.p3.4.m4.1.1.1.1.cmml" xref="S2.p3.4.m4.1.1.1.1">0</cn><ci id="S2.p3.4.m4.2.2.2.2.cmml" xref="S2.p3.4.m4.2.2.2.2">…</ci><ci id="S2.p3.4.m4.3.3.3.3.cmml" xref="S2.p3.4.m4.3.3.3.3">𝑛</ci></list></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p3.4.m4.4c">S=(S_{k})_{k=0,\ldots,n}</annotation></semantics></math>. We do <em id="S2.p3.5.1" class="ltx_emph ltx_font_italic">not</em> require that there
is an equivalent martingale measure under which <math id="S2.p3.5.m5.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S2.p3.5.m5.1a"><mi id="S2.p3.5.m5.1.1" xref="S2.p3.5.m5.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S2.p3.5.m5.1b"><ci id="S2.p3.5.m5.1.1.cmml" xref="S2.p3.5.m5.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p3.5.m5.1c">S</annotation></semantics></math> is a martingale.
We stress that our hedging instruments are not simply primary assets such as equities, but
also secondary assets such as liquid options on the former. Some of those hedging instruments are therefore not tradable before
a future point in time (e.g. an option only listed in 3M with then time-to-maturity of 6M). Such liquidity restrictions
are modeled alongside trading cost below.</p>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.3" class="ltx_p">Our portfolio of derivatives which represents our liabilities is an <math id="S2.p4.1.m1.1" class="ltx_Math" alttext="\mathcal{F}_{T}" display="inline"><semantics id="S2.p4.1.m1.1a"><msub id="S2.p4.1.m1.1.1" xref="S2.p4.1.m1.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.p4.1.m1.1.1.2" xref="S2.p4.1.m1.1.1.2.cmml">ℱ</mi><mi id="S2.p4.1.m1.1.1.3" xref="S2.p4.1.m1.1.1.3.cmml">T</mi></msub><annotation-xml encoding="MathML-Content" id="S2.p4.1.m1.1b"><apply id="S2.p4.1.m1.1.1.cmml" xref="S2.p4.1.m1.1.1"><csymbol cd="ambiguous" id="S2.p4.1.m1.1.1.1.cmml" xref="S2.p4.1.m1.1.1">subscript</csymbol><ci id="S2.p4.1.m1.1.1.2.cmml" xref="S2.p4.1.m1.1.1.2">ℱ</ci><ci id="S2.p4.1.m1.1.1.3.cmml" xref="S2.p4.1.m1.1.1.3">𝑇</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.p4.1.m1.1c">\mathcal{F}_{T}</annotation></semantics></math> measurable
random variable <math id="S2.p4.2.m2.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S2.p4.2.m2.1a"><mi id="S2.p4.2.m2.1.1" xref="S2.p4.2.m2.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S2.p4.2.m2.1b"><ci id="S2.p4.2.m2.1.1.cmml" xref="S2.p4.2.m2.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p4.2.m2.1c">Z</annotation></semantics></math>. In keeping with the classic literature we may refer to this as
the <em id="S2.p4.3.1" class="ltx_emph ltx_font_italic">contingent claim</em>, but
we stress that it is meant to represent a portfolio which is a mix of liquid and OTC derivatives.
The maturity <math id="S2.p4.3.m3.1" class="ltx_Math" alttext="T" display="inline"><semantics id="S2.p4.3.m3.1a"><mi id="S2.p4.3.m3.1.1" xref="S2.p4.3.m3.1.1.cmml">T</mi><annotation-xml encoding="MathML-Content" id="S2.p4.3.m3.1b"><ci id="S2.p4.3.m3.1.1.cmml" xref="S2.p4.3.m3.1.1">𝑇</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p4.3.m3.1c">T</annotation></semantics></math> is
the maximum maturity of all instruments, at which point
all payments are known.</p>
</div>
<div id="S2.p5" class="ltx_para ltx_noindent">
<p id="S2.p5.1" class="ltx_p"><em id="S2.p5.1.1" class="ltx_emph ltx_font_italic">No classic derivative pricing model will be needed to valuate <math id="S2.p5.1.1.m1.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S2.p5.1.1.m1.1a"><mi id="S2.p5.1.1.m1.1.1" xref="S2.p5.1.1.m1.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S2.p5.1.1.m1.1b"><ci id="S2.p5.1.1.m1.1.1.cmml" xref="S2.p5.1.1.m1.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.p5.1.1.m1.1c">Z</annotation></semantics></math> or compute Greeks at any point.</em></p>
</div>
<section id="S2.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Simplifications</h4>

<div id="S2.SS0.SSSx1.p1" class="ltx_para">
<p id="S2.SS0.SSSx1.p1.1" class="ltx_p">For notational simplicity, we assume
that all intermediate payments are accrued using a (locally) risk-free overnight rate. This essentially means
we may assume that rates are zero and that all payments occur at <math id="S2.SS0.SSSx1.p1.1.m1.1" class="ltx_Math" alttext="T" display="inline"><semantics id="S2.SS0.SSSx1.p1.1.m1.1a"><mi id="S2.SS0.SSSx1.p1.1.m1.1.1" xref="S2.SS0.SSSx1.p1.1.m1.1.1.cmml">T</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx1.p1.1.m1.1b"><ci id="S2.SS0.SSSx1.p1.1.m1.1.1.cmml" xref="S2.SS0.SSSx1.p1.1.m1.1.1">𝑇</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx1.p1.1.m1.1c">T</annotation></semantics></math>.
We also exclude for the purpose of this article instruments
with true optionality such as American options. Finally, we also assume that all currency spot exchange happens
at zero cost, and that we therefore may assume that all instruments settle in our reference currency.<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup><span class="ltx_tag ltx_tag_note">3</span>See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">BR06</a>]</cite>
for some background on multi-currency risk measures.</span></span></span></p>
</div>
</section>
<section id="S2.SS0.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Trading Strategies</h4>

<div id="S2.SS0.SSSx2.p1" class="ltx_para">
<p id="S2.SS0.SSSx2.p1.11" class="ltx_p">In order to hedge a liability <math id="S2.SS0.SSSx2.p1.1.m1.1" class="ltx_Math" alttext="Z" display="inline"><semantics id="S2.SS0.SSSx2.p1.1.m1.1a"><mi id="S2.SS0.SSSx2.p1.1.m1.1.1" xref="S2.SS0.SSSx2.p1.1.m1.1.1.cmml">Z</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.1.m1.1b"><ci id="S2.SS0.SSSx2.p1.1.m1.1.1.cmml" xref="S2.SS0.SSSx2.p1.1.m1.1.1">𝑍</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.1.m1.1c">Z</annotation></semantics></math> at <math id="S2.SS0.SSSx2.p1.2.m2.1" class="ltx_Math" alttext="T" display="inline"><semantics id="S2.SS0.SSSx2.p1.2.m2.1a"><mi id="S2.SS0.SSSx2.p1.2.m2.1.1" xref="S2.SS0.SSSx2.p1.2.m2.1.1.cmml">T</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.2.m2.1b"><ci id="S2.SS0.SSSx2.p1.2.m2.1.1.cmml" xref="S2.SS0.SSSx2.p1.2.m2.1.1">𝑇</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.2.m2.1c">T</annotation></semantics></math>, we may trade in <math id="S2.SS0.SSSx2.p1.3.m3.1" class="ltx_Math" alttext="S" display="inline"><semantics id="S2.SS0.SSSx2.p1.3.m3.1a"><mi id="S2.SS0.SSSx2.p1.3.m3.1.1" xref="S2.SS0.SSSx2.p1.3.m3.1.1.cmml">S</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.3.m3.1b"><ci id="S2.SS0.SSSx2.p1.3.m3.1.1.cmml" xref="S2.SS0.SSSx2.p1.3.m3.1.1">𝑆</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.3.m3.1c">S</annotation></semantics></math> using an <math id="S2.SS0.SSSx2.p1.4.m4.1" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline"><semantics id="S2.SS0.SSSx2.p1.4.m4.1a"><msup id="S2.SS0.SSSx2.p1.4.m4.1.1" xref="S2.SS0.SSSx2.p1.4.m4.1.1.cmml"><mi id="S2.SS0.SSSx2.p1.4.m4.1.1.2" xref="S2.SS0.SSSx2.p1.4.m4.1.1.2.cmml">ℝ</mi><mi id="S2.SS0.SSSx2.p1.4.m4.1.1.3" xref="S2.SS0.SSSx2.p1.4.m4.1.1.3.cmml">d</mi></msup><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.4.m4.1b"><apply id="S2.SS0.SSSx2.p1.4.m4.1.1.cmml" xref="S2.SS0.SSSx2.p1.4.m4.1.1"><csymbol cd="ambiguous" id="S2.SS0.SSSx2.p1.4.m4.1.1.1.cmml" xref="S2.SS0.SSSx2.p1.4.m4.1.1">superscript</csymbol><ci id="S2.SS0.SSSx2.p1.4.m4.1.1.2.cmml" xref="S2.SS0.SSSx2.p1.4.m4.1.1.2">ℝ</ci><ci id="S2.SS0.SSSx2.p1.4.m4.1.1.3.cmml" xref="S2.SS0.SSSx2.p1.4.m4.1.1.3">𝑑</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.4.m4.1c">\mathbb{R}^{d}</annotation></semantics></math>-valued <math id="S2.SS0.SSSx2.p1.5.m5.1" class="ltx_Math" alttext="\mathbb{F}" display="inline"><semantics id="S2.SS0.SSSx2.p1.5.m5.1a"><mi id="S2.SS0.SSSx2.p1.5.m5.1.1" xref="S2.SS0.SSSx2.p1.5.m5.1.1.cmml">𝔽</mi><annotation-xml encoding="MathML-Content" id="S2.SS0.SSSx2.p1.5.m5.1b"><ci id="S2.SS0.SSSx2.p1.5.m5.1.1.cmml" xref="S2.SS0.SSSx2.p1.5.m5.1.1">𝔽</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS0.SSSx2.p1.5.m5.1c">\mathbb{F}</annotation></semantics></math>-adapted stochastic
