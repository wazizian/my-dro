></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.E2Xa.3.2.2.m1.1c">\displaystyle=\alpha(b-V_{t})\mathrm{d}t+\sigma\sqrt{V_{t}}\mathrm{d}W_{t},\quad\text{ for }t&gt;0\text{ and }V_{0}=v_{0},</annotation></semantics></math></td>
