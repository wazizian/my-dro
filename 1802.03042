<p id="S4.SS3.p3.14" class="ltx_p">for some (small) <math id="S4.SS3.p3.6.m1.1" class="ltx_Math" alttext="\eta_{j}&gt;0" display="inline"><semantics id="S4.SS3.p3.6.m1.1a"><mrow id="S4.SS3.p3.6.m1.1.1" xref="S4.SS3.p3.6.m1.1.1.cmml"><msub id="S4.SS3.p3.6.m1.1.1.2" xref="S4.SS3.p3.6.m1.1.1.2.cmml"><mi id="S4.SS3.p3.6.m1.1.1.2.2" xref="S4.SS3.p3.6.m1.1.1.2.2.cmml">η</mi><mi id="S4.SS3.p3.6.m1.1.1.2.3" xref="S4.SS3.p3.6.m1.1.1.2.3.cmml">j</mi></msub><mo id="S4.SS3.p3.6.m1.1.1.1" xref="S4.SS3.p3.6.m1.1.1.1.cmml">&gt;</mo><mn id="S4.SS3.p3.6.m1.1.1.3" xref="S4.SS3.p3.6.m1.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.6.m1.1b"><apply id="S4.SS3.p3.6.m1.1.1.cmml" xref="S4.SS3.p3.6.m1.1.1"><gt id="S4.SS3.p3.6.m1.1.1.1.cmml" xref="S4.SS3.p3.6.m1.1.1.1"></gt><apply id="S4.SS3.p3.6.m1.1.1.2.cmml" xref="S4.SS3.p3.6.m1.1.1.2"><csymbol cd="ambiguous" id="S4.SS3.p3.6.m1.1.1.2.1.cmml" xref="S4.SS3.p3.6.m1.1.1.2">subscript</csymbol><ci id="S4.SS3.p3.6.m1.1.1.2.2.cmml" xref="S4.SS3.p3.6.m1.1.1.2.2">𝜂</ci><ci id="S4.SS3.p3.6.m1.1.1.2.3.cmml" xref="S4.SS3.p3.6.m1.1.1.2.3">𝑗</ci></apply><cn type="integer" id="S4.SS3.p3.6.m1.1.1.3.cmml" xref="S4.SS3.p3.6.m1.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.6.m1.1c">\eta_{j}&gt;0</annotation></semantics></math>, <math id="S4.SS3.p3.7.m2.1" class="ltx_Math" alttext="j\in\mathbb{N}" display="inline"><semantics id="S4.SS3.p3.7.m2.1a"><mrow id="S4.SS3.p3.7.m2.1.1" xref="S4.SS3.p3.7.m2.1.1.cmml"><mi id="S4.SS3.p3.7.m2.1.1.2" xref="S4.SS3.p3.7.m2.1.1.2.cmml">j</mi><mo id="S4.SS3.p3.7.m2.1.1.1" xref="S4.SS3.p3.7.m2.1.1.1.cmml">∈</mo><mi id="S4.SS3.p3.7.m2.1.1.3" xref="S4.SS3.p3.7.m2.1.1.3.cmml">ℕ</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.7.m2.1b"><apply id="S4.SS3.p3.7.m2.1.1.cmml" xref="S4.SS3.p3.7.m2.1.1"><in id="S4.SS3.p3.7.m2.1.1.1.cmml" xref="S4.SS3.p3.7.m2.1.1.1"></in><ci id="S4.SS3.p3.7.m2.1.1.2.cmml" xref="S4.SS3.p3.7.m2.1.1.2">𝑗</ci><ci id="S4.SS3.p3.7.m2.1.1.3.cmml" xref="S4.SS3.p3.7.m2.1.1.3">ℕ</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.7.m2.1c">j\in\mathbb{N}</annotation></semantics></math> and with <math id="S4.SS3.p3.8.m3.1" class="ltx_Math" alttext="J_{j}=J" display="inline"><semantics id="S4.SS3.p3.8.m3.1a"><mrow id="S4.SS3.p3.8.m3.1.1" xref="S4.SS3.p3.8.m3.1.1.cmml"><msub id="S4.SS3.p3.8.m3.1.1.2" xref="S4.SS3.p3.8.m3.1.1.2.cmml"><mi id="S4.SS3.p3.8.m3.1.1.2.2" xref="S4.SS3.p3.8.m3.1.1.2.2.cmml">J</mi><mi id="S4.SS3.p3.8.m3.1.1.2.3" xref="S4.SS3.p3.8.m3.1.1.2.3.cmml">j</mi></msub><mo id="S4.SS3.p3.8.m3.1.1.1" xref="S4.SS3.p3.8.m3.1.1.1.cmml">=</mo><mi id="S4.SS3.p3.8.m3.1.1.3" xref="S4.SS3.p3.8.m3.1.1.3.cmml">J</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.8.m3.1b"><apply id="S4.SS3.p3.8.m3.1.1.cmml" xref="S4.SS3.p3.8.m3.1.1"><eq id="S4.SS3.p3.8.m3.1.1.1.cmml" xref="S4.SS3.p3.8.m3.1.1.1"></eq><apply id="S4.SS3.p3.8.m3.1.1.2.cmml" xref="S4.SS3.p3.8.m3.1.1.2"><csymbol cd="ambiguous" id="S4.SS3.p3.8.m3.1.1.2.1.cmml" xref="S4.SS3.p3.8.m3.1.1.2">subscript</csymbol><ci id="S4.SS3.p3.8.m3.1.1.2.2.cmml" xref="S4.SS3.p3.8.m3.1.1.2.2">𝐽</ci><ci id="S4.SS3.p3.8.m3.1.1.2.3.cmml" xref="S4.SS3.p3.8.m3.1.1.2.3">𝑗</ci></apply><ci id="S4.SS3.p3.8.m3.1.1.3.cmml" xref="S4.SS3.p3.8.m3.1.1.3">𝐽</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.8.m3.1c">J_{j}=J</annotation></semantics></math>.
Under suitable assumptions on <math id="S4.SS3.p3.9.m4.1" class="ltx_Math" alttext="J" display="inline"><semantics id="S4.SS3.p3.9.m4.1a"><mi id="S4.SS3.p3.9.m4.1.1" xref="S4.SS3.p3.9.m4.1.1.cmml">J</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.9.m4.1b"><ci id="S4.SS3.p3.9.m4.1.1.cmml" xref="S4.SS3.p3.9.m4.1.1">𝐽</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.9.m4.1c">J</annotation></semantics></math> and the sequence <math id="S4.SS3.p3.10.m5.1" class="ltx_Math" alttext="\{\eta_{j}\}_{j\in\mathbb{N}}" display="inline"><semantics id="S4.SS3.p3.10.m5.1a"><msub id="S4.SS3.p3.10.m5.1.1" xref="S4.SS3.p3.10.m5.1.1.cmml"><mrow id="S4.SS3.p3.10.m5.1.1.1.1" xref="S4.SS3.p3.10.m5.1.1.1.2.cmml"><mo stretchy="false" id="S4.SS3.p3.10.m5.1.1.1.1.2" xref="S4.SS3.p3.10.m5.1.1.1.2.cmml">{</mo><msub id="S4.SS3.p3.10.m5.1.1.1.1.1" xref="S4.SS3.p3.10.m5.1.1.1.1.1.cmml"><mi id="S4.SS3.p3.10.m5.1.1.1.1.1.2" xref="S4.SS3.p3.10.m5.1.1.1.1.1.2.cmml">η</mi><mi id="S4.SS3.p3.10.m5.1.1.1.1.1.3" xref="S4.SS3.p3.10.m5.1.1.1.1.1.3.cmml">j</mi></msub><mo stretchy="false" id="S4.SS3.p3.10.m5.1.1.1.1.3" xref="S4.SS3.p3.10.m5.1.1.1.2.cmml">}</mo></mrow><mrow id="S4.SS3.p3.10.m5.1.1.3" xref="S4.SS3.p3.10.m5.1.1.3.cmml"><mi id="S4.SS3.p3.10.m5.1.1.3.2" xref="S4.SS3.p3.10.m5.1.1.3.2.cmml">j</mi><mo id="S4.SS3.p3.10.m5.1.1.3.1" xref="S4.SS3.p3.10.m5.1.1.3.1.cmml">∈</mo><mi id="S4.SS3.p3.10.m5.1.1.3.3" xref="S4.SS3.p3.10.m5.1.1.3.3.cmml">ℕ</mi></mrow></msub><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.10.m5.1b"><apply id="S4.SS3.p3.10.m5.1.1.cmml" xref="S4.SS3.p3.10.m5.1.1"><csymbol cd="ambiguous" id="S4.SS3.p3.10.m5.1.1.2.cmml" xref="S4.SS3.p3.10.m5.1.1">subscript</csymbol><set id="S4.SS3.p3.10.m5.1.1.1.2.cmml" xref="S4.SS3.p3.10.m5.1.1.1.1"><apply id="S4.SS3.p3.10.m5.1.1.1.1.1.cmml" xref="S4.SS3.p3.10.m5.1.1.1.1.1"><csymbol cd="ambiguous" id="S4.SS3.p3.10.m5.1.1.1.1.1.1.cmml" xref="S4.SS3.p3.10.m5.1.1.1.1.1">subscript</csymbol><ci id="S4.SS3.p3.10.m5.1.1.1.1.1.2.cmml" xref="S4.SS3.p3.10.m5.1.1.1.1.1.2">𝜂</ci><ci id="S4.SS3.p3.10.m5.1.1.1.1.1.3.cmml" xref="S4.SS3.p3.10.m5.1.1.1.1.1.3">𝑗</ci></apply></set><apply id="S4.SS3.p3.10.m5.1.1.3.cmml" xref="S4.SS3.p3.10.m5.1.1.3"><in id="S4.SS3.p3.10.m5.1.1.3.1.cmml" xref="S4.SS3.p3.10.m5.1.1.3.1"></in><ci id="S4.SS3.p3.10.m5.1.1.3.2.cmml" xref="S4.SS3.p3.10.m5.1.1.3.2">𝑗</ci><ci id="S4.SS3.p3.10.m5.1.1.3.3.cmml" xref="S4.SS3.p3.10.m5.1.1.3.3">ℕ</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.10.m5.1c">\{\eta_{j}\}_{j\in\mathbb{N}}</annotation></semantics></math>, <math id="S4.SS3.p3.11.m6.1" class="ltx_Math" alttext="\theta^{(j)}" display="inline"><semantics id="S4.SS3.p3.11.m6.1a"><msup id="S4.SS3.p3.11.m6.1.2" xref="S4.SS3.p3.11.m6.1.2.cmml"><mi id="S4.SS3.p3.11.m6.1.2.2" xref="S4.SS3.p3.11.m6.1.2.2.cmml">θ</mi><mrow id="S4.SS3.p3.11.m6.1.1.1.3" xref="S4.SS3.p3.11.m6.1.2.cmml"><mo stretchy="false" id="S4.SS3.p3.11.m6.1.1.1.3.1" xref="S4.SS3.p3.11.m6.1.2.cmml">(</mo><mi id="S4.SS3.p3.11.m6.1.1.1.1" xref="S4.SS3.p3.11.m6.1.1.1.1.cmml">j</mi><mo stretchy="false" id="S4.SS3.p3.11.m6.1.1.1.3.2" xref="S4.SS3.p3.11.m6.1.2.cmml">)</mo></mrow></msup><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.11.m6.1b"><apply id="S4.SS3.p3.11.m6.1.2.cmml" xref="S4.SS3.p3.11.m6.1.2"><csymbol cd="ambiguous" id="S4.SS3.p3.11.m6.1.2.1.cmml" xref="S4.SS3.p3.11.m6.1.2">superscript</csymbol><ci id="S4.SS3.p3.11.m6.1.2.2.cmml" xref="S4.SS3.p3.11.m6.1.2.2">𝜃</ci><ci id="S4.SS3.p3.11.m6.1.1.1.1.cmml" xref="S4.SS3.p3.11.m6.1.1.1.1">𝑗</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.11.m6.1c">\theta^{(j)}</annotation></semantics></math> converges to a local minimum of <math id="S4.SS3.p3.12.m7.1" class="ltx_Math" alttext="J" display="inline"><semantics id="S4.SS3.p3.12.m7.1a"><mi id="S4.SS3.p3.12.m7.1.1" xref="S4.SS3.p3.12.m7.1.1.cmml">J</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.12.m7.1b"><ci id="S4.SS3.p3.12.m7.1.1.cmml" xref="S4.SS3.p3.12.m7.1.1">𝐽</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.12.m7.1c">J</annotation></semantics></math> as <math id="S4.SS3.p3.13.m8.1" class="ltx_Math" alttext="j\to\infty" display="inline"><semantics id="S4.SS3.p3.13.m8.1a"><mrow id="S4.SS3.p3.13.m8.1.1" xref="S4.SS3.p3.13.m8.1.1.cmml"><mi id="S4.SS3.p3.13.m8.1.1.2" xref="S4.SS3.p3.13.m8.1.1.2.cmml">j</mi><mo stretchy="false" id="S4.SS3.p3.13.m8.1.1.1" xref="S4.SS3.p3.13.m8.1.1.1.cmml">→</mo><mi mathvariant="normal" id="S4.SS3.p3.13.m8.1.1.3" xref="S4.SS3.p3.13.m8.1.1.3.cmml">∞</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.13.m8.1b"><apply id="S4.SS3.p3.13.m8.1.1.cmml" xref="S4.SS3.p3.13.m8.1.1"><ci id="S4.SS3.p3.13.m8.1.1.1.cmml" xref="S4.SS3.p3.13.m8.1.1.1">→</ci><ci id="S4.SS3.p3.13.m8.1.1.2.cmml" xref="S4.SS3.p3.13.m8.1.1.2">𝑗</ci><infinity id="S4.SS3.p3.13.m8.1.1.3.cmml" xref="S4.SS3.p3.13.m8.1.1.3"></infinity></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.13.m8.1c">j\to\infty</annotation></semantics></math>. Of course, the success and feasibility of this algorithm crucially depends on two points: Firstly, can one avoid finding a local minimum instead of a global one? Secondly, can <math id="S4.SS3.p3.14.m9.1" class="ltx_Math" alttext="\nabla J" display="inline"><semantics id="S4.SS3.p3.14.m9.1a"><mrow id="S4.SS3.p3.14.m9.1.1" xref="S4.SS3.p3.14.m9.1.1.cmml"><mo rspace="0.167em" id="S4.SS3.p3.14.m9.1.1.1" xref="S4.SS3.p3.14.m9.1.1.1.cmml">∇</mo><mi id="S4.SS3.p3.14.m9.1.1.2" xref="S4.SS3.p3.14.m9.1.1.2.cmml">J</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p3.14.m9.1b"><apply id="S4.SS3.p3.14.m9.1.1.cmml" xref="S4.SS3.p3.14.m9.1.1"><ci id="S4.SS3.p3.14.m9.1.1.1.cmml" xref="S4.SS3.p3.14.m9.1.1.1">∇</ci><ci id="S4.SS3.p3.14.m9.1.1.2.cmml" xref="S4.SS3.p3.14.m9.1.1.2">𝐽</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p3.14.m9.1c">\nabla J</annotation></semantics></math> be calculated efficiently?</p>
</div>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.6" class="ltx_p">One of the key insights of deep learning is that for cost functions
<math id="S4.SS3.p4.1.m1.1" class="ltx_Math" alttext="J" display="inline"><semantics id="S4.SS3.p4.1.m1.1a"><mi id="S4.SS3.p4.1.m1.1.1" xref="S4.SS3.p4.1.m1.1.1.cmml">J</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p4.1.m1.1b"><ci id="S4.SS3.p4.1.m1.1.1.cmml" xref="S4.SS3.p4.1.m1.1.1">𝐽</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p4.1.m1.1c">J</annotation></semantics></math> built based on neural networks both of these problems can be dealt
with simultaneously by using a variant of <span id="S4.SS3.p4.6.1" class="ltx_text ltx_font_italic">stochastic gradient
descent</span> and the <span id="S4.SS3.p4.6.2" class="ltx_text ltx_font_italic">(error) backpropagation</span> algorithm. What
this means in our context is that in each step <math id="S4.SS3.p4.2.m2.1" class="ltx_Math" alttext="j" display="inline"><semantics id="S4.SS3.p4.2.m2.1a"><mi id="S4.SS3.p4.2.m2.1.1" xref="S4.SS3.p4.2.m2.1.1.cmml">j</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p4.2.m2.1b"><ci id="S4.SS3.p4.2.m2.1.1.cmml" xref="S4.SS3.p4.2.m2.1.1">𝑗</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p4.2.m2.1c">j</annotation></semantics></math> the expectation in
(<a href="#S4.E6" title="In 4.3. Numerical solution for OCE-risk measures ‣ 4. Approximating hedging strategies by deep neural networks ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>) (which is in fact a weighted sum over all elements of
the finite, but potentially very large sample space <math id="S4.SS3.p4.3.m3.1" class="ltx_Math" alttext="\Omega" display="inline"><semantics id="S4.SS3.p4.3.m3.1a"><mi mathvariant="normal" id="S4.SS3.p4.3.m3.1.1" xref="S4.SS3.p4.3.m3.1.1.cmml">Ω</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p4.3.m3.1b"><ci id="S4.SS3.p4.3.m3.1.1.cmml" xref="S4.SS3.p4.3.m3.1.1">Ω</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p4.3.m3.1c">\Omega</annotation></semantics></math>) is
replaced by an expectation over a randomly (uniformly) chosen subset
of <math id="S4.SS3.p4.4.m4.1" class="ltx_Math" alttext="\Omega" display="inline"><semantics id="S4.SS3.p4.4.m4.1a"><mi mathvariant="normal" id="S4.SS3.p4.4.m4.1.1" xref="S4.SS3.p4.4.m4.1.1.cmml">Ω</mi><annotation-xml encoding="MathML-Content" id="S4.SS3.p4.4.m4.1b"><ci id="S4.SS3.p4.4.m4.1.1.cmml" xref="S4.SS3.p4.4.m4.1.1">Ω</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p4.4.m4.1c">\Omega</annotation></semantics></math> of size <math id="S4.SS3.p4.5.m5.1" class="ltx_Math" alttext="N_{\text{batch}}\ll N" display="inline"><semantics id="S4.SS3.p4.5.m5.1a"><mrow id="S4.SS3.p4.5.m5.1.1" xref="S4.SS3.p4.5.m5.1.1.cmml"><msub id="S4.SS3.p4.5.m5.1.1.2" xref="S4.SS3.p4.5.m5.1.1.2.cmml"><mi id="S4.SS3.p4.5.m5.1.1.2.2" xref="S4.SS3.p4.5.m5.1.1.2.2.cmml">N</mi><mtext id="S4.SS3.p4.5.m5.1.1.2.3" xref="S4.SS3.p4.5.m5.1.1.2.3a.cmml">batch</mtext></msub><mo id="S4.SS3.p4.5.m5.1.1.1" xref="S4.SS3.p4.5.m5.1.1.1.cmml">≪</mo><mi id="S4.SS3.p4.5.m5.1.1.3" xref="S4.SS3.p4.5.m5.1.1.3.cmml">N</mi></mrow><annotation-xml encoding="MathML-Content" id="S4.SS3.p4.5.m5.1b"><apply id="S4.SS3.p4.5.m5.1.1.cmml" xref="S4.SS3.p4.5.m5.1.1"><csymbol cd="latexml" id="S4.SS3.p4.5.m5.1.1.1.cmml" xref="S4.SS3.p4.5.m5.1.1.1">much-less-than</csymbol><apply id="S4.SS3.p4.5.m5.1.1.2.cmml" xref="S4.SS3.p4.5.m5.1.1.2"><csymbol cd="ambiguous" id="S4.SS3.p4.5.m5.1.1.2.1.cmml" xref="S4.SS3.p4.5.m5.1.1.2">subscript</csymbol><ci id="S4.SS3.p4.5.m5.1.1.2.2.cmml" xref="S4.SS3.p4.5.m5.1.1.2.2">𝑁</ci><ci id="S4.SS3.p4.5.m5.1.1.2.3a.cmml" xref="S4.SS3.p4.5.m5.1.1.2.3"><mtext mathsize="70%" id="S4.SS3.p4.5.m5.1.1.2.3.cmml" xref="S4.SS3.p4.5.m5.1.1.2.3">batch</mtext></ci></apply><ci id="S4.SS3.p4.5.m5.1.1.3.cmml" xref="S4.SS3.p4.5.m5.1.1.3">𝑁</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS3.p4.5.m5.1c">N_{\text{batch}}\ll N</annotation></semantics></math>, so that <math id="S4.SS3.p4.6.m6.1" class="ltx_Math" alttext="J_{j}" display="inline"><semantics id="S4.SS3.p4