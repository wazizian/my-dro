S4.p1.10.m10.2.2.2.2.3.cmml" xref="S5.SS4.p1.10.m10.2.2.2.2.3"><plus id="S5.SS4.p1.10.m10.2.2.2.2.3.1.cmml" xref="S5.SS4.p1.10.m10.2.2.2.2.3.1"></plus><ci id="S5.SS4.p1.10.m10.2.2.2.2.3.2.cmml" xref="S5.SS4.p1.10.m10.2.2.2.2.3.2">ℎ</ci><cn type="integer" id="S5.SS4.p1.10.m10.2.2.2.2.3.3.cmml" xref="S5.SS4.p1.10.m10.2.2.2.2.3.3">1</cn></apply></apply></interval></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.10.m10.2c">(S^{h},S^{h+1})</annotation></semantics></math> only depend on <math id="S5.SS4.p1.11.m11.4" class="ltx_Math" alttext="(S^{(h)},S^{(h+1)})" display="inline"><semantics id="S5.SS4.p1.11.m11.4a"><mrow id="S5.SS4.p1.11.m11.4.4.2" xref="S5.SS4.p1.11.m11.4.4.3.cmml"><mo stretchy="false" id="S5.SS4.p1.11.m11.4.4.2.3" xref="S5.SS4.p1.11.m11.4.4.3.cmml">(</mo><msup id="S5.SS4.p1.11.m11.3.3.1.1" xref="S5.SS4.p1.11.m11.3.3.1.1.cmml"><mi id="S5.SS4.p1.11.m11.3.3.1.1.2" xref="S5.SS4.p1.11.m11.3.3.1.1.2.cmml">S</mi><mrow id="S5.SS4.p1.11.m11.1.1.1.3" xref="S5.SS4.p1.11.m11.3.3.1.1.cmml"><mo stretchy="false" id="S5.SS4.p1.11.m11.1.1.1.3.1" xref="S5.SS4.p1.11.m11.3.3.1.1.cmml">(</mo><mi id="S5.SS4.p1.11.m11.1.1.1.1" xref="S5.SS4.p1.11.m11.1.1.1.1.cmml">h</mi><mo stretchy="false" id="S5.SS4.p1.11.m11.1.1.1.3.2" xref="S5.SS4.p1.11.m11.3.3.1.1.cmml">)</mo></mrow></msup><mo id="S5.SS4.p1.11.m11.4.4.2.4" xref="S5.SS4.p1.11.m11.4.4.3.cmml">,</mo><msup id="S5.SS4.p1.11.m11.4.4.2.2" xref="S5.SS4.p1.11.m11.4.4.2.2.cmml"><mi id="S5.SS4.p1.11.m11.4.4.2.2.2" xref="S5.SS4.p1.11.m11.4.4.2.2.2.cmml">S</mi><mrow id="S5.SS4.p1.11.m11.2.2.1.1" xref="S5.SS4.p1.11.m11.2.2.1.1.1.cmml"><mo stretchy="false" id="S5.SS4.p1.11.m11.2.2.1.1.2" xref="S5.SS4.p1.11.m11.2.2.1.1.1.cmml">(</mo><mrow id="S5.SS4.p1.11.m11.2.2.1.1.1" xref="S5.SS4.p1.11.m11.2.2.1.1.1.cmml"><mi id="S5.SS4.p1.11.m11.2.2.1.1.1.2" xref="S5.SS4.p1.11.m11.2.2.1.1.1.2.cmml">h</mi><mo id="S5.SS4.p1.11.m11.2.2.1.1.1.1" xref="S5.SS4.p1.11.m11.2.2.1.1.1.1.cmml">+</mo><mn id="S5.SS4.p1.11.m11.2.2.1.1.1.3" xref="S5.SS4.p1.11.m11.2.2.1.1.1.3.cmml">1</mn></mrow><mo stretchy="false" id="S5.SS4.p1.11.m11.2.2.1.1.3" xref="S5.SS4.p1.11.m11.2.2.1.1.1.cmml">)</mo></mrow></msup><mo stretchy="false" id="S5.SS4.p1.11.m11.4.4.2.5" xref="S5.SS4.p1.11.m11.4.4.3.cmml">)</mo></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.11.m11.4b"><interval closure="open" id="S5.SS4.p1.11.m11.4.4.3.cmml" xref="S5.SS4.p1.11.m11.4.4.2"><apply id="S5.SS4.p1.11.m11.3.3.1.1.cmml" xref="S5.SS4.p1.11.m11.3.3.1.1"><csymbol cd="ambiguous" id="S5.SS4.p1.11.m11.3.3.1.1.1.cmml" xref="S5.SS4.p1.11.m11.3.3.1.1">superscript</csymbol><ci id="S5.SS4.p1.11.m11.3.3.1.1.2.cmml" xref="S5.SS4.p1.11.m11.3.3.1.1.2">𝑆</ci><ci id="S5.SS4.p1.11.m11.1.1.1.1.cmml" xref="S5.SS4.p1.11.m11.1.1.1.1">ℎ</ci></apply><apply id="S5.SS4.p1.11.m11.4.4.2.2.cmml" xref="S5.SS4.p1.11.m11.4.4.2.2"><csymbol cd="ambiguous" id="S5.SS4.p1.11.m11.4.4.2.2.1.cmml" xref="S5.SS4.p1.11.m11.4.4.2.2">superscript</csymbol><ci id="S5.SS4.p1.11.m11.4.4.2.2.2.cmml" xref="S5.SS4.p1.11.m11.4.4.2.2.2">𝑆</ci><apply id="S5.SS4.p1.11.m11.2.2.1.1.1.cmml" xref="S5.SS4.p1.11.m11.2.2.1.1"><plus id="S5.SS4.p1.11.m11.2.2.1.1.1.1.cmml" xref="S5.SS4.p1.11.m11.2.2.1.1.1.1"></plus><ci id="S5.SS4.p1.11.m11.2.2.1.1.1.2.cmml" xref="S5.SS4.p1.11.m11.2.2.1.1.1.2">ℎ</ci><cn type="integer" id="S5.SS4.p1.11.m11.2.2.1.1.1.3.cmml" xref="S5.SS4.p1.11.m11.2.2.1.1.1.3">1</cn></apply></apply></interval></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.11.m11.4c">(S^{(h)},S^{(h+1)})</annotation></semantics></math>. While in
the present setup trading is only possible at discrete time steps and
so the strategy optimizing (<a href="#S3.E1" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), where <math id="S5.SS4.p1.12.m12.1" class="ltx_Math" alttext="X=-Z" display="inline"><semantics id="S5.SS4.p1.12.m12.1a"><mrow id="S5.SS4.p1.12.m12.1.1" xref="S5.SS4.p1.12.m12.1.1.cmml"><mi id="S5.SS4.p1.12.m12.1.1.2" xref="S5.SS4.p1.12.m12.1.1.2.cmml">X</mi><mo id="S5.SS4.p1.12.m12.1.1.1" xref="S5.SS4.p1.12.m12.1.1.1.cmml">=</mo><mrow id="S5.SS4.p1.12.m12.1.1.3" xref="S5.SS4.p1.12.m12.1.1.3.cmml"><mo id="S5.SS4.p1.12.m12.1.1.3a" xref="S5.SS4.p1.12.m12.1.1.3.cmml">−</mo><mi id="S5.SS4.p1.12.m12.1.1.3.2" xref="S5.SS4.p1.12.m12.1.1.3.2.cmml">Z</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.12.m12.1b"><apply id="S5.SS4.p1.12.m12.1.1.cmml" xref="S5.SS4.p1.12.m12.1.1"><eq id="S5.SS4.p1.12.m12.1.1.1.cmml" xref="S5.SS4.p1.12.m12.1.1.1"></eq><ci id="S5.SS4.p1.12.m12.1.1.2.cmml" xref="S5.SS4.p1.12.m12.1.1.2">𝑋</ci><apply id="S5.SS4.p1.12.m12.1.1.3.cmml" xref="S5.SS4.p1.12.m12.1.1.3"><minus id="S5.SS4.p1.12.m12.1.1.3.1.cmml" xref="S5.SS4.p1.12.m12.1.1.3"></minus><ci id="S5.SS4.p1.12.m12.1.1.3.2.cmml" xref="S5.SS4.p1.12.m12.1.1.3.2">𝑍</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S5.SS4.p1.12.m12.1c">X=-Z</annotation></semantics></math>, leads to a
non-deterministic terminal hedging error (<a href="#S2.E1" title="In Hedging ‣ 2. Setting: Discrete time-market with Frictions ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>), by
independence one still expects that the optimal strategy is decoupled
as above, at least for certain classes of risk measures. To see this
most prominently, here we consider <span id="S5.SS4.p1.15.1" class="ltx_text ltx_font_italic">variance optimal hedging</span>:
the objective is chosen as (<a href="#S3.E3" title="In Remark 3.4. ‣ 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>) for <math id="S5.SS4.p1.13.m13.1" class="ltx_Math" alttext="\ell(x)=x^{2}" display="inline"><semantics id="S5.SS4.p1.13.m13.1a"><mrow id="S5.SS4.p1.13.m13.1.2" xref="S5.SS4.p1.13.m13.1.2.cmml"><mrow id="S5.SS4.p1.13.m13.1.2.2" xref="S5.SS4.p1.13.m13.1.2.2.cmml"><mi mathvariant="normal" id="S5.SS4.p1.13.m13.1.2.2.2" xref="S5.SS4.p1.13.m13.1.2.2.2.cmml">ℓ</mi><mo lspace="0em" rspace="0em" id="S5.SS4.p1.13.m13.1.2.2.1" xref="S5.SS4.p1.13.m13.1.2.2.1.cmml">​</mo><mrow id="S5.SS4.p1.13.m13.1.2.2.3.2" xref="S5.SS4.p1.13.m13.1.2.2.cmml"><mo stretchy="false" id="S5.SS4.p1.13.m13.1.2.2.3.2.1" xref="S5.SS4.p1.13.m13.1.2.2.cmml">(</mo><mi id="S5.SS4.p1.13.m13.1.1" xref="S5.SS4.p1.13.m13.1.1.cmml">x</mi><mo stretchy="false" id="S5.SS4.p1.13.m13.1.2.2.3.2.2" xref="S5.SS4.p1.13.m13.1.2.2.cmml">)</mo></mrow></mrow><mo id="S5.SS4.p1.13.m13.1.2.1" xref="S5.SS4.p1.13.m13.1.2.1.cmml">=</mo><msup id="S5.SS4.p1.13.m13.1.2.3" xref="S5.SS4.p1.13.m13.1.2.3.cmml"><mi id="S5.SS4.p1.13.m13.1.2.3.2" xref="S5.SS4.p1.13.m13.1.2.3.2.cmml">x</mi><mn id="S5.SS4.p1.13.m13.1.2.3.3" xref="S5.SS4.p1.13.m13.1.2.3.3.cmml">2</mn></msup></mrow><annotation-xml encoding="MathML-Content" id="S5.SS4.p1.13.m13.1b"><apply id="S5.SS4.p1.13.m13.1.2.cmml" xref="S5.SS4.p1.13.m13.1.2"><eq id="S5.SS4.p1.13.m13.1.2.1.cmml" xref="S5.SS4.p1.13.m13.1.2.1"></eq><apply id="S5.SS4.p1.13.m13.1.2.2.cmml" xref="S5.SS4.p1.13.m13.1.2.2"><times id="S5.SS4.p1.13.m13.1.2.2.1.cmml" xref="S5.SS4.p1.13.m13.1.2.2.1"></times><ci id="S5.SS4.p1.13.m13.1.2.2.2.cmml" xref="S5.SS4.p1.13.m13.1.2.2.2">ℓ</ci><ci id="S5.SS4.p1.13.m13.1.1.cmml" xref="S5.SS4.p1.13.m13.1.1">𝑥</ci></apply><apply id="S5.SS4.p1.13.m13.1.2.3.cmml" xref="S5.SS4.p1.13.m13.1.2.3"><csymbol cd="ambiguous" id="S5.SS4.p1.13.m13.1.2.3.1.cmml" xref="S5.SS4.p1.13.m13.1.2.3">supersc