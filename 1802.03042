<p id="S3.Thmtheorem6.p1.4" class="ltx_p"><span id="S3.Thmtheorem6.p1.4.2" class="ltx_text ltx_font_italic">and define <math id="S3.Thmtheorem6.p1.3.1.m1.1" class="ltx_Math" alttext="p(Z)" display="inline"><semantics id="S3.Thmtheorem6.p1.3.1.m1.1a"><mrow id="S3.Thmtheorem6.p1.3.1.m1.1.2" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.cmml"><mi id="S3.Thmtheorem6.p1.3.1.m1.1.2.2" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.2.cmml">p</mi><mo lspace="0em" rspace="0em" id="S3.Thmtheorem6.p1.3.1.m1.1.2.1" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.1.cmml">​</mo><mrow id="S3.Thmtheorem6.p1.3.1.m1.1.2.3.2" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.cmml"><mo stretchy="false" id="S3.Thmtheorem6.p1.3.1.m1.1.2.3.2.1" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.cmml">(</mo><mi id="S3.Thmtheorem6.p1.3.1.m1.1.1" xref="S3.Thmtheorem6.p1.3.1.m1.1.1.cmml">Z</mi><mo stretchy="false" id="S3.Thmtheorem6.p1.3.1.m1.1.2.3.2.2" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem6.p1.3.1.m1.1b"><apply id="S3.Thmtheorem6.p1.3.1.m1.1.2.cmml" xref="S3.Thmtheorem6.p1.3.1.m1.1.2"><times id="S3.Thmtheorem6.p1.3.1.m1.1.2.1.cmml" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.1"></times><ci id="S3.Thmtheorem6.p1.3.1.m1.1.2.2.cmml" xref="S3.Thmtheorem6.p1.3.1.m1.1.2.2">𝑝</ci><ci id="S3.Thmtheorem6.p1.3.1.m1.1.1.cmml" xref="S3.Thmtheorem6.p1.3.1.m1.1.1">𝑍</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem6.p1.3.1.m1.1c">p(Z)</annotation></semantics></math> by (<a href="#S3.E2" title="In 3. Pricing and hedging using convex risk measures ‣ Deep Hedging" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>). Then <math id="S3.Thmtheorem6.p1.4.2.m2.2" class="ltx_Math" alttext="q(Z)=p(Z)" display="inline"><semantics id="S3.Thmtheorem6.p1.4.2.m2.2a"><mrow id="S3.Thmtheorem6.p1.4.2.m2.2.3" xref="S3.Thmtheorem6.p1.4.2.m2.2.3.cmml"><mrow id="S3.Thmtheorem6.p1.4.2.m2.2.3.2" xref="S3.Thmtheorem6.p1.4.2.m2.2.3.2.cmml"><mi id="S3.Thmtheorem6.p1.4.2.m2