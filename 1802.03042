<p id="S4.SS5.3.p2.7" class="ltx_p">Note that <math id="S4.SS5.3.p2.6.m1.1" class="ltx_Math" alttext="\mathcal{P}_{eq}" display="inline"><semantics id="S4.SS5.3.p2.6.m1.1a"><msub id="S4.SS5.3.p2.6.m1.1.1" xref="S4.SS5.3.p2.6.m1.1.1.cmml"><mi class="ltx_font_mathcaligraphic" id="S4.SS5.3.p2.6.m1.1.1.2" xref="S4.SS5.3.p2.6.m1.1.1.2.cmml">𝒫</mi><mrow id="S4.SS5.3.p2.6.m1.1.1.3" xref="S4.SS5.3.p2.6.m1.1.1.3.cmml"><mi id="S4.SS5.3.p2.6.m1.1.1.3.2" xref="S4.SS5.3.p2.6.m1.1.1.3.2.cmml">e</mi><mo lspace="0em" rspace="0em" id="S4.SS5.3.p2.6.m1.1.1.3.1" xref="S4.SS5.3.p2.6.m1.1.1.3.1.cmml">​</mo><mi id="S4.SS5.3.p2.6.m1.1.1.3.3" xref="S4.SS5.3.p2.6.m1.1.1.3.3.cmml">q</mi></mrow></msub><annotation-xml encoding="MathML-Content" id="S4.SS5.3.p2.6.m1.1b"><apply id="S4.SS5.3.p2.6.m1.1.1.cmml" xref="S4.SS5.3.p2.6.m1.1.1"><csymbol cd="ambiguous" id="S4.SS5.3.p2.6.m1.1.1.1.cmml" xref="S4.SS5.3.p2.6.m1.1.1">subscript</csymbol><ci id="S4.SS5.3.p2.6.m1.1.1.2.cmml" xref="S4.SS5.3.p2.6.m1.1.1.2">𝒫</ci><apply id="S4.SS5.3.p2.6.m1.1.1.3.cmml" xref="S4.SS5.3.p2.6.m1.1.1.3"><times id="S4.SS5.3.p2.6.m1.1.1.3.1.cmml" xref="S4.SS5.3.p2.6.m1.1.1.3.1"></times><ci id="S4.SS5.3.p2.6.m1.1.1.3.2.cmml" xref="S4.SS5.3.p2.6.m1.1.1.3.2">𝑒</ci><ci id="S4.SS5.3.p2.6.m1.1.1.3.3.cmml" xref="S4.SS5.3.p2.6.m1.1.1.3.3">𝑞</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S4.SS5.3.p2.6.m1.1c">\mathcal{P}_{eq}</annotation></semantics></math> may be written in terms of <math id="S4.SS5.3.p2.7.m2.1" class="ltx_Math" alttext="\mathcal{L}" display="inline"><semantics id="S4.SS5.3.p2.7.m2.1a"><mi class="ltx_font_mathcaligraphic" id="S4.SS5.3.p2.7.m2.1.1" xref="S4.SS5.3.p2.7.m2.1.1.cmml">ℒ</mi><annotation-xml encoding="MathML-Content" id="S4.SS5.3.p2.7.m2.1b"><ci id="S4.SS5.3.p2.7.m2.1.1.cmml" xref="S4.SS5.3.p2.7.m2.1.1">ℒ</ci></annotation-xml><annotation encoding="application/x-tex" id="S4.SS5.3.p2.7.m2.1c">\mathcal{L}</annotation></semantics></math> as</p>
