<div id="S3.I1.i3.p2" class="ltx_para ltx_noindent">
<p id="S3.I1.i3.p2.5" class="ltx_p"><span id="S3.I1.i3.p2.5.5" class="ltx_text ltx_font_italic">Adding cash to a position reduces the need for more by as much.
In particular, this means that <math id="S3.I1.i3.p2.1.1.m1.2" class="ltx_Math" alttext="\rho(X+\rho(X))=0" display="inline"><semantics id="S3.I1.i3.p2.1.1.m1.2a"><mrow id="S3.I1.i3.p2.1.1.m1.2.2" xref="S3.I1.i3.p2.1.1.m1.2.2.cmml"><mrow id="S3.I1.i3.p2.1.1.m1.2.2.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.cmml"><mi id="S3.I1.i3.p2.1.1.m1.2.2.1.3" xref="S3.I1.i3.p2.1.1.m1.2.2.1.3.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.I1.i3.p2.1.1.m1.2.2.1.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.2.cmml">​</mo><mrow id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.cmml"><mo stretchy="false" id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.cmml">(</mo><mrow id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.cmml"><mi id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.2.cmml">X</mi><mo id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.1.cmml">+</mo><mrow id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.cmml"><mi id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.1.cmml">​</mo><mrow id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.3.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.cmml"><mo stretchy="false" id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.3.2.1" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.cmml">(</mo><mi id="S3.I1.i3.p2.1.1.m1.1.1" xref="S3.I1.i3.p2.1.1.m1.1.1.cmml">X</mi><mo stretchy="false" id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.3.2.2" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.cmml">)</mo></mrow></mrow></mrow><mo stretchy="false" id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.3" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.cmml">)</mo></mrow></mrow><mo id="S3.I1.i3.p2.1.1.m1.2.2.2" xref="S3.I1.i3.p2.1.1.m1.2.2.2.cmml">=</mo><mn id="S3.I1.i3.p2.1.1.m1.2.2.3" xref="S3.I1.i3.p2.1.1.m1.2.2.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.I1.i3.p2.1.1.m1.2b"><apply id="S3.I1.i3.p2.1.1.m1.2.2.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2"><eq id="S3.I1.i3.p2.1.1.m1.2.2.2.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.2"></eq><apply id="S3.I1.i3.p2.1.1.m1.2.2.1.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1"><times id="S3.I1.i3.p2.1.1.m1.2.2.1.2.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.2"></times><ci id="S3.I1.i3.p2.1.1.m1.2.2.1.3.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.3">𝜌</ci><apply id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1"><plus id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.1.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.1"></plus><ci id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.2.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.2">𝑋</ci><apply id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3"><times id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.1.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.1"></times><ci id="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.2.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.1.1.1.1.3.2">𝜌</ci><ci id="S3.I1.i3.p2.1.1.m1.1.1.cmml" xref="S3.I1.i3.p2.1.1.m1.1.1">𝑋</ci></apply></apply></apply><cn type="integer" id="S3.I1.i3.p2.1.1.m1.2.2.3.cmml" xref="S3.I1.i3.p2.1.1.m1.2.2.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I1.i3.p2.1.1.m1.2c">\rho(X+\rho(X))=0</annotation></semantics></math>,
i.e. <math id="S3.I1.i3.p2.2.2.m2.1" class="ltx_Math" alttext="\rho(X)" display="inline"><semantics id="S3.I1.i3.p2.2.2.m2.1a"><mrow id="S3.I1.i3.p2.2.2.m2.1.2" xref="S3.I1.i3.p2.2.2.m2.1.2.cmml"><mi id="S3.I1.i3.p2.2.2.m2.1.2.2" xref="S3.I1.i3.p2.2.2.m2.1.2.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.I1.i3.p2.2.2.m2.1.2.1" xref="S3.I1.i3.p2.2.2.m2.1.2.1.cmml">​</mo><mrow id="S3.I1.i3.p2.2.2.m2.1.2.3.2" xref="S3.I1.i3.p2.2.2.m2.1.2.cmml"><mo stretchy="false" id="S3.I1.i3.p2.2.2.m2.1.2.3.2.1" xref="S3.I1.i3.p2.2.2.m2.1.2.cmml">(</mo><mi id="S3.I1.i3.p2.2.2.m2.1.1" xref="S3.I1.i3.p2.2.2.m2.1.1.cmml">X</mi><mo stretchy="false" id="S3.I1.i3.p2.2.2.m2.1.2.3.2.2" xref="S3.I1.i3.p2.2.2.m2.1.2.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.I1.i3.p2.2.2.m2.1b"><apply id="S3.I1.i3.p2.2.2.m2.1.2.cmml" xref="S3.I1.i3.p2.2.2.m2.1.2"><times id="S3.I1.i3.p2.2.2.m2.1.2.1.cmml" xref="S3.I1.i3.p2.2.2.m2.1.2.1"></times><ci id="S3.I1.i3.p2.2.2.m2.1.2.2.cmml" xref="S3.I1.i3.p2.2.2.m2.1.2.2">𝜌</ci><ci id="S3.I1.i3.p2.2.2.m2.1.1.cmml" xref="S3.I1.i3.p2.2.2.m2.1.1">𝑋</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I1.i3.p2.2.2.m2.1c">\rho(X)</annotation></semantics></math> is the least amount <math id="S3.I1.i3.p2.3.3.m3.1" class="ltx_Math" alttext="c" display="inline"><semantics id="S3.I1.i3.p2.3.3.m3.1a"><mi id="S3.I1.i3.p2.3.3.m3.1.1" xref="S3.I1.i3.p2.3.3.m3.1.1.cmml">c</mi><annotation-xml encoding="MathML-Content" id="S3.I1.i3.p2.3.3.m3.1b"><ci id="S3.I1.i3.p2.3.3.m3.1.1.cmml" xref="S3.I1.i3.p2.3.3.m3.1.1">𝑐</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.I1.i3.p2.3.3.m3.1c">c</annotation></semantics></math> that needs to be added to
the position <math id="S3.I1.i3.p2.4.4.m4.1" class="ltx_Math" alttext="X" display="inline"><semantics id="S3.I1.i3.p2.4.4.m4.1a"><mi id="S3.I1.i3.p2.4.4.m4.1.1" xref="S3.I1.i3.p2.4.4.m4.1.1.cmml">X</mi><annotation-xml encoding="MathML-Content" id="S3.I1.i3.p2.4.4.m4.1b"><ci id="S3.I1.i3.p2.4.4.m4.1.1.cmml" xref="S3.I1.i3.p2.4.4.m4.1.1">𝑋</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.I1.i3.p2.4.4.m4.1c">X</annotation></semantics></math> in order to make it acceptable in
the sense that <math id="S3.I1.i3.p2.5.5.m5.1" class="ltx_Math" alttext="\rho(X+c)\leq 0" display="inline"><semantics id="S3.I1.i3.p2.5.5.m5.1a"><mrow id="S3.I1.i3.p2.5.5.m5.1.1" xref="S3.I1.i3.p2.5.5.m5.1.1.cmml"><mrow id="S3.I1.i3.p2.5.5.m5.1.1.1" xref="S3.I1.i3.p2.5.5.m5.1.1.1.cmml"><mi id="S3.I1.i3.p2.5.5.m5.1.1.1.3" xref="S3.I1.i3.p2.5.5.m5.1.1.1.3.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.I1.i3.p2.5.5.m5.1.1.1.2" xref="S3.I1.i3.p2.5.5.m5.1.1.1.2.cmml">​</mo><mrow id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.cmml"><mo stretchy="false" id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.2" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.cmml">(</mo><mrow id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.cmml"><mi id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.2" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.2.cmml">X</mi><mo id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.1" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.1.cmml">+</mo><mi id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.3" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.3.cmml">c</mi></mrow><mo stretchy="false" id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.3" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.cmml">)</mo></mrow></mrow><mo id="S3.I1.i3.p2.5.5.m5.1.1.2" xref="S3.I1.i3.p2.5.5.m5.1.1.2.cmml">≤</mo><mn id="S3.I1.i3.p2.5.5.m5.1.1.3" xref="S3.I1.i3.p2.5.5.m5.1.1.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.I1.i3.p2.5.5.m5.1b"><apply id="S3.I1.i3.p2.5.5.m5.1.1.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1"><leq id="S3.I1.i3.p2.5.5.m5.1.1.2.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.2"></leq><apply id="S3.I1.i3.p2.5.5.m5.1.1.1.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1"><times id="S3.I1.i3.p2.5.5.m5.1.1.1.2.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.2"></times><ci id="S3.I1.i3.p2.5.5.m5.1.1.1.3.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.3">𝜌</ci><apply id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1"><plus id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.1.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.1"></plus><ci id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.2.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.2">𝑋</ci><ci id="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.3.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.1.1.1.1.3">𝑐</ci></apply></apply><cn type="integer" id="S3.I1.i3.p2.5.5.m5.1.1.3.cmml" xref="S3.I1.i3.p2.5.5.m5.1.1.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.I1.i3.p2.5.5.m5.1c">\rho(X+c)\leq 0</annotation></semantics></math>.</span></p>
</div>
</li>
</ol>
<p id="S3.Thmtheorem1.p2.3" class="ltx_p">We call <math id="S3.Thmtheorem1.p2.2.m1.1" class="ltx_Math" alttext="\rho" display="inline"><semantics id="S3.Thmtheorem1.p2.2.m1.1a"><mi id="S3.Thmtheorem1.p2.2.m1.1.1" xref="S3.Thmtheorem1.p2.2.m1.1.1.cmml">ρ</mi><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem1.p2.2.m1.1b"><ci id="S3.Thmtheorem1.p2.2.m1.1.1.cmml" xref="S3.Thmtheorem1.p2.2.m1.1.1">𝜌</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem1.p2.2.m1.1c">\rho</annotation></semantics></math> <em id="S3.Thmtheorem1.p2.3.1" class="ltx_emph ltx_font_italic">normalized</em> if <math id="S3.Thmtheorem1.p2.3.m2.1" class="ltx_Math" alttext="\rho(0)=0" display="inline"><semantics id="S3.Thmtheorem1.p2.3.m2.1a"><mrow id="S3.Thmtheorem1.p2.3.m2.1.2" xref="S3.Thmtheorem1.p2.3.m2.1.2.cmml"><mrow id="S3.Thmtheorem1.p2.3.m2.1.2.2" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.cmml"><mi id="S3.Thmtheorem1.p2.3.m2.1.2.2.2" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.2.cmml">ρ</mi><mo lspace="0em" rspace="0em" id="S3.Thmtheorem1.p2.3.m2.1.2.2.1" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.1.cmml">​</mo><mrow id="S3.Thmtheorem1.p2.3.m2.1.2.2.3.2" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.cmml"><mo stretchy="false" id="S3.Thmtheorem1.p2.3.m2.1.2.2.3.2.1" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.cmml">(</mo><mn id="S3.Thmtheorem1.p2.3.m2.1.1" xref="S3.Thmtheorem1.p2.3.m2.1.1.cmml">0</mn><mo stretchy="false" id="S3.Thmtheorem1.p2.3.m2.1.2.2.3.2.2" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.cmml">)</mo></mrow></mrow><mo id="S3.Thmtheorem1.p2.3.m2.1.2.1" xref="S3.Thmtheorem1.p2.3.m2.1.2.1.cmml">=</mo><mn id="S3.Thmtheorem1.p2.3.m2.1.2.3" xref="S3.Thmtheorem1.p2.3.m2.1.2.3.cmml">0</mn></mrow><annotation-xml encoding="MathML-Content" id="S3.Thmtheorem1.p2.3.m2.1b"><apply id="S3.Thmtheorem1.p2.3.m2.1.2.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2"><eq id="S3.Thmtheorem1.p2.3.m2.1.2.1.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2.1"></eq><apply id="S3.Thmtheorem1.p2.3.m2.1.2.2.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2.2"><times id="S3.Thmtheorem1.p2.3.m2.1.2.2.1.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.1"></times><ci id="S3.Thmtheorem1.p2.3.m2.1.2.2.2.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2.2.2">𝜌</ci><cn type="integer" id="S3.Thmtheorem1.p2.3.m2.1.1.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.1">0</cn></apply><cn type="integer" id="S3.Thmtheorem1.p2.3.m2.1.2.3.cmml" xref="S3.Thmtheorem1.p2.3.m2.1.2.3">0</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.Thmtheorem1.p2.3.m2.1c">\rho(0)=0</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.2" class="ltx_p">Let <math id="S3.p4.1.m1.1" class="ltx_Math" alttext="\rho\colon\mathcal{X}\to\mathbb{R}" display="inline"><semantics id="S3.p4.1.m1.1a"><mrow id="S3.p4.1.m1.1.1" xref="S3.p4.1.m1.1.1.cmml"><mi id="S3.p4.1.m1.1.1.2" xref="S3.p4.1.m1.1.1.2.cmml">ρ</mi><mo lspace="0.278em" rspace="0.278em" id="S3.p4.1.m1.1.1.1" xref="S3.p4.1.m1.1.1.1.cmml">:</mo><mrow id="S3.p4.1.m1.1.1.3" xref="S3.p4.1.m1.1.1.3.cmml"><mi class="ltx_font_mathcaligraphic" id="S3.p4.1.m1.1.1.3.2" xref="S3.p4.1.m1.1.1.3.2.cmml">𝒳</mi><mo stretchy="false" id="S3.p4.1.m1.1.1.3.1" xref="S3.p4.1.m1.1.1.3.1.cmml">→</mo><mi id="S3.p4.1.m1.1.1.3.3" xref="S3.p4.1.m1.1.1.3.3.cmml">ℝ</mi></mrow></mrow><annotation-xml encoding="MathML-Content" id="S3.p4.1.m1.1b"><apply id="S3.p4.1.m1.1.1.cmml" xref="S3.p4.1.m1.1.1"><ci id="S3.p4.1.m1.1.1.1.cmml" xref="S3.p4.1.m1.1.1.1">:</ci><ci id="S3.p4.1.m1.1.1.2.cmml" xref="S3.p4.1.m1.1.1.2">𝜌</ci><apply id="S3.p4.1.m1.1.1.3.cmml" xref="S3.p4.1.m1.1.1.3"><ci id="S3.p4.1.m1.1.1.3.1.cmml" xref="S3.p4.1.m1.1.1.3.1">→</ci><ci id="S3.p4.1.m1.1.1.3.2.cmml" xref="S3.p4.1.m1.1.1.3.2">𝒳</ci><ci id="S3.p4.1.m1.1.1.3.3.cmml" xref="S3.p4.1.m1.1.1.3.3">ℝ</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.p4.1.m1.1c">\rho\colon\mathcal{X}\to\mathbb{R}</annotation></semantics></math> be such a convex risk measure and for <math id="S3.p4.2.m2.1" class="ltx_Math" alttext="X\in\mathcal{X}" display="inline"><semantics id="S3.p4.2.m2.1a"><mrow id="S3.p4.2.m2.1.1" xref="S3.p4.2.m2.1.1.cmml"><mi id="S3.p4.2.m2.1.1.2" xref="S3.p4.2.m2.1.1.2.cmml">X</mi><mo id="S3.p4.2.m2.1.1.1" xref="S3.p4.2.m2.1.1.1.cmml">∈</mo><mi class="ltx_font_mathcaligraphic" id="S3.p4.2.m2.1.1.3" xref="S3.p4.2.m2.1.1.3.cmml">𝒳</mi></mrow><annotation-xml encoding="MathML-Content" id="S3.p4.2.m2.1b"><apply id="S3.p4.2.m2.1.1.cmml" xref="S3.p4.2.m2.1.1"><in id="S3.p4.2.m2.1.1.1.cmml" xref="S3.p4.2.m2.1.1.1"></in><ci id="S3.p4.2.m2.1.1.2.cmml" xref="S3.p4.2.m2.1.1.2">𝑋</ci><ci id="S3.p4.2.m2.1.1.3.cmml" xref="S3.p4.2.m2.1.1.3">𝒳</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.p4.2.m2.1c">X\in\mathcal{X}</annotation></semantics></math> consider the optimization problem</p>
